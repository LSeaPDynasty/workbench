{"manifest":{"id":"builtin-files","name":"文件","version":"1.0.0","apiVersion":1,"entry":"index.html","permissions":["folders.read"]},"files":{"app.js":"const api=window.workbench,$=id=>document.getElementById(id);\nlet roots=[],current=null,relative='',entries=[],next=null,generation=0,busy=false;\nconst error=e=>{$('error').textContent=e?.message||'';};\nfunction button(text,action,label){const b=document.createElement('button');b.textContent=text;if(label)b.setAttribute('aria-label',label);b.onclick=()=>Promise.resolve().then(action).catch(error);return b;}\nfunction renderRoots(){const container=$('roots');container.replaceChildren();for(const r of roots){const row=document.createElement('div');row.className='root '+(current===r.id?'selected':'');const box=document.createElement('input');box.type='checkbox';box.checked=r.enabled;box.setAttribute('aria-label','加载 '+r.name);box.onchange=async()=>{try{roots=await api.folders.enable(r.id,box.checked);if(current===r.id&&!box.checked){current=null;relative='';entries=[];next=null;busy=false;generation++;renderEntries();}renderRoots();}catch(e){error(e);}};const name=button(r.name,()=>{if(!r.enabled)return;current=r.id;relative='';renderRoots();return load();});name.title=r.path;name.className='rootname';const remove=button('×',async()=>{roots=await api.folders.remove(r.id);if(current===r.id){current=null;relative='';entries=[];next=null;busy=false;generation++;renderEntries();}renderRoots();},'移除 '+r.name);row.append(box,name,remove);container.append(row);}if(!roots.length){const empty=document.createElement('p');empty.className='empty';empty.textContent='未添加文件夹';container.append(empty);}}\nfunction size(n){if(n===null)return '—';if(n<1024)return n+' B';if(n<1024**2)return (n/1024).toFixed(1)+' KB';return (n/1024**2).toFixed(1)+' MB';}\nfunction renderEntries(){const filter=$('filter').value.toLocaleLowerCase();const root=roots.find(r=>r.id===current);$('location').textContent=root?root.name+(relative?' / '+relative.replaceAll('\\\\',' / '):''):'文件';$('up').disabled=!relative||busy;$('refresh').disabled=!current||busy;const container=$('entries');container.replaceChildren();const visible=entries.filter(e=>e.name.toLocaleLowerCase().includes(filter));for(const entry of visible){const row=document.createElement('div');row.className='entry';const name=document.createElement('button');name.className='filename';name.textContent=(entry.kind==='directory'?'▸  ':'')+entry.name;name.title=entry.name;name.onclick=()=>{for(const el of container.children)el.classList.remove('selected');row.classList.add('selected');};name.ondblclick=()=>{if(entry.kind==='directory'){relative=entry.relative;load();}else if(entry.kind==='file')api.files.menu(entry.token).catch(error);};row.oncontextmenu=e=>{e.preventDefault();if(entry.kind==='file')api.files.menu(entry.token).catch(error);};name.onkeydown=e=>{if(e.key==='Enter'){if(entry.kind==='directory'){relative=entry.relative;load();}else if(entry.kind==='file')api.files.menu(entry.token).catch(error);}};const date=document.createElement('span');date.textContent=entry.modified?new Date(entry.modified).toLocaleString('zh-CN',{hour12:false}):'—';const bytes=document.createElement('span');bytes.textContent=size(entry.size);const menu=button('···',()=>api.files.menu(entry.token),'打开方式 '+entry.name);menu.disabled=entry.kind!=='file';row.append(name,date,bytes,menu);container.append(row);}if(!entries.length&&!busy){const empty=document.createElement('p');empty.className='empty';empty.textContent=current?'空文件夹':'选择文件夹';container.append(empty);}else if(!visible.length&&!busy){const empty=document.createElement('p');empty.className='empty';empty.textContent='无匹配文件';container.append(empty);}$('more').hidden=next===null;$('more').disabled=busy;$('count').textContent=busy?'加载中…':entries.length?entries.length+' 项已加载':'';}\nasync function load(more=false){if(!current)return;const run=++generation;busy=true;error(null);if(!more){entries=[];next=null;}renderEntries();try{const data=await api.files.list(current,relative,more?next:0);if(run!==generation)return;entries=more?[...entries,...data.entries]:data.entries;next=data.next;}catch(e){if(run===generation)error(e);}finally{if(run===generation){busy=false;renderEntries();}}}\n$('add').onclick=async()=>{try{roots=await api.folders.choose();renderRoots();if(!current&&roots.some(r=>r.enabled)){current=roots.find(r=>r.enabled).id;renderRoots();await load();}}catch(e){error(e);}};\n$('up').onclick=()=>{relative=relative.split(/[\\\\/]/).slice(0,-1).join('/');load();};$('refresh').onclick=()=>load();$('filter').oninput=renderEntries;$('more').onclick=()=>load(true);\napi.onTheme(theme=>document.documentElement.dataset.theme=theme);\nasync function start(){try{const initial=await api.initial();document.documentElement.dataset.theme=initial.theme;roots=await api.folders.list();renderRoots();renderEntries();}catch(e){error(e);}}\nstart();\n\r\n","index.html":"<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"tokens.css\"><link rel=\"stylesheet\" href=\"style.css\"></head><body><div class=\"layout\"><aside><div class=\"title\"><strong>文件夹</strong><button id=\"add\" title=\"添加文件夹\">＋</button></div><div id=\"roots\"></div></aside><main><div class=\"toolbar\"><button id=\"up\" aria-label=\"上一级\">↑</button><span id=\"location\">文件</span><button id=\"refresh\">刷新</button><input id=\"filter\" placeholder=\"筛选已加载文件\" aria-label=\"筛选已加载文件\"></div><div id=\"error\" role=\"status\"></div><div class=\"tablehead\"><span>名称</span><span>修改时间</span><span>大小</span><span></span></div><div id=\"entries\"></div><button id=\"more\" hidden>加载更多</button><div id=\"count\"></div></main></div><script src=\"app.js\"></script></body></html>\n","style.css":"*{box-sizing:border-box}body{margin:0;background:var(--color-bg);color:var(--color-text);font:13px var(--font-ui)}button,input{font:inherit;color:inherit}button{background:transparent;border:0;cursor:pointer;border-radius:5px;padding:7px 9px}button:hover{background:var(--color-selected)}button:disabled{opacity:.4;cursor:default}button:focus-visible,input:focus-visible{outline:2px solid var(--color-focus)}.layout{display:grid;grid-template-columns:230px 1fr;height:100vh}aside{padding:15px 12px;border-right:1px solid var(--color-border);overflow:auto}.title{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;padding:0 5px}.title strong{font-weight:500}.root{display:flex;align-items:center;gap:2px;border-radius:6px;margin-bottom:5px;padding:3px}.root input{accent-color:var(--color-accent)}.rootname{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;flex:1;text-align:left}.root.selected,.entry.selected{background:var(--color-selected)}main{min-width:0;overflow:auto;padding:12px 18px}.toolbar{display:flex;gap:8px;align-items:center;position:sticky;top:0;background:var(--color-bg);min-height:42px}.toolbar>span{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.toolbar input{background:var(--color-surface);border:1px solid var(--color-border);border-radius:6px;padding:7px;width:160px;font-size:11px}.tablehead,.entry{display:grid;grid-template-columns:minmax(120px,1fr) 140px 75px 35px;align-items:center;gap:12px;border-bottom:1px solid var(--color-border);min-height:38px}.tablehead{font-size:11px;color:var(--color-muted);margin-top:10px}.entry>span{font-size:11px;color:var(--color-muted)}.filename{text-align:left;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-left:0}.empty{color:var(--color-muted);padding:25px 8px;font-size:12px}#error{color:var(--color-danger);font-size:12px;padding:5px}#error:empty{display:none}#more{display:block;margin:15px auto;border:1px solid var(--color-border)}#more[hidden]{display:none}#count{font-size:10px;color:var(--color-muted);padding:12px 0}\n","tokens.css":":root {\n  color-scheme: light;\n  --color-bg: #eeeee8;\n  --color-surface: #fafaf6;\n  --color-surface-hover: #eef1f5;\n  --color-border: #dcded5;\n  --color-text: #303c36;\n  --color-muted: #6d786f;\n  --color-accent: #356855;\n  --color-accent-text: #ffffff;\n  --color-selected: #e0e9df;\n  --color-danger: #b42318;\n  --color-success: #177245;\n  --color-focus: #356855;\n  --syntax-keyword: #8541a3;\n  --syntax-string: #34734c;\n  --syntax-comment: #6a786f;\n  --syntax-number: #a15b21;\n  --syntax-function: #276c9c;\n  --syntax-key: #96524c;\n  --syntax-warning: #875f10;\n  --syntax-mark: #f4df91;\n  --color-paper: #fffef9;\n  --color-paper-line: #e9e9df;\n  --color-decor: #94aa8e;\n  --color-dock: #fafbf7;\n  --color-dock-note: #e7e9d9;\n  --color-dock-task: #dce9df;\n  --color-dock-file: #eae0ce;\n  --shadow-paper: 0 12px 30px #394b3510;\n  --shadow-dock: 0 10px 35px #34403216;\n  --font-ui: 'Segoe UI Variable', 'Segoe UI', 'Microsoft YaHei UI', sans-serif;\n  --font-size-body: 14px;\n  --radius-control: 6px;\n  --radius-panel: 8px;\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-6: 24px;\n  --sidebar-width: 208px;\n  --control-height: 32px;\n}\n[data-theme='dark'] {\n  color-scheme: dark;\n  --color-bg: #202723;\n  --color-surface: #2a322c;\n  --color-surface-hover: #2b3340;\n  --color-border: #465048;\n  --color-text: #edf0f5;\n  --color-muted: #abb6c7;\n  --color-accent: #b3ceb9;\n  --color-accent-text: #223d30;\n  --color-selected: #3a4d3e;\n  --color-danger: #ffaca4;\n  --color-success: #85d6ad;\n  --color-focus: #b3ceb9;\n  --syntax-keyword: #cf9ee6;\n  --syntax-string: #a6c897;\n  --syntax-comment: #9da99e;\n  --syntax-number: #e5b481;\n  --syntax-function: #8bc2df;\n  --syntax-key: #e3a49b;\n  --syntax-warning: #e4bd6b;\n  --syntax-mark: #605b35;\n  --color-paper: #303831;\n  --color-paper-line: #454e43;\n  --color-decor: #78916f;\n  --color-dock: #2a352d;\n  --color-dock-note: #4a4b39;\n  --color-dock-task: #3d5747;\n  --color-dock-file: #594e3b;\n}\n"}}