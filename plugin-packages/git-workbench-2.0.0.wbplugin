{"manifest":{"id":"git-workbench","name":"Git","version":"2.0.0","apiVersion":1,"entry":"index.html","backend":"backend/index.cjs","permissions":["folders.read","native.backend","browser.open","network.proxy"]},"files":{"app.js":"const api=window.GitSDK,$=id=>document.getElementById(id);let accounts=[],repos=[],roots=[],current=null,editing=null;\nconst error=value=>{const text=value?.message||value||'';$('error').textContent=text;if($('repo-dialog').open)$('repo-error').textContent=text;};\nfunction option(value,label){const node=document.createElement('option');node.value=value;node.textContent=label;return node;}\nfunction accountLabel(account){return account.name+' · '+(account.githubLogin||account.server);}\nfunction setBusy(value){for(const button of document.querySelectorAll('button:not(#login-cancel):not(#login-open)'))button.disabled=value;}\nfunction showOutput(value){$('output').textContent=value||'';}\nfunction renderAccounts(){const node=$('accounts');node.replaceChildren();for(const account of accounts){const row=document.createElement('div');row.className='account-row '+(selectedAccount===account.id?'selected':'');const button=document.createElement('button');button.className='account';button.title=accountLabel(account);const avatar=document.createElement('span');avatar.className='account-avatar';avatar.textContent=account.name.slice(0,1).toUpperCase();const text=document.createElement('span'),name=document.createElement('b'),detail=document.createElement('small');name.textContent=account.name;detail.textContent=account.githubLogin?'@'+account.githubLogin:account.provider==='github'?'未登录':account.server;text.append(name,detail);button.append(avatar,text);button.onclick=()=>showRemote(account.id);const edit=document.createElement('button');edit.className='account-edit';edit.textContent='···';edit.setAttribute('aria-label','编辑账号 '+account.name);edit.onclick=()=>openAccount(account);row.append(button,edit);node.append(row);}if(!accounts.length){const button=document.createElement('button');button.className='account-empty';button.textContent='连接账号';button.onclick=()=>openAccount(null);node.append(button);}}\nfunction renderRepos(){const node=$('repos');node.replaceChildren();for(const repo of repos){const button=document.createElement('button');button.className='repo '+(current?.id===repo.id?'selected':'');const dot=document.createElement('i');dot.className='dot';const text=document.createElement('span'),name=document.createElement('b'),detail=document.createElement('small');name.textContent=repo.relative||roots.find(r=>r.id===repo.rootId)?.name||'仓库';detail.textContent=accounts.find(a=>a.id===repo.accountId)?.name||'未关联账号';text.append(name,detail);button.append(dot,text);button.onclick=()=>selectRepo(repo);node.append(button);}if(!repos.length){const empty=document.createElement('p');empty.className='empty';empty.textContent='未添加仓库';node.append(empty);}}\nfunction renderSetup(){const root=$('root'),account=$('account');root.replaceChildren(option('','选择文件夹'));for(const item of roots.filter(r=>r.enabled))root.append(option(item.id,item.name));account.replaceChildren(option('','不关联账号'));for(const item of accounts)account.append(option(item.id,accountLabel(item)));}\nfunction showSetup(){renderSetup();if(selectedAccount)$('account').value=selectedAccount;$('repo-error').textContent='';$('repo-dialog').showModal();}\nfunction parseChanges(text){const lines=text.split(/\\r?\\n/).filter(line=>line&&!line.startsWith('## '));return lines.map(line=>({state:line.slice(0,2),path:line.slice(3)})).filter(x=>x.path);}\nfunction renderChanges(text){const changes=parseChanges(text),node=$('changes');node.replaceChildren();$('change-count').textContent=changes.length?changes.length+' 项':'';for(const change of changes){const row=document.createElement('label');row.className='file';const box=document.createElement('input');box.type='checkbox';box.value=change.path;box.checked=true;const state=document.createElement('span');state.className='state';state.textContent=change.state.trim()||'M';const file=document.createElement('span');file.className='path';file.textContent=change.path;row.append(box,state,file);node.append(row);}if(!changes.length){const empty=document.createElement('p');empty.className='empty';empty.textContent='没有改动';node.append(empty);}}\nfunction parseRemotes(text){const names=[];for(const line of text.split(/\\r?\\n/)){const name=line.trim().split(/\\s+/)[0];if(name&&!names.includes(name))names.push(name);}const node=$('remote');node.replaceChildren();for(const name of names)node.append(option(name,name));if(!names.length)node.append(option('origin','origin'));}\nasync function refresh(){if(!current)return loadRemote();setBusy(true);error('');try{const [state,history,stat]=await Promise.all([api.git.status(current.id),api.git.log(current.id,30),api.git.diff(current.id)]);$('branch').textContent='分支 · '+(state.branch||'尚无提交');$('push-branch').value=state.branch||'';parseRemotes(state.remotes);renderChanges(state.status);$('log').textContent=history||'暂无提交';$('diff').textContent=stat||'无差异';}catch(e){error(e);}finally{setBusy(false);}}\nasync function selectRepo(repo){remoteGeneration++;current=repo;renderRepos();if($('repo-dialog').open)$('repo-dialog').close();$('remote-browser').hidden=true;$('workspace').hidden=false;$('repo-title').textContent=repo.relative||roots.find(r=>r.id===repo.rootId)?.name||'仓库';showOutput('');error('');await refresh();}\nfunction selectedFiles(){return [...document.querySelectorAll('#changes input:checked')].map(x=>x.value);}\nasync function operation(run){if(!current)return;setBusy(true);error('');try{showOutput(await run());await refresh();}catch(e){error(e);}finally{setBusy(false);}}\nfunction updateLoginButton(){$('github-login').hidden=$('provider').value!=='github';}\nfunction openAccount(account){editing=account||null;$('account-dialog').returnValue='';$('account-name').value=account?.name||'';$('provider').value=account?.provider||'github';$('server').value=account?.server||'https://github.com';$('auth').value=account?.auth||'system';$('delete-account').hidden=!account;updateLoginButton();$('account-dialog').showModal();}\nasync function sync(){[accounts,repos,roots]=await Promise.all([api.git.accounts.list(),api.git.repos.list(),api.folders.list()]);if(!accounts.some(a=>a.id===selectedAccount))selectedAccount=accounts.find(a=>a.githubLogin)?.id||accounts[0]?.id||null;renderAccounts();renderRepos();renderSetup();}\n$('add-account').onclick=()=>openAccount(null);$('add-repo').onclick=showSetup;$('refresh').onclick=refresh;\n$('provider').onchange=updateLoginButton;$('account-dialog').addEventListener('close',async()=>{const value=$('account-dialog').returnValue;if(value==='save'||value==='login'){try{const account=await api.git.accounts.save({id:editing?.id,name:$('account-name').value,provider:$('provider').value,server:$('server').value,auth:$('auth').value});await sync();if(value==='login')await beginLogin(account.id);}catch(e){error(e);}}if(value==='delete'&&editing){try{await api.git.accounts.remove(editing.id);await sync();}catch(e){error(e);}}});\nlet loginState={phase:'idle'},loginStarting=false,loginPoll=null,loginGeneration=0;\nfunction renderLogin(state){\n const was=loginState.phase;loginState=state;const pending=['starting','waiting','finishing'].includes(state.phase);\n $('login-status').hidden=state.phase==='idle';\n $('login-message').textContent=state.phase==='starting'?'正在连接 GitHub…':state.phase==='waiting'?'在浏览器中输入授权码':state.phase==='finishing'?'正在保存登录结果…':state.phase==='success'?'已登录 GitHub：'+state.login:state.message||'登录失败';\n $('login-code').textContent=state.code||'';$('login-open').hidden=state.phase!=='waiting';$('login-cancel').hidden=!pending;$('login-cancel').disabled=state.phase==='finishing';\n if(state.phase==='success'&&was!=='success')void sync().then(()=>showRemote(state.accountId||selectedAccount)).catch(error);\n return pending;\n}\nfunction scheduleLoginPoll(){clearTimeout(loginPoll);const generation=loginGeneration;loginPoll=setTimeout(async()=>{try{const state=await api.git.github.status();if(generation!==loginGeneration)return;if(renderLogin(state))scheduleLoginPoll();}catch(e){if(generation===loginGeneration){renderLogin({phase:'error',message:e.message});}}},750);}\nasync function beginLogin(accountId){\n if(!api.git.github.start){error('请先将主体更新到 0.3.3，再使用浏览器登录');return;}\n if(loginStarting||['starting','waiting','finishing'].includes(loginState.phase)){error('已有登录正在进行，可先取消');return;}\n loginStarting=true;const generation=++loginGeneration;renderLogin({phase:'starting'});\n try{const state=await api.git.github.start(accountId);if(generation!==loginGeneration){await api.git.github.cancel();return;}if(renderLogin(state))scheduleLoginPoll();}catch(e){if(generation===loginGeneration)renderLogin({phase:'error',message:e.message});}finally{loginStarting=false;}\n}\n$('login-cancel').onclick=async()=>{try{loginGeneration++;clearTimeout(loginPoll);renderLogin(await api.git.github.cancel());}catch(e){error(e);scheduleLoginPoll();}};\n$('login-open').onclick=()=>api.git.github.open().catch(error);\nwindow.addEventListener('pagehide',()=>{clearTimeout(loginPoll);});\n$('choose-root').onclick=async()=>{try{await api.folders.choose();await sync();}catch(e){error(e);}};\n$('register').onclick=async()=>{try{setBusy(true);const repo=await api.git.repos.register($('root').value,$('account').value||null);await sync();await selectRepo(repo);}catch(e){error(e);}finally{setBusy(false);}};\n$('init').onclick=async()=>{try{setBusy(true);const repo=await api.git.repos.init($('root').value,$('account').value||null);await sync();await selectRepo(repo);}catch(e){error(e);}finally{setBusy(false);}};\n$('clone').onclick=async()=>{try{setBusy(true);const repo=await api.git.repos.clone($('root').value,$('clone-remote').value,$('clone-folder').value,$('account').value||null);await sync();await selectRepo(repo);}catch(e){error(e);}finally{setBusy(false);}};\n$('stage').onclick=()=>{const files=selectedFiles();if(!files.length)return error('请选择要暂存的文件');return operation(()=>api.git.stage(current.id,files));};$('unstage').onclick=()=>operation(()=>api.git.unstage(current.id,selectedFiles()));$('commit').onclick=()=>operation(async()=>{const message=$('message').value;const result=await api.git.commit(current.id,message);$('message').value='';return result;});$('pull').onclick=()=>operation(()=>api.git.pull(current.id,$('remote').value,$('push-branch').value));$('push').onclick=()=>operation(()=>api.git.push(current.id,$('remote').value,$('push-branch').value));$('remove-repo').onclick=async()=>{if(!current)return;try{await api.git.repos.remove(current.id);await sync();showRemote(selectedAccount);}catch(e){error(e);}};\napi.onTheme(theme=>document.documentElement.dataset.theme=theme);api.initial().then(async initial=>{document.documentElement.dataset.theme=initial.theme;await sync();showRemote(selectedAccount);if(api.git.github.status){const state=await api.git.github.status();if(renderLogin(state))scheduleLoginPoll();}}).catch(error);\nlet selectedAccount=null,remoteEntries=[],remoteNext=null,remoteGeneration=0,remoteLoading=false,cloneBusy=false;\nfunction actionButton(label,fn){const button=document.createElement('button');button.textContent=label;button.onclick=()=>Promise.resolve().then(fn).catch(error);return button;}\nfunction showRemote(accountId){selectedAccount=accountId||null;current=null;remoteGeneration++;setBusy(false);renderAccounts();renderRepos();$('workspace').hidden=true;$('remote-browser').hidden=false;$('repo-title').textContent='远端仓库';$('repo-search').value='';error('');showOutput('');void loadRemote();}\nfunction renderRemote(){\n const node=$('remote-list');node.replaceChildren();const account=accounts.find(a=>a.id===selectedAccount),query=$('repo-search').value.toLowerCase(),visibility=$('visibility').value;\n $('remote-account').textContent=account?.githubLogin?'@'+account.githubLogin:account?.name||'';\n const entries=remoteEntries.filter(r=>(r.fullName+' '+r.description).toLowerCase().includes(query)&&(visibility==='all'||(visibility==='private')===r.private));\n for(const repo of entries){const row=document.createElement('article');row.className='remote-repo';const content=document.createElement('div');content.className='remote-repo-info';const heading=document.createElement('div');heading.className='repo-heading';const name=actionButton(repo.fullName,()=>window.GithubProvider.open(repo.fullName));name.className='repo-name';const badge=document.createElement('span');badge.className='repo-badge';badge.textContent=repo.private?'私有':'公开';heading.append(name,badge);content.append(heading);if(repo.description){const description=document.createElement('p');description.textContent=repo.description;content.append(description);}const meta=document.createElement('small');meta.textContent=[repo.language,repo.updated?'更新于 '+new Date(repo.updated).toLocaleDateString('zh-CN'):''].filter(Boolean).join(' · ');content.append(meta);const actions=document.createElement('div');actions.className='repo-actions';const open=actionButton('GitHub ↗',()=>window.GithubProvider.open(repo.fullName));const clone=actionButton(cloneBusy?'克隆中…':'克隆',async()=>{if(cloneBusy)return;const accountId=selectedAccount;cloneBusy=true;renderRemote();error('');try{const local=await window.GithubProvider.clone(accountId,repo.fullName);if(local){await sync();if(selectedAccount===accountId&&!current)await selectRepo(local);}}finally{cloneBusy=false;renderRemote();}});clone.className='accent';clone.disabled=cloneBusy;actions.append(open,clone);row.append(content,actions);node.append(row);}\n if(!entries.length){const empty=document.createElement('div');empty.className='remote-empty';if(remoteLoading)empty.textContent='正在加载仓库…';else if(!account)empty.append(actionButton('添加 GitHub 账号',()=>openAccount(null)));else if(account.provider!=='github'){empty.textContent='此服务器通过地址克隆仓库';empty.append(actionButton('通过地址克隆',showSetup));}else if(!account.githubLogin){empty.textContent='账号尚未登录';empty.append(actionButton('登录 GitHub',()=>openAccount(account)));}else empty.textContent=query||visibility!=='all'?'没有匹配的仓库':$('remote-error').textContent?'':'暂无可访问仓库';node.append(empty);}\n $('remote-count').textContent=remoteLoading?'加载中…':remoteEntries.length+' 个已加载';$('remote-more').hidden=remoteNext===null;$('remote-more').disabled=remoteLoading;$('remote-retry').disabled=remoteLoading;$('remote-retry').hidden=!$('remote-error').textContent;\n}\nasync function loadRemote(more=false){\n const generation=++remoteGeneration,account=accounts.find(a=>a.id===selectedAccount);if(!more){remoteEntries=[];remoteNext=null;}$('remote-error').textContent='';remoteLoading=false;\n if(!account||account.provider!=='github'||!account.githubLogin){renderRemote();return;}\n if(!api.git.github.request){$('remote-error').textContent='请先将主体更新到 0.4.0，以加载远端仓库';renderRemote();return;}\n remoteLoading=true;renderRemote();try{const data=await window.GithubProvider.list(account.id,more?remoteNext:1);if(generation!==remoteGeneration)return;const combined=more?[...remoteEntries,...data.entries]:data.entries;remoteEntries=[...new Map(combined.map(r=>[r.fullName,r])).values()];remoteNext=data.next;}catch(e){if(generation===remoteGeneration)$('remote-error').textContent=e.message;}finally{if(generation===remoteGeneration){remoteLoading=false;renderRemote();}}\n}\n$('browse-remote').onclick=()=>showRemote(selectedAccount);$('remote-retry').onclick=()=>loadRemote();$('remote-more').onclick=()=>loadRemote(true);$('repo-search').oninput=renderRemote;$('visibility').onchange=renderRemote;$('repo-cancel').onclick=()=>$('repo-dialog').close();\n","backend/git-service.cjs":"const fs=require('node:fs/promises');\nconst path=require('node:path');\nconst {randomUUID}=require('node:crypto');\n\nconst PROVIDERS=new Set(['github','gitlab','self-hosted']);\nconst AUTH_METHODS=new Set(['system','ssh']);\nfunction cleanText(value,field,max=120){\n  if(typeof value!=='string'||!value.trim()||value.length>max||/[\\0\\r\\n]/.test(value))throw Error(field+'无效');\n  return value.trim();\n}\nfunction cleanRelative(value){\n  if(value===''||value===undefined)return '';\n  if(typeof value!=='string'||value.length>240||value.includes('\\0')||path.isAbsolute(value)||value.split(/[\\\\/]/).some(p=>!p||p==='.'||p==='..'))throw Error('仓库目录无效');\n  return value.replaceAll('\\\\','/');\n}\nfunction cleanFolder(value){\n  const result=cleanRelative(value);\n  if(!result||result.includes('/')||/[:<>\"|?*]/.test(result)||/[. ]$/.test(result)||/^(con|prn|aux|nul|com[0-9]|lpt[0-9])(?:\\.|$)/i.test(result))throw Error('仓库名称无效');\n  return result;\n}\nfunction cleanRemote(value){\n  const remote=cleanText(value,'远端地址',2048);\n  if(/\\s/.test(remote)||/^https?:\\/\\/[^/]*@/i.test(remote))throw Error('远端地址无效');\n  if(!/^(https?:\\/\\/|ssh:\\/\\/|git@|[\\w.-]+@[^:\\s]+:)/i.test(remote))throw Error('远端地址无效');\n  return remote;\n}\nclass GitService {\n  constructor(config){this.config=config;this.accounts=[];this.repos=[];this.tail=Promise.resolve();}\n  async init(){\n    let data={accounts:[],repos:[]};\n    try{data=JSON.parse(await fs.readFile(this.config,'utf8'));}catch(e){if(e.code!=='ENOENT')throw Error('Git 配置损坏');}\n    if(!Array.isArray(data.accounts)||!Array.isArray(data.repos))throw Error('Git 配置损坏');\n    this.accounts=data.accounts.filter(a=>a&&typeof a.id==='string'&&typeof a.owner==='string'&&typeof a.name==='string'&&PROVIDERS.has(a.provider)&&AUTH_METHODS.has(a.auth)&&(!a.githubLogin||typeof a.githubLogin==='string'));\n    this.repos=data.repos.filter(r=>r&&typeof r.id==='string'&&typeof r.owner==='string'&&typeof r.rootId==='string'&&typeof r.relative==='string');\n  }\n  serial(fn){const next=this.tail.then(fn);this.tail=next.catch(()=>{});return next;}\n  async save(){const data=JSON.stringify({accounts:this.accounts,repos:this.repos});await fs.mkdir(path.dirname(this.config),{recursive:true});await fs.writeFile(this.config+'.tmp',data);await fs.rename(this.config+'.tmp',this.config);}\n  listAccounts(owner){return this.accounts.filter(a=>a.owner===owner).map(a=>({...a}));}\n  listRepos(owner){return this.repos.filter(r=>r.owner===owner).map(r=>({...r}));}\n  saveAccount(owner,input){return this.serial(async()=>{\n    if(typeof owner!=='string')throw Error('插件身份无效');\n    const existing=typeof input?.id==='string'?this.accounts.find(a=>a.id===input.id&&a.owner===owner):null;\n    const account={id:existing?.id||randomUUID(),owner,name:cleanText(input?.name,'账号名称',60),provider:input?.provider,server:cleanText(input?.server,'服务器地址',260),auth:input?.auth,githubLogin:input?.provider==='github'?existing?.githubLogin||null:null};\n    if(!PROVIDERS.has(account.provider)||!AUTH_METHODS.has(account.auth))throw Error('账号类型无效');\n    const index=this.accounts.findIndex(a=>a.id===account.id);if(index<0)this.accounts.push(account);else this.accounts[index]=account;await this.save();return account;\n  });}\n  removeAccount(owner,id){return this.serial(async()=>{if(typeof id!=='string'||this.repos.some(r=>r.owner===owner&&r.accountId===id))throw Error('账号仍被仓库使用');const before=this.accounts.length;this.accounts=this.accounts.filter(a=>!(a.owner===owner&&a.id===id));if(before===this.accounts.length)throw Error('账号不存在');await this.save();});}\n  getAccount(owner,id){const account=this.accounts.find(a=>a.owner===owner&&a.id===id);if(!account)throw Error('账号不存在');return {...account};}\n  setGithubLogin(owner,id,login){return this.serial(async()=>{if(typeof login!=='string'||!/^[A-Za-z0-9-]{1,39}$/.test(login))throw Error('GitHub 用户名无效');const account=this.accounts.find(a=>a.owner===owner&&a.id===id&&a.provider==='github');if(!account)throw Error('GitHub 账号不存在');account.githubLogin=login;await this.save();return {...account};});}\n  addRepo(owner,rootId,relative,accountId){return this.serial(async()=>{\n    if(typeof owner!=='string'||typeof rootId!=='string')throw Error('仓库信息无效');relative=cleanRelative(relative);\n    if(accountId!==null&&accountId!==undefined&&!this.accounts.some(a=>a.owner===owner&&a.id===accountId))throw Error('账号不存在');\n    const existing=this.repos.find(r=>r.owner===owner&&r.rootId===rootId&&r.relative===relative);\n    if(existing){existing.accountId=accountId||null;await this.save();return {...existing};}\n    const repo={id:randomUUID(),owner,rootId,relative,accountId:accountId||null};this.repos.push(repo);await this.save();return {...repo};\n  });}\n  getRepo(owner,id){const repo=this.repos.find(r=>r.owner===owner&&r.id===id);if(!repo)throw Error('仓库不存在');return {...repo};}\n  removeRepo(owner,id){return this.serial(async()=>{const before=this.repos.length;this.repos=this.repos.filter(r=>!(r.owner===owner&&r.id===id));if(before===this.repos.length)throw Error('仓库不存在');await this.save();});}\n}\nmodule.exports={GitService,cleanRelative,cleanFolder,cleanRemote};\n","backend/git-worker.cjs":"const {parentPort}=require('node:worker_threads');\nconst path=require('node:path');\nconst {runFile:run,shutdown}=require('./native-process.cjs');\nconst githubAccess=new (require('./github-access.cjs').GithubAccess)();\nfunction relativeList(items){\n  if(!Array.isArray(items)||items.length>200)throw Error('文件列表无效');\n  return items.map(item=>{if(typeof item!=='string'||!item||item.length>1024||path.isAbsolute(item)||item.split(/[\\\\/]/).includes('..')||item.includes('\\0'))throw Error('文件路径无效');return item;});\n}\nfunction branch(value){if(typeof value!=='string'||!value||value.length>160||/[\\s~^:?*\\[\\\\]/.test(value)||value.includes('..'))throw Error('分支无效');return value;}\nfunction remoteName(value){if(typeof value!=='string'||!/^[-A-Za-z0-9_.]{1,64}$/.test(value))throw Error('远端名称无效');return value;}\nasync function command(binary,cwd,args,timeout=30000){\n  if(binary==='gh'){const fs=require('node:fs');const installed=path.join(process.env.ProgramFiles||'C:\\\\Program Files','GitHub CLI','gh.exe');if(fs.existsSync(installed))binary=installed;}\n  const {stdout,stderr}=await run(binary,args,{cwd,windowsHide:true,timeout,maxBuffer:1024*1024,env:{...process.env,GIT_TERMINAL_PROMPT:'0',GIT_PAGER:'cat'}});\n  return {stdout:stdout||'',stderr:stderr||''};\n}\nconst git=(cwd,args)=>command('git',cwd,args);\nasync function action(cwd,method,args){\n  if(typeof cwd!=='string'||!path.isAbsolute(cwd))throw Error('仓库路径无效');\n  switch(method){\n    case 'shutdown':await shutdown();return;\n    case 'inspect': {const [status,remotes,head]=await Promise.all([git(cwd,['status','--porcelain=v1','-b']),git(cwd,['remote','-v']),git(cwd,['branch','--show-current'])]);return {status:status.stdout,remotes:remotes.stdout,branch:head.stdout.trim()};}\n    case 'log': {try{await git(cwd,['rev-parse','--verify','HEAD']);}catch{return '';}const count=Number.isSafeInteger(args?.[0])?Math.min(Math.max(args[0],1),100):30;return (await git(cwd,['log','-n',String(count),'--date=short','--pretty=format:%h%x09%ad%x09%an%x09%s'])).stdout;}\n    case 'diff': return (await git(cwd,['diff','--stat'])).stdout;\n    case 'githubGet':return githubAccess.get(args[0],args[1],args[2]);\n    case 'authenticatedClone':return githubAccess.clone(args[0],args[1],args[2],cwd,args[3]);\n    case 'init': return (await git(cwd,['init'])).stdout;\n    case 'stage': {const files=relativeList(args?.[0]);return (await git(cwd,files.length?['add','--',...files]:['add','-A'])).stdout;}\n    case 'unstage': {const files=relativeList(args?.[0]);if(!files.length)throw Error('请选择文件');return (await git(cwd,['restore','--staged','--',...files])).stdout;}\n    case 'commit': {const message=args?.[0];if(typeof message!=='string'||!message.trim()||message.length>4096||message.includes('\\0'))throw Error('提交说明无效');return (await git(cwd,['commit','-m',message.trim()])).stdout;}\n    case 'push': return (await git(cwd,['push',remoteName(args?.[0]),branch(args?.[1])])).stdout;\n    case 'pull': return (await git(cwd,['pull','--ff-only',remoteName(args?.[0]),branch(args?.[1])])).stdout;\n    case 'clone': {const remote=args?.[0],folder=args?.[1];if(typeof remote!=='string'||typeof folder!=='string')throw Error('克隆参数无效');return (await command('git',cwd,['clone','--',remote,folder],120000)).stdout;}\n    case 'githubActivate': {const user=args?.[0];if(typeof user!=='string'||!/^[A-Za-z0-9-]{1,39}$/.test(user))throw Error('GitHub 用户名无效');await command('gh',cwd,['auth','switch','--hostname','github.com','--user',user]);return (await command('gh',cwd,['auth','setup-git','--hostname','github.com'])).stdout;}\n    default:throw Error('未知 Git 操作');\n  }\n}\nparentPort.on('message',async({id,cwd,method,args})=>{try{parentPort.postMessage({id,data:await action(cwd,method,args)});}catch(e){parentPort.postMessage({id,error:(e.stderr||e.message||'Git 操作失败').trim().slice(0,4000)});}});\n","backend/github-access.cjs":"const fs=require('node:fs'),path=require('node:path'),{runFile}=require('./native-process.cjs');\nfunction endpoint(value){\n if(typeof value!=='string'||value.length>2048||/[\\\\\\r\\n\\0#]/.test(value)||value.startsWith('/')||value.split('?')[0].split('/').some(p=>!p||p==='.'||p==='..'))throw Error('GitHub 资源路径无效');\n const url=new URL('https://api.github.com/'+value);\n if(!/^\\/(user(?:\\/repos)?|repos\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+(?:\\/[A-Za-z0-9_./-]+)?|orgs\\/[A-Za-z0-9_.-]+\\/repos|search\\/repositories)$/.test(url.pathname))throw Error('GitHub 资源不在授权范围');\n return value;\n}\nclass GithubAccess{\n constructor(run=runFile){this.run=run;const installed=path.join(process.env.ProgramFiles||'C:\\\\Program Files','GitHub CLI','gh.exe');this.gh=fs.existsSync(installed)?installed:'gh';}\n async environment(login,env){if(!/^[A-Za-z0-9-]{1,39}$/.test(login||''))throw Error('请先登录此 GitHub 账号');try{const {stdout}=await this.run(this.gh,['auth','token','--hostname','github.com','--user',login],{windowsHide:true,timeout:15000,maxBuffer:16384,env});const token=stdout.trim();if(!token||/\\s/.test(token))throw Error();return {...env,GH_TOKEN:token,GH_HOST:'github.com',GH_PROMPT_DISABLED:'1'};}catch{throw Error('此账号的 GitHub 登录已失效，请重新登录');}}\n async get(login,resource,env){const target=endpoint(resource),authorized=await this.environment(login,env);try{const result=await this.run(this.gh,['api','--hostname','github.com','--method','GET',target],{windowsHide:true,timeout:30000,maxBuffer:2*1024*1024,env:authorized});return JSON.parse(result.stdout);}catch{throw Error('GitHub 请求失败，请检查网络、代理和账号权限');}}\n async clone(login,remote,folder,cwd,env){\n  const {cleanFolder}=require('./git-service.cjs');cleanFolder(folder);\n  if(typeof remote!=='string'||!/^https:\\/\\/github\\.com\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+(?:\\.git)?$/.test(remote)||new URL(remote).pathname.split('/').some(p=>p==='.'||p==='..'))throw Error('GitHub 远端地址无效');\n  if(fs.existsSync(path.join(cwd,folder)))throw Error('目标目录已存在，请选择其他文件夹');const authorized=await this.environment(login,env),basic=Buffer.from('x-access-token:'+authorized.GH_TOKEN).toString('base64');\n  try{await this.run('git',['clone','--',remote,folder],{cwd,windowsHide:true,timeout:120000,maxBuffer:1024*1024,env:{...env,GIT_TERMINAL_PROMPT:'0',GIT_CONFIG_COUNT:'2',GIT_CONFIG_KEY_0:'credential.helper',GIT_CONFIG_VALUE_0:'',GIT_CONFIG_KEY_1:'http.https://github.com/.extraheader',GIT_CONFIG_VALUE_1:'AUTHORIZATION: basic '+basic}});}catch{throw Error('克隆失败，请检查网络和权限；未完成的目录可能需要手动处理');}return folder;\n }\n}\nmodule.exports={GithubAccess,endpoint};\n","backend/github-login.cjs":"const {spawn}=require('node:child_process');\nconst fs=require('node:fs'),path=require('node:path');\nconst URL='https://github.com/login/device';\nclass GithubLogin{\n constructor({launch=spawn,save,open=async()=>{},onState=()=>{},timeout=300000}){this.launch=launch;this.save=save;this.open=open;this.onState=onState;this.timeout=timeout;this.jobs=new Map();}\n status(owner){return this.jobs.get(owner)?.state||{phase:'idle'};}\n publish(owner,job,state){if(this.jobs.get(owner)!==job)return;job.state={...job.state,...state};this.onState(owner,job.state);}\n start(owner,accountId,env=process.env){\n  if(['starting','waiting','finishing'].includes(this.status(owner).phase))throw Error('已有登录正在进行，可先取消');\n  const job={accountId,state:{phase:'starting',accountId},child:null,buffer:'',answered:false,opened:false,finished:false};this.jobs.set(owner,job);\n  const installed=path.join(process.env.ProgramFiles||'C:\\\\Program Files','GitHub CLI','gh.exe');\n  try{\n   job.child=this.launch(fs.existsSync(installed)?installed:'gh',['auth','login','--hostname','github.com','--web','--git-protocol','https'],{windowsHide:true,env:{...env,GH_FORCE_TTY:'0'},stdio:['pipe','pipe','pipe']});\n   job.timer=setTimeout(()=>this.stop(owner,job,'error','登录超时，请重试'),this.timeout);job.timer.unref?.();\n   const output=chunk=>{\n    if(this.jobs.get(owner)!==job||job.finished)return;\n    job.buffer=(job.buffer+chunk.toString().replace(/\\x1b\\[[0-9;?]*[A-Za-z]/g,'')).slice(-16000);\n    if(!job.answered&&/Authenticate Git with your GitHub credentials/i.test(job.buffer)){job.answered=true;job.child.stdin.write('Y\\n');}\n    const code=job.buffer.match(/(?:code[^\\r\\n]*?)([A-Z0-9]{4}-[A-Z0-9]{4})\\b/i);\n    if(code){this.publish(owner,job,{phase:'waiting',code:code[1].toUpperCase(),url:URL});if(!job.browserRequested){job.browserRequested=true;void Promise.resolve().then(()=>{if(!job.finished)return this.open(URL);}).catch(()=>{if(!job.finished)this.publish(owner,job,{message:'无法打开浏览器，请手动打开授权页'});});}}\n    if(!job.opened&&/Press Enter to open/i.test(job.buffer)){job.opened=true;job.child.stdin.write('\\n');}\n   };\n   job.child.stdout.on('data',output);job.child.stderr.on('data',output);\n   job.child.stdin.on('error',()=>{});\n   job.child.on('error',()=>this.stop(owner,job,'error','无法启动 GitHub CLI，请确认已安装'));\n   job.child.on('close',code=>{void this.complete(owner,job,code);});\n  }catch{this.stop(owner,job,'error','无法启动 GitHub CLI，请确认已安装');}\n  return this.status(owner);\n }\n async complete(owner,job,code){\n  if(this.jobs.get(owner)!==job||job.finished)return;\n  if(code!==0)return this.stop(owner,job,'error','登录失败，请检查网络、代理后重试');\n  const login=job.buffer.match(/Logged in as\\s+([A-Za-z0-9-]+)/i)?.[1];\n  if(!login)return this.stop(owner,job,'error','未能确认登录账号，请重试');\n  this.publish(owner,job,{phase:'finishing'});\n  try{await this.save(owner,job.accountId,login);if(job.finished)return;clearTimeout(job.timer);job.finished=true;job.buffer='';this.publish(owner,job,{phase:'success',login,code:undefined,url:undefined});}\n  catch{this.stop(owner,job,'error','登录已完成，但账号资料保存失败，请重试');}\n }\n stop(owner,job,phase,message){if(job.finished)return;job.finished=true;clearTimeout(job.timer);job.child?.kill();job.buffer='';this.publish(owner,job,{phase,message,code:undefined,url:undefined});}\n cancel(owner){const job=this.jobs.get(owner);if(job&&!job.finished){if(job.state.phase==='finishing')throw Error('正在保存登录结果，请稍候');this.stop(owner,job,'cancelled','已取消登录');}return this.status(owner);}\n close(owner){const job=this.jobs.get(owner);if(job&&!job.finished)this.stop(owner,job,'cancelled','已取消登录');}\n dispose(){for(const owner of this.jobs.keys())this.close(owner);}\n}\nmodule.exports={GithubLogin};\n","backend/index.cjs":"const path=require('node:path'),fs=require('node:fs/promises'),{Worker}=require('node:worker_threads');\nconst {GitService,cleanRemote,cleanFolder}=require('./git-service.cjs');\nconst {GithubLogin}=require('./github-login.cjs');\nexports.create=async context=>{\n const owner=context.id,config=path.join(context.dataDir,'state-v1.json');\n // Migration belongs to this plugin. Keep the old file intact for recovery.\n try{await fs.stat(config);}catch(error){if(error.code!=='ENOENT')throw error;const legacy=path.resolve(context.dataDir,'../..','git-v1.json');try{const data=JSON.parse(await fs.readFile(legacy,'utf8'));if(!Array.isArray(data.accounts)||!Array.isArray(data.repos))throw Error('旧版 Git 数据无效');const own={accounts:data.accounts.filter(a=>a.owner===owner),repos:data.repos.filter(r=>r.owner===owner)};await fs.writeFile(config+'.tmp',JSON.stringify(own));await fs.rename(config+'.tmp',config);}catch(e){if(e.code!=='ENOENT')throw e;}}\n const service=new GitService(config);await service.init();\n const worker=new Worker(path.join(__dirname,'git-worker.cjs')),pending=new Map();let sequence=0,disposed=false;\n function operation(cwd,method,...args){if(disposed)return Promise.reject(Error('Git 后台已停止'));return new Promise((resolve,reject)=>{const id=++sequence;const timer=setTimeout(()=>{pending.delete(id);reject(Error('Git 操作超时'));},140000);pending.set(id,{resolve,reject,timer});worker.postMessage({id,cwd,method,args});});}\n worker.on('message',({id,data,error})=>{const call=pending.get(id);if(!call)return;pending.delete(id);clearTimeout(call.timer);error?call.reject(Error(error)):call.resolve(data);});\n function fail(){for(const call of pending.values()){clearTimeout(call.timer);call.reject(Error('Git 后台已停止'));}pending.clear();}\n worker.on('error',()=>{disposed=true;fail();});\n worker.on('exit',()=>{disposed=true;fail();});\n const login=new GithubLogin({save:(id,account,user)=>service.setGithubLogin(id,account,user),open:url=>context.host('browser.open',url)});\n async function environment(){const env={...process.env};let proxy='';try{proxy=await context.host('network.proxy','https://github.com');}catch{}const target=proxy.split(';').map(s=>s.trim()).find(s=>/^PROXY [\\w.\\[\\]:-]+$/.test(s));if(target){env.HTTPS_PROXY='http://'+target.slice(6);env.HTTP_PROXY=env.HTTPS_PROXY;}return env;}\n async function repository(id){const repo=service.getRepo(owner,id);return {repo,cwd:await context.host('folders.resolve',repo.rootId,repo.relative)};}\n async function activate(accountId){if(!accountId)return;const account=service.getAccount(owner,accountId);if(account.provider==='github'&&account.githubLogin)await operation(context.dataDir,'githubActivate',account.githubLogin);}\n async function clone(rootId,remote,folder,accountId){remote=cleanRemote(remote);folder=cleanFolder(folder);const account=accountId?service.getAccount(owner,accountId):null,cwd=await context.host('folders.resolve',rootId,'');if(account?.provider==='github'&&account.githubLogin&&remote.startsWith('https://github.com/'))await operation(cwd,'authenticatedClone',account.githubLogin,remote,folder,await environment());else await operation(cwd,'clone',remote,folder);return service.addRepo(owner,rootId,folder,accountId);}\n return {\n  async request(method,args){if(disposed)throw Error('Git 后台已停止');switch(method){\n   case 'accounts.list':return service.listAccounts(owner);\n   case 'accounts.save':return service.saveAccount(owner,args[0]);\n   case 'accounts.remove':return service.removeAccount(owner,args[0]);\n   case 'github.start':{const account=service.getAccount(owner,args[0]);if(account.provider!=='github')throw Error('请选择 GitHub 账号');return login.start(owner,account.id,await environment());}\n   case 'github.status':return login.status(owner);\n   case 'github.cancel':return login.cancel(owner);\n   case 'github.open':if(login.status(owner).phase!=='waiting')throw Error('当前没有待完成的登录');return context.host('browser.open','https://github.com/login/device');\n   case 'github.request':{const account=service.getAccount(owner,args[0]);if(account.provider!=='github'||!account.githubLogin)throw Error('请先登录此 GitHub 账号');return operation(context.dataDir,'githubGet',account.githubLogin,args[1],await environment());}\n   case 'github.openPage':{const resource=args[0];if(typeof resource!=='string'||resource.length>500||!/^\\/?[A-Za-z0-9_.\\/-]+$/.test(resource)||resource.startsWith('//')||resource.split('/').some(p=>p==='.'||p==='..'))throw Error('网页路径无效');return context.host('browser.open','https://github.com/'+resource.replace(/^\\//,''));}\n   case 'github.activate':return activate(args[0]);\n   case 'repos.list':return service.listRepos(owner);\n   case 'repos.remove':return service.removeRepo(owner,args[0]);\n   case 'repos.register':case 'repos.init':{const cwd=await context.host('folders.resolve',args[0],'');await operation(cwd,method==='repos.init'?'init':'inspect');return service.addRepo(owner,args[0],'',args[1]);}\n   case 'repos.clone':return clone(...args);\n   case 'repos.cloneToFolder':{cleanRemote(args[1]);cleanFolder(args[2]);if(args[0])service.getAccount(owner,args[0]);const root=await context.host('dialog.directory');return root?clone(root.id,args[1],args[2],args[0]):null;}\n   case 'status':case 'log':case 'diff':case 'stage':case 'unstage':case 'commit':case 'push':case 'pull':{const {repo,cwd}=await repository(args[0]);if(method==='push'||method==='pull')await activate(repo.accountId);return operation(cwd,method==='status'?'inspect':method,...args.slice(1));}\n   default:throw Error('未知 Git 操作');\n  }},\n  async dispose(){login.dispose();try{await operation(context.dataDir,'shutdown');}catch{}disposed=true;fail();await worker.terminate();}\n };\n};\n","backend/native-process.cjs":"const {execFile}=require('node:child_process'),{promisify}=require('node:util');\nconst exec=promisify(execFile),children=new Set();\nfunction runFile(...args){const result=exec(...args);if(result.child)children.add(result.child);void result.then(()=>children.delete(result.child),()=>children.delete(result.child));return result;}\nasync function shutdown(){await Promise.allSettled([...children].map(async child=>{if(child.pid&&process.platform==='win32'){try{await exec('taskkill.exe',['/PID',String(child.pid),'/T','/F'],{windowsHide:true,timeout:1000});}catch{child.kill();}}else child.kill();}));}\nmodule.exports={runFile,shutdown};\n","github.js":"// GitHub repository presentation belongs to this plugin. The host only supplies\n// account-bound GET requests, native clone and browser capabilities.\nwindow.GithubProvider={\n async list(accountId,page=1){\n  if(!Number.isSafeInteger(page)||page<1||page>1000)throw Error('分页无效');\n  const data=await window.GitSDK.git.github.request(accountId,`user/repos?per_page=30&page=${page}&sort=pushed&direction=desc&affiliation=owner,collaborator,organization_member`);\n  if(!Array.isArray(data))throw Error('GitHub 返回了无效仓库列表');\n  return {entries:data.filter(r=>/^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$/.test(r.full_name||'')).map(r=>({fullName:r.full_name,name:r.name,description:typeof r.description==='string'?r.description.slice(0,300):'',private:r.private===true,language:r.language||'',updated:r.pushed_at||null})),next:data.length===30?page+1:null};\n },\n clone(accountId,name){if(!/^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$/.test(name))throw Error('仓库名称无效');return window.GitSDK.git.repos.cloneToFolder(accountId,'https://github.com/'+name+'.git',name.split('/')[1]);},\n open(name){return window.GitSDK.git.github.openPage(name);}\n};\n","index.html":"<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"tokens.css\"><link rel=\"stylesheet\" href=\"style.css\"><link rel=\"stylesheet\" href=\"login.css\"><link rel=\"stylesheet\" href=\"workspace.css\"></head><body>\n<header><strong>Git</strong><span id=\"repo-title\">选择仓库</span><button id=\"refresh\">刷新</button></header>\n<div class=\"layout\">\n  <aside>\n    <section><div class=\"section-title\"><span>账号</span><button id=\"add-account\" aria-label=\"添加账号\">＋</button></div><div id=\"accounts\"></div></section>\n    <button id=\"browse-remote\" class=\"source-link\">远端仓库 <span>↗</span></button>\n    <section><div class=\"section-title\"><span>本地仓库</span><button id=\"add-repo\" aria-label=\"添加仓库\">＋</button></div><div id=\"repos\"></div></section>\n  </aside>\n  <main>\n    <section id=\"login-status\" class=\"login-status\" hidden aria-live=\"polite\"><div><strong id=\"login-message\"></strong><code id=\"login-code\"></code></div><div><button id=\"login-open\" hidden>打开授权页</button><button id=\"login-cancel\" hidden>取消登录</button></div></section>\n    <section id=\"remote-browser\"><div class=\"remote-heading\"><div><h1>仓库</h1><p id=\"remote-account\"></p></div><button id=\"remote-retry\" hidden>重试</button></div><div class=\"remote-tools\"><input id=\"repo-search\" aria-label=\"搜索已加载仓库\" placeholder=\"搜索已加载仓库\"><select id=\"visibility\" aria-label=\"仓库可见性\"><option value=\"all\">全部仓库</option><option value=\"private\">私有</option><option value=\"public\">公开</option></select><span id=\"remote-count\"></span></div><div id=\"remote-error\" role=\"status\"></div><div id=\"remote-list\"></div><button id=\"remote-more\" hidden>加载更多</button></section>\n    <div id=\"workspace\" hidden>\n      <div class=\"actions\"><span id=\"branch\"></span><select id=\"remote\"></select><input id=\"push-branch\" aria-label=\"分支\" placeholder=\"分支\"><button id=\"pull\">拉取</button><button id=\"push\">推送</button><button id=\"remove-repo\">移除</button></div>\n      <section class=\"changes\"><div class=\"section-title\"><span>改动</span><span id=\"change-count\"></span><span class=\"grow\"></span><button id=\"stage\">暂存</button><button id=\"unstage\">取消暂存</button></div><div id=\"changes\"></div></section>\n      <section class=\"commit\"><textarea id=\"message\" aria-label=\"提交说明\" placeholder=\"提交说明\"></textarea><button id=\"commit\">提交已暂存改动</button></section>\n      <details class=\"details\"><summary>提交记录</summary><pre id=\"log\"></pre></details>\n      <details class=\"details\"><summary>差异统计</summary><pre id=\"diff\"></pre></details>\n    </div>\n    <div id=\"error\" role=\"status\"></div><pre id=\"output\"></pre>\n  </main>\n</div>\n<dialog id=\"account-dialog\"><form method=\"dialog\"><h2>账号</h2><label>名称<input id=\"account-name\" maxlength=\"60\" required></label><label>类型<select id=\"provider\"><option value=\"github\">GitHub</option><option value=\"gitlab\">GitLab</option><option value=\"self-hosted\">私服</option></select></label><label>服务器<input id=\"server\" placeholder=\"https://github.com\" maxlength=\"260\" required></label><label>认证<select id=\"auth\"><option value=\"system\">系统凭据</option><option value=\"ssh\">SSH</option></select></label><menu><button value=\"cancel\" formnovalidate>取消</button><button id=\"delete-account\" value=\"delete\" formnovalidate hidden>删除</button><button id=\"github-login\" value=\"login\">浏览器登录</button><button id=\"save-account\" value=\"save\">保存</button></menu></form></dialog>\n<dialog id=\"repo-dialog\"><div class=\"dialog-heading\"><h2>添加本地仓库</h2><button id=\"repo-cancel\" aria-label=\"关闭添加仓库\">×</button></div><div id=\"setup\" class=\"setup\"><div class=\"setup-row\"><select id=\"root\" aria-label=\"仓库文件夹\"></select><select id=\"account\" aria-label=\"关联账号\"></select></div><div class=\"setup-row\"><button id=\"choose-root\">选择文件夹</button><button id=\"register\">打开已有仓库</button><button id=\"init\">初始化仓库</button></div><details><summary>通过地址克隆</summary><div class=\"clone\"><input id=\"clone-remote\" placeholder=\"远端地址\"><input id=\"clone-folder\" placeholder=\"文件夹名称\"><button id=\"clone\">克隆</button></div></details><p id=\"repo-error\" role=\"status\"></p></div></dialog>\n<script src=\"sdk.js\"></script><script src=\"github.js\"></script><script src=\"app.js\"></script></body></html>\n","login.css":".login-status{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--space-3);border:1px solid var(--color-border);border-radius:var(--radius-panel);background:var(--color-surface);padding:var(--space-4);margin-bottom:var(--space-4)}.login-status[hidden]{display:none}.login-status strong{display:block;font-weight:500;font-size:12px}.login-status code{display:block;font-size:20px;letter-spacing:2px;margin-top:var(--space-2);user-select:all}.login-status code:empty{display:none}.login-status>div:last-child{display:flex;gap:var(--space-2)}\n","sdk.js":"const core=window.workbench;\nconst call=(method,...args)=>{if(!core.backend)return Promise.reject(Error('此插件需要主体 0.5.0 的通用后台运行时'));return core.backend.request(method,args);};\nwindow.GitSDK={...core,git:{\n accounts:{list:()=>call('accounts.list'),save:data=>call('accounts.save',data),remove:id=>call('accounts.remove',id)},\n github:{start:id=>call('github.start',id),status:()=>call('github.status'),cancel:()=>call('github.cancel'),open:()=>call('github.open'),request:(id,resource)=>call('github.request',id,resource),openPage:resource=>call('github.openPage',resource),activate:id=>call('github.activate',id)},\n repos:{list:()=>call('repos.list'),remove:id=>call('repos.remove',id),register:(root,account)=>call('repos.register',root,account),init:(root,account)=>call('repos.init',root,account),clone:(root,remote,folder,account)=>call('repos.clone',root,remote,folder,account),cloneToFolder:(account,remote,folder)=>call('repos.cloneToFolder',account,remote,folder)},\n status:id=>call('status',id),log:(id,count)=>call('log',id,count),diff:id=>call('diff',id),stage:(id,files)=>call('stage',id,files),unstage:(id,files)=>call('unstage',id,files),commit:(id,message)=>call('commit',id,message),push:(id,remote,branch)=>call('push',id,remote,branch),pull:(id,remote,branch)=>call('pull',id,remote,branch)\n}};\n","style.css":"*{box-sizing:border-box}body{margin:0;height:100vh;display:flex;flex-direction:column;background:var(--color-bg);color:var(--color-text);font:13px var(--font-ui)}button,input,select,textarea{font:inherit;color:inherit}button,input,select,textarea{border:1px solid var(--color-border);border-radius:var(--radius-control);background:var(--color-surface)}button{padding:6px 10px;cursor:pointer}button:hover{background:var(--color-surface-hover)}button:disabled{opacity:.45;cursor:default}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--color-focus);outline-offset:1px}header{height:53px;display:flex;align-items:center;gap:12px;padding:0 var(--space-4);border-bottom:1px solid var(--color-border)}header strong{font-weight:550}header span{color:var(--color-muted);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.layout{min-height:0;flex:1;display:grid;grid-template-columns:220px minmax(0,1fr)}aside{border-right:1px solid var(--color-border);padding:12px 8px;overflow:auto}section{margin-bottom:20px}.section-title{display:flex;align-items:center;gap:8px;min-height:30px;color:var(--color-muted);font-size:11px;padding:0 4px}.section-title button{margin-left:auto;padding:3px 7px;border:0;background:transparent;font-size:16px}.account,.repo{display:flex;width:100%;align-items:center;gap:7px;border:0;background:transparent;text-align:left;padding:7px 8px;border-radius:6px;overflow:hidden}.account:hover,.repo:hover,.selected{background:var(--color-selected)}.account span,.repo span{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.account small,.repo small{display:block;color:var(--color-muted);font-size:10px}.dot{width:7px;height:7px;border-radius:99px;background:var(--color-decor);flex:none}.repo.selected .dot{background:var(--color-accent)}.empty{color:var(--color-muted);font-size:12px;padding:5px 8px}main{min-width:0;padding:16px 20px;overflow:auto}.setup{max-width:650px;padding-top:20px}.setup-row,.clone,.actions{display:flex;align-items:center;gap:8px;margin-bottom:10px}.setup select,.clone input{min-width:0;flex:1;padding:7px}.setup details{margin-top:15px;color:var(--color-muted)}.clone{padding:12px 0}.actions{position:sticky;top:-16px;padding:10px 0;background:var(--color-bg);border-bottom:1px solid var(--color-border);z-index:1}.actions span{min-width:0;flex:1;color:var(--color-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.actions input{width:130px;padding:6px}.changes{border-bottom:1px solid var(--color-border);margin-top:12px}.changes .section-title{padding:0}.grow{flex:1}.file{display:grid;grid-template-columns:22px 56px minmax(0,1fr);align-items:center;gap:8px;min-height:31px;border-top:1px solid var(--color-border);font:12px Consolas,'Microsoft YaHei',monospace}.file input{accent-color:var(--color-accent)}.file .state{color:var(--color-muted);font-size:11px}.file .path{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.commit{display:flex;gap:8px;padding:16px 0}.commit textarea{min-height:58px;resize:vertical;padding:8px;flex:1}.commit button{align-self:flex-end}.details{border-top:1px solid var(--color-border);padding:10px 0}.details summary{cursor:pointer;color:var(--color-muted);font-size:12px}pre{margin:8px 0 0;white-space:pre-wrap;overflow-wrap:anywhere;font:11px/1.7 Consolas,'Microsoft YaHei',monospace;color:var(--color-muted)}#output:empty,#error:empty{display:none}#error{margin-top:12px;color:var(--color-danger)}dialog{width:min(380px,calc(100vw - 32px));border:1px solid var(--color-border);border-radius:var(--radius-panel);background:var(--color-bg);color:var(--color-text);box-shadow:var(--shadow-dock)}dialog::backdrop{background:#0004}dialog form{display:grid;gap:12px;padding:4px}dialog h2{font-size:15px;font-weight:550;margin:0 0 4px}dialog label{display:grid;gap:5px;font-size:12px;color:var(--color-muted)}dialog input,dialog select{padding:7px}dialog menu{display:flex;gap:8px;justify-content:flex-end;margin:4px 0 0;padding:0}#delete-account{margin-right:auto;color:var(--color-danger)}@media(max-width:700px){.layout{grid-template-columns:155px minmax(0,1fr)}.actions{flex-wrap:wrap}.actions span{flex-basis:100%}.setup-row{flex-wrap:wrap}.setup-row>*{flex:1}.clone{flex-wrap:wrap}.clone input{flex-basis:100%}}\n","workspace.css":"body>header{height:60px;background:var(--color-surface);padding:0 var(--space-6)}header strong{font-size:17px;letter-spacing:.5px}header>span{padding-left:var(--space-4);border-left:1px solid var(--color-border)}.layout{grid-template-columns:244px minmax(0,1fr)}aside{background:var(--color-bg);padding:var(--space-4) var(--space-3)}aside section{margin-bottom:var(--space-6)}.section-title{color:var(--color-muted);letter-spacing:.4px;margin-bottom:var(--space-2)}.account-row{display:flex;align-items:center;border-radius:var(--radius-panel);padding:var(--space-1);margin-bottom:var(--space-1)}.account-row .account{background:none;padding:var(--space-2);gap:var(--space-3)}.account-avatar{display:grid;place-items:center;flex-shrink:0;width:32px;height:32px;border-radius:10px;background:var(--color-surface);color:var(--color-accent);font-weight:600}.account b{font-weight:500}.account small{margin-top:var(--space-1)}.account-edit{padding:var(--space-2);border:0;background:transparent;color:var(--color-muted)}.account-empty{width:100%;border-style:dashed;padding:var(--space-3)}.source-link{display:flex;justify-content:space-between;align-items:center;width:100%;border:0;border-bottom:1px solid var(--color-border);border-radius:0;padding:var(--space-3) var(--space-2);margin-bottom:var(--space-4);color:var(--color-accent);background:none}.repo b{font-weight:500}.repo small{margin-top:var(--space-1)}main{padding:var(--space-6) 32px;background:var(--color-surface);scrollbar-gutter:stable}#remote-browser{max-width:1080px;margin:auto}.remote-heading{display:flex;justify-content:space-between;align-items:center;gap:var(--space-4);margin-bottom:var(--space-6)}.remote-heading h1{font-size:25px;font-weight:500;margin:0}.remote-heading p{color:var(--color-muted);margin:var(--space-2) 0 0;font-size:12px}.remote-tools{display:flex;align-items:center;gap:var(--space-3);padding-bottom:var(--space-4);border-bottom:1px solid var(--color-border)}.remote-tools input{padding:9px 12px;min-width:100px;flex:1;max-width:380px;background:var(--color-bg)}.remote-tools select{padding:9px}.remote-tools>span{margin-left:auto;font-size:11px;color:var(--color-muted);white-space:nowrap}.remote-repo{display:flex;align-items:center;justify-content:space-between;gap:var(--space-6);padding:22px var(--space-1);border-bottom:1px solid var(--color-border)}.remote-repo-info{min-width:0;flex:1}.repo-heading{display:flex;align-items:center;gap:var(--space-2)}.repo-name{font-size:15px;color:var(--color-accent);font-weight:550;padding:0;border:0;background:none;text-align:left;overflow-wrap:anywhere}.repo-badge{font-size:10px;color:var(--color-muted);border:1px solid var(--color-border);padding:2px 6px;border-radius:20px;white-space:nowrap}.remote-repo-info p{font-size:12px;line-height:1.6;color:var(--color-muted);margin:var(--space-2) 0;overflow-wrap:anywhere}.remote-repo-info small{display:block;color:var(--color-muted);font-size:11px;margin-top:var(--space-2)}.repo-actions{display:flex;align-items:center;gap:var(--space-2);flex-shrink:0}.repo-actions button{font-size:12px}.repo-actions .accent,#commit{background:var(--color-accent);color:var(--color-accent-text);border-color:var(--color-accent)}.remote-empty{display:flex;flex-direction:column;align-items:center;gap:var(--space-4);padding:60px var(--space-4);color:var(--color-muted)}#remote-more{display:block;margin:var(--space-6) auto}#remote-more[hidden]{display:none}#remote-error,#repo-error{font-size:12px;color:var(--color-danger);padding:var(--space-2) 0}#remote-error:empty,#repo-error:empty{display:none}#repo-dialog{width:min(650px,calc(100vw - 40px));padding:var(--space-6)}.dialog-heading{display:flex;align-items:center;justify-content:space-between;gap:var(--space-4)}.dialog-heading h2{font-size:16px;font-weight:500}.dialog-heading button{border:0;background:none;font-size:20px}.setup{padding-top:var(--space-6)}.setup-row{gap:var(--space-3);margin-bottom:var(--space-4)}#workspace{max-width:1080px;margin:auto}.actions{top:-24px;background:var(--color-surface);padding-bottom:var(--space-4)}.changes{margin-top:var(--space-6);padding:var(--space-4);border:1px solid var(--color-border);border-radius:var(--radius-panel)}.changes .section-title button{font-size:12px;border:1px solid var(--color-border)}.file{min-height:38px}.commit{border-top:0;padding:var(--space-4);border-radius:var(--radius-panel);background:var(--color-bg)}.commit textarea{min-height:80px;background:var(--color-surface)}.details{padding:var(--space-4) 0}.details summary{font-size:13px}#output{padding:var(--space-3);background:var(--color-bg);border-radius:var(--radius-control)}@media(max-width:900px){.layout{grid-template-columns:200px minmax(0,1fr)}main{padding:var(--space-4)}.repo-actions{flex-direction:column}.remote-tools{flex-wrap:wrap}.remote-tools>span{margin-left:0}.remote-repo{gap:var(--space-3)}}\n","tokens.css":":root {\n  color-scheme: light;\n  --color-bg: #eeeee8;\n  --color-surface: #fafaf6;\n  --color-surface-hover: #eef1f5;\n  --color-border: #dcded5;\n  --color-text: #303c36;\n  --color-muted: #6d786f;\n  --color-accent: #356855;\n  --color-accent-text: #ffffff;\n  --color-selected: #e0e9df;\n  --color-danger: #b42318;\n  --color-success: #177245;\n  --color-focus: #356855;\n  --syntax-keyword: #8541a3;\n  --syntax-string: #34734c;\n  --syntax-comment: #6a786f;\n  --syntax-number: #a15b21;\n  --syntax-function: #276c9c;\n  --syntax-key: #96524c;\n  --syntax-warning: #875f10;\n  --syntax-mark: #f4df91;\n  --color-paper: #fffef9;\n  --color-paper-line: #e9e9df;\n  --color-decor: #94aa8e;\n  --color-dock: #fafbf7;\n  --color-dock-note: #e7e9d9;\n  --color-dock-task: #dce9df;\n  --color-dock-file: #eae0ce;\n  --shadow-paper: 0 12px 30px #394b3510;\n  --shadow-dock: 0 10px 35px #34403216;\n  --font-ui: 'Segoe UI Variable', 'Segoe UI', 'Microsoft YaHei UI', sans-serif;\n  --font-size-body: 14px;\n  --radius-control: 6px;\n  --radius-panel: 8px;\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-6: 24px;\n  --sidebar-width: 208px;\n  --control-height: 32px;\n}\n[data-theme='dark'] {\n  color-scheme: dark;\n  --color-bg: #202723;\n  --color-surface: #2a322c;\n  --color-surface-hover: #2b3340;\n  --color-border: #465048;\n  --color-text: #edf0f5;\n  --color-muted: #abb6c7;\n  --color-accent: #b3ceb9;\n  --color-accent-text: #223d30;\n  --color-selected: #3a4d3e;\n  --color-danger: #ffaca4;\n  --color-success: #85d6ad;\n  --color-focus: #b3ceb9;\n  --syntax-keyword: #cf9ee6;\n  --syntax-string: #a6c897;\n  --syntax-comment: #9da99e;\n  --syntax-number: #e5b481;\n  --syntax-function: #8bc2df;\n  --syntax-key: #e3a49b;\n  --syntax-warning: #e4bd6b;\n  --syntax-mark: #605b35;\n  --color-paper: #303831;\n  --color-paper-line: #454e43;\n  --color-decor: #78916f;\n  --color-dock: #2a352d;\n  --color-dock-note: #4a4b39;\n  --color-dock-task: #3d5747;\n  --color-dock-file: #594e3b;\n}\n"}}