{"manifest":{"id":"mc-hanhua","name":"MC 汉化","version":"1.0.0","apiVersion":1,"entry":"index.html","backend":"backend/index.cjs","permissions":["folders.read","native.backend"]},"files":{"app.js":"'use strict';\n\n/* MC 汉化插件前端：所有数据与操作都走工作台后台，页面本身不发网络请求。 */\n\nconst core=window.workbench;\nconst call=(method,...args)=>core.backend.request(method,args);\n\nconst $=id=>document.getElementById(id);\nconst val=id=>{const node=$(id);return node&&typeof node.value==='string'?node.value:'';};\nconst msgOf=error=>error&&error.message?String(error.message):String(error||'未知错误');\nconst num=value=>{const n=Number(value);return Number.isFinite(n)?n:0;};\nconst fmtInt=value=>num(value).toLocaleString('zh-CN');\nconst mb=size=>(num(size)/1048576).toFixed(2)+' MB';\nconst baseName=path=>{const parts=String(path||'').split(/[\\\\/]+/).filter(Boolean);return parts.length?parts[parts.length-1]:'';};\nconst tagOf=path=>baseName(path).replace(/[\\\\/:*?\"<>|]/g,'').replace(/\\s+/g,'-');\nconst when=iso=>{\n  if(!iso)return '';\n  const date=new Date(iso);\n  if(Number.isNaN(date.getTime()))return '';\n  return date.toLocaleString('zh-CN',{month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'});\n};\n\nconst STATUS_MS=3000;\nconst LOG_MS=1500;\n\nconst S={\n  view:'overview',\n  status:null,\n  items:[],\n  modsLoaded:false,\n  modsLoading:false,\n  lastSeq:0,\n  seen:new Set(),\n  follow:true,\n  logEmpty:true,\n  progressKnown:false,\n  phase:'',\n  prevRunning:false,\n  optimistic:false,\n  apiFilled:false,\n  packDirty:false,\n  drawerNs:'',\n  drawerTrigger:null,\n  query:'',\n  sort:'gap',\n  gapOnly:true,\n  timerStatus:0,\n  timerLog:0,\n};\n\n/* ---------------- 提示条 ---------------- */\n\nlet noticeTimer=0;\n\nfunction notify(message,kind){\n  const bar=$('notice');\n  if(!bar)return;\n  const text=$('notice-text');\n  if(text)text.textContent=String(message||'');\n  bar.classList.toggle('ok',kind==='ok');\n  bar.hidden=false;\n  clearTimeout(noticeTimer);\n  if(kind==='ok')noticeTimer=setTimeout(()=>{bar.hidden=true;},6000);\n}\n\nfunction hideNotice(){\n  const bar=$('notice');\n  if(bar)bar.hidden=true;\n  clearTimeout(noticeTimer);\n}\n\n/* ---------------- 视图切换 ---------------- */\n\nconst navButtons=Array.from(document.querySelectorAll('.nav button'));\nconst views=Array.from(document.querySelectorAll('.view'));\n\nfunction showView(name){\n  if(!name)return;\n  S.view=name;\n  for(const button of navButtons){\n    const on=button.dataset.view===name;\n    button.classList.toggle('selected',on);\n    if(on)button.setAttribute('aria-current','page');\n    else button.removeAttribute('aria-current');\n  }\n  for(const view of views){\n    view.hidden=view.dataset.view!==name;\n  }\n  if(name==='mods'&&!S.modsLoaded)loadMods();\n  if(name==='api'&&!S.apiFilled)fillApiForm(S.status&&S.status.config);\n}\n\n/* ---------------- 状态 ---------------- */\n\nasync function refreshStatus(force){\n  if(document.hidden&&!force)return;\n  try{\n    const status=await call('status');\n    renderStatus(status);\n  }catch(error){\n    const name=$('pack-name');\n    if(name)name.textContent='读取状态失败';\n    setChip('api-chip','api-chip-text','warn','状态不可用');\n    setChip('job-chip','job-chip-text','warn','状态不可用');\n    notify('读取状态失败：'+msgOf(error),'err');\n  }\n}\n\nfunction setChip(chipId,textId,state,label){\n  const chip=$(chipId);\n  if(chip){\n    chip.classList.toggle('ok',state==='ok');\n    chip.classList.toggle('warn',state==='warn');\n  }\n  const text=$(textId);\n  if(text&&text.textContent!==label)text.textContent=label;\n}\n\nfunction setBar(fill,pct){\n  if(!fill)return;\n  fill.style.width=Math.max(0,Math.min(100,num(pct)))+'%';\n}\n\nfunction ariaBar(node,pct){\n  if(!node)return;\n  if(pct===null||pct===undefined){node.removeAttribute('aria-valuenow');return;}\n  node.setAttribute('aria-valuenow',String(Math.round(num(pct))));\n}\n\nfunction renderStatus(status){\n  if(!status||typeof status!=='object')return;\n  S.status=status;\n\n  const pack=String(status.pack||'');\n  const packver=status.packver||null;\n  const name=packver&&packver.name?String(packver.name):(pack?baseName(pack):'未选择整合包');\n  const nameNode=$('pack-name');\n  if(nameNode)nameNode.textContent=name;\n\n  const pathNode=$('pack-path');\n  const pathText=pack||'还没有选择整合包目录';\n  if(pathNode){\n    if(pathNode.textContent!==pathText)pathNode.textContent=pathText;\n    pathNode.title=pathText;\n  }\n\n  const config=status.config||{};\n  setChip('api-chip','api-chip-text',config.hasKey?'ok':'warn',config.hasKey?'接口已配置':'接口未配置');\n\n  const tool=status.tool||{};\n  const toolState=$('tool-state');\n  if(toolState)toolState.textContent=tool.ok?'工具链就绪':(tool.root?'工具链目录无效':'未设置工具链');\n  const toolDot=$('tool-dot');\n  if(toolDot)toolDot.classList.toggle('bad',!tool.ok);\n\n  const toolInput=$('tool-input');\n  if(toolInput&&toolInput.value!==(tool.root||''))toolInput.value=tool.root||'';\n\n  const packInput=$('pack-input');\n  if(packInput&&!S.packDirty&&packInput.value!==pack)packInput.value=pack;\n\n  renderStats(status);\n  renderArtifacts(status);\n  renderFlags(status);\n  renderJob(status.job||{});\n  fillApiForm(config);\n\n  const cfgState=$('cfg-api-state');\n  if(cfgState)cfgState.textContent=config.hasKey?('已配置 '+(config.keyHint||''))+(config.fromEnv?'（环境变量）':''):'未配置';\n  const cfgModel=$('cfg-model');\n  if(cfgModel)cfgModel.textContent=config.model||'—';\n  const cfgNums=$('cfg-nums');\n  if(cfgNums)cfgNums.textContent=(config.concurrency||'—')+' / '+(config.batchSize||'—');\n  const cfgFile=$('cfg-file');\n  if(cfgFile){\n    const root=(status.settings&&status.settings.toolRoot)||tool.root||'';\n    cfgFile.textContent=root?root+'\\\\config.local.json':'—';\n    cfgFile.title=cfgFile.textContent;\n  }\n\n  const hint=$('game-hint');\n  if(hint){\n    const rpName=(tagOf(pack)||'<包名>')+'-zh_cn-resourcepack';\n    hint.textContent='进游戏后在资源包列表最上面启用 '+rpName+'；任务书改动重进世界或执行 /ftbquests reload。';\n  }\n}\n\nfunction renderStats(status){\n  const mods=status.mods;\n  const pctValue=$('stat-pct');\n  if(mods){\n    const pct=num(mods.pct);\n    if(pctValue)pctValue.textContent=pct.toFixed(1)+'%';\n    setBar($('bar-pct'),pct);\n    ariaBar($('stat-pct-bar'),pct);\n    setNote('stat-pct-note',fmtInt(mods.zh)+' / '+fmtInt(mods.en)+' 键已有中文');\n    setNote('stat-gap',fmtInt(mods.gap),true);\n    setNote('stat-gap-note',fmtInt(mods.namespaces)+' 个命名空间，AI 补 '+fmtInt(mods.aiTranslated)+' 键');\n  }else{\n    if(pctValue)pctValue.textContent='—';\n    setBar($('bar-pct'),0);\n    ariaBar($('stat-pct-bar'),0);\n    setNote('stat-pct-note','尚未扫描');\n    setNote('stat-gap','—',true);\n    setNote('stat-gap-note','尚未扫描');\n  }\n\n  const text=status.text;\n  if(text&&text.quests){\n    const quests=text.quests;\n    const kubejs=text.kubejs||{};\n    setNote('stat-text',fmtInt(quests.done)+'/'+fmtInt(quests.units),true);\n    setNote('stat-text-note','KubeJS '+fmtInt(kubejs.done)+'/'+fmtInt(kubejs.units)+' 单元');\n  }else{\n    setNote('stat-text','—',true);\n    setNote('stat-text-note','尚未扫描');\n  }\n\n  const verify=status.verify;\n  const verifyNode=$('stat-verify');\n  if(verify){\n    // errors 是校验失败，warns 只是「未译且较长」这类待补提示，两者不能合并成「N 个问题」吓人。\n    const errors=num(verify.errors),warns=num(verify.warns);\n    if(verifyNode){\n      if(errors>0){verifyNode.textContent=fmtInt(errors)+' 个错误';verifyNode.classList.add('bad');verifyNode.classList.remove('good');}\n      else if(warns>0){verifyNode.textContent=fmtInt(warns)+' 处待补';verifyNode.classList.remove('bad');verifyNode.classList.remove('good');}\n      else{verifyNode.textContent='通过';verifyNode.classList.remove('bad');verifyNode.classList.add('good');}\n    }\n    setNote('stat-verify-note','覆盖率 '+(verify.coverage||'—')+' · '+fmtInt(verify.translated)+'/'+fmtInt(verify.total)+' 键'+(warns>0&&errors===0?' · 无错误':''));\n  }else{\n    if(verifyNode){\n      verifyNode.textContent='—';\n      verifyNode.classList.remove('bad');\n      verifyNode.classList.remove('good');\n    }\n    setNote('stat-verify-note','尚未扫描');\n  }\n}\n\nfunction setNote(id,text){\n  const node=$(id);\n  if(!node)return;\n  if(node.textContent!==text)node.textContent=text;\n}\n\nfunction renderArtifacts(status){\n  const installed=status.installed||{};\n  const rp=installed.rp;\n  setNote('art-rp',rp?((installed.rpName||'资源包')+' · '+mb(rp.size)+(rp.mtime?' · '+when(rp.mtime):'')):'未安装');\n\n  const quests=num(installed.questFiles);\n  setNote('art-quest',installed.questOk?fmtInt(quests)+' 个文件':(quests>0?fmtInt(quests)+' 个文件':'未安装'));\n\n  setNote('art-cache',fmtInt(status.cache)+' 条');\n  setNote('art-gap',status.totalGap===null||status.totalGap===undefined?'—':fmtInt(status.totalGap));\n}\n\nfunction renderFlags(status){\n  const box=$('flags');\n  if(!box)return;\n  const list=[];\n  const tool=status.tool||{};\n  const config=status.config||{};\n\n  if(!tool.ok)list.push({text:'找不到汉化工具链目录，里面要有 tools/pipeline.mjs。',action:'tool',label:'选择工具链目录'});\n  if(!status.ready)list.push({text:'找不到整合包目录：路径没设，或者文件夹里没有 mods。',action:'pack',label:'选择文件夹'});\n  if(status.ready&&status.stale)list.push({text:'目录已切换，统计还是上一次的，先跑一次扫描估算。',action:'scan',label:'扫描估算'});\n  if(status.ready&&status.canWrite===false)list.push({text:'写不进游戏目录，打包安装会失败（游戏正在运行？权限不够？）'});\n  if(config.error)list.push({text:config.error});\n\n  box.replaceChildren();\n  if(!list.length){box.hidden=true;return;}\n  box.hidden=false;\n\n  for(const item of list){\n    const row=document.createElement('div');\n    row.className='flag';\n    const text=document.createElement('p');\n    text.textContent=item.text;\n    row.append(text);\n    if(item.action){\n      const button=document.createElement('button');\n      button.type='button';\n      button.textContent=item.label;\n      button.addEventListener('click',()=>{\n        if(item.action==='tool')pickTool();\n        else if(item.action==='pack')pickPack();\n        else if(item.action==='scan'){\n          const mode=$('mode');\n          if(mode)mode.value='dry';\n          showView('translate');\n          startRun();\n        }\n      });\n      row.append(button);\n    }\n    box.append(row);\n  }\n}\n\n/* ---------------- 任务状态 ---------------- */\n\nfunction setJobBusy(running){\n  const busy=!!running||S.optimistic;\n  const run=$('run');\n  const stop=$('stop');\n  if(run)run.disabled=busy;\n  if(stop)stop.disabled=!busy;\n}\n\nfunction renderJob(job){\n  const running=!!job.running;\n  const elapsed=num(job.elapsed);\n\n  if(running){\n    setChip('job-chip','job-chip-text','ok','运行中 · '+elapsed+' 秒');\n  }else if(job.lastExit!==null&&job.lastExit!==undefined&&num(job.lastExit)!==0){\n    setChip('job-chip','job-chip-text','warn','上次退出码 '+String(job.lastExit));\n  }else if(job.lastExit!==null&&job.lastExit!==undefined){\n    setChip('job-chip','job-chip-text','','上次成功');\n  }else{\n    setChip('job-chip','job-chip-text','','空闲');\n  }\n\n  setJobBusy(running);\n\n  if(running){\n    if(!S.progressKnown){\n      const wrap=$('job-bar-wrap');\n      if(wrap&&!wrap.classList.contains('indeterminate')){\n        wrap.classList.add('indeterminate');\n        setBar($('job-bar'),30);\n        ariaBar(wrap,null);\n      }\n      const text=$('progress-text');\n      const label='运行中 · 已 '+elapsed+' 秒'+(S.phase?' · '+S.phase:'');\n      if(text&&text.textContent!==label)text.textContent=label;\n    }\n  }else if(S.prevRunning){\n    S.prevRunning=false;\n    S.progressKnown=false;\n    S.phase='';\n    const wrap=$('job-bar-wrap');\n    if(wrap)wrap.classList.remove('indeterminate');\n    const ok=num(job.lastExit)===0;\n    setBar($('job-bar'),ok?100:0);\n    ariaBar($('job-bar-wrap'),ok?100:0);\n    setNote('progress-text',ok?'任务结束':('任务结束（退出码 '+String(job.lastExit)+'）'));\n    refreshStatus(true).then(()=>loadMods(true));\n    return;\n  }\n\n  S.prevRunning=running;\n}\n\n/* ---------------- 日志 ---------------- */\n\nfunction kindOf(text){\n  if(/^===/.test(text))return 'step';\n  if(/\\[完成\\]/.test(text))return 'ok';\n  if(/\\[错误\\]|\\[失败\\]|\\[结束\\]|失败|错误|异常|超时|拒绝|HTTP\\s*[45]\\d\\d|Error|error:/.test(text))return 'err';\n  if(/警告|跳过|warn/i.test(text))return 'warn';\n  return 'plain';\n}\n\nfunction readProgress(text){\n  const step=/^===\\s*(.*?)\\s*===/.exec(text);\n  if(step&&step[1]){\n    S.phase=step[1];\n    if(!S.progressKnown)setNote('progress-text','进行中 · '+step[1]);\n  }\n  const hit=/^\\[(\\d+)\\/(\\d+)\\]\\s+(\\d+)\\/(\\d+)\\s+条/.exec(text);\n  if(!hit)return;\n  const index=num(hit[1]);\n  const steps=num(hit[2]);\n  const done=num(hit[3]);\n  const total=num(hit[4]);\n  S.progressKnown=true;\n  const wrap=$('job-bar-wrap');\n  if(wrap)wrap.classList.remove('indeterminate');\n  const pct=steps?Math.min(100,index/steps*100):0;\n  setBar($('job-bar'),pct);\n  ariaBar($('job-bar-wrap'),pct);\n  setNote('progress-text','['+index+'/'+steps+'] '+fmtInt(done)+'/'+fmtInt(total)+' 条'+(S.phase?' · '+S.phase:''));\n}\n\nfunction appendLine(n,text){\n  const log=$('log');\n  if(!log)return;\n  if(S.logEmpty){\n    log.replaceChildren();\n    S.logEmpty=false;\n  }\n  const line=document.createElement('div');\n  line.className='log-line '+kindOf(text);\n  line.dataset.n=String(n);\n  line.textContent=text;\n  log.append(line);\n  readProgress(text);\n  if(S.follow)log.scrollTop=log.scrollHeight;\n}\n\nfunction applyLogs(data){\n  if(!data)return;\n  const lines=Array.isArray(data.lines)?data.lines:[];\n  for(const line of lines){\n    const n=num(line&&line.n);\n    if(!n||S.seen.has(n))continue;\n    S.seen.add(n);\n    appendLine(n,String(line&&line.t!=null?line.t:''));\n  }\n  if(typeof data.seq==='number')S.lastSeq=Math.max(S.lastSeq,num(data.seq));\n  if(data.job)renderJob(data.job);\n}\n\nasync function tickLogs(){\n  if(!$('log'))return;\n  try{\n    const data=await call('logs',S.lastSeq);\n    if(!data)return;\n    if(typeof data.seq==='number'&&num(data.seq)<S.lastSeq){\n      // 后台缓冲被新任务重置过，从头拉\n      S.lastSeq=0;\n      S.seen.clear();\n      S.logEmpty=true;\n      const log=$('log');\n      if(log)log.replaceChildren();\n      const again=await call('logs',0);\n      applyLogs(again);\n      return;\n    }\n    applyLogs(data);\n  }catch(error){\n    /* 轮询失败不打断页面，状态轮询会给出提示 */\n  }\n}\n\nasync function clearLogs(){\n  const log=$('log');\n  if(!log)return;\n  log.replaceChildren();\n  S.seen.clear();\n  S.logEmpty=false;\n  const placeholder=document.createElement('p');\n  placeholder.className='log-empty';\n  placeholder.textContent='面板已清空。下一次运行会重新开始记录。';\n  log.append(placeholder);\n  S.logEmpty=true;\n  try{\n    const data=await call('logs',S.lastSeq);\n    if(data&&typeof data.seq==='number')S.lastSeq=Math.max(S.lastSeq,num(data.seq));\n  }catch(error){/* 忽略 */}\n}\n\n/* ---------------- 运行 / 停止 ---------------- */\n\nasync function startRun(){\n  const mode=(val('mode')||'translate').trim();\n  const kind=(val('kind')||'all').trim();\n  const ns=val('ns').trim();\n  const rawLimit=val('limit').trim();\n  const limit=rawLimit?Math.max(0,Math.round(Number(rawLimit))||0):0;\n\n  const config=(S.status&&S.status.config)||null;\n  if(mode==='translate'&&config&&!config.hasKey){\n    notify('还没配置 API Key，先去「接口」填。','err');\n    showView('api');\n    return;\n  }\n\n  S.optimistic=true;\n  setJobBusy(true);\n  S.progressKnown=false;\n  S.phase='';\n  S.prevRunning=true;\n  S.seen.clear();\n  S.lastSeq=0;\n  S.logEmpty=true;\n  const log=$('log');\n  if(log)log.replaceChildren();\n  const wrap=$('job-bar-wrap');\n  if(wrap)wrap.classList.remove('indeterminate');\n  setBar($('job-bar'),0);\n  ariaBar($('job-bar-wrap'),0);\n  setNote('progress-text','正在启动…');\n\n  try{\n    await call('run',mode,{kind,ns,limit});\n  }catch(error){\n    S.optimistic=false;\n    S.prevRunning=false;\n    setJobBusy(false);\n    setNote('progress-text','启动失败');\n    notify('启动失败：'+msgOf(error),'err');\n    return;\n  }\n\n  S.optimistic=false;\n  notify(mode==='dry'?'已开始估算':(mode==='build'?'已开始打包回写':'已开始翻译'),'ok');\n  await tickLogs();\n  await refreshStatus(true);\n}\n\nasync function stopRun(){\n  try{\n    const result=await call('stop');\n    const stopped=!!(result&&result.stopped);\n    notify(stopped?'已请求停止':'当前没有在跑的任务',stopped?'ok':'err');\n  }catch(error){\n    notify('停止失败：'+msgOf(error),'err');\n  }\n  await refreshStatus(true);\n}\n\n/* ---------------- 路径 ---------------- */\n\nasync function applyPack(){\n  const raw=val('pack-input');\n  const path=raw.trim().replace(/^\"+|\"+$/g,'').replace(/[\\\\/]+$/,'');\n  if(!path){\n    notify('先填整合包路径，或者点「选择文件夹」。','err');\n    return;\n  }\n  try{\n    const result=await call('savePack',path);\n    S.packDirty=false;\n    notify(result&&result.note?result.note:'整合包已切换','ok');\n    await refreshStatus(true);\n    await loadMods(true);\n  }catch(error){\n    notify('应用失败：'+msgOf(error),'err');\n  }\n}\n\nasync function pickPack(){\n  try{\n    const result=await call('pickPack');\n    if(!result||result.canceled)return;\n    S.packDirty=false;\n    notify(result.note||'整合包已切换','ok');\n    await refreshStatus(true);\n    await loadMods(true);\n  }catch(error){\n    notify('选择失败：'+msgOf(error),'err');\n  }\n}\n\nasync function pickTool(){\n  try{\n    const result=await call('setToolRoot');\n    if(!result||result.canceled)return;\n    S.apiFilled=false;\n    notify('工具链目录已更新','ok');\n    await refreshStatus(true);\n  }catch(error){\n    notify('工具链目录无效：'+msgOf(error),'err');\n  }\n}\n\nasync function openTarget(target){\n  try{\n    await call('open',target);\n  }catch(error){\n    notify('打不开目录：'+msgOf(error),'err');\n  }\n}\n\n/* ---------------- 接口设置 ---------------- */\n\nfunction fillApiForm(config,force){\n  if(!config)return;\n  if(!force&&S.apiFilled)return;\n  const put=(id,value)=>{\n    const node=$(id);\n    if(!node)return;\n    if(document.activeElement===node)return;\n    node.value=value===null||value===undefined?'':String(value);\n  };\n  put('f-base',config.baseUrl||'');\n  put('f-model',config.model||'');\n  put('f-key','');\n  put('f-concurrency',config.concurrency||'');\n  put('f-batch',config.batchSize||'');\n\n  const key=$('f-key');\n  if(key)key.placeholder=config.hasKey?('已保存 '+(config.keyHint||'••••')+'，留空则不改'):'还没有保存 Key，粘贴一个';\n  const row=$('key-clear-row');\n  if(row)row.hidden=!config.hasKey;\n  S.apiFilled=true;\n}\n\nasync function saveApiForm(){\n  const patch={};\n  const base=val('f-base').trim();\n  const model=val('f-model').trim();\n  const concurrency=val('f-concurrency').trim();\n  const batchSize=val('f-batch').trim();\n  const key=val('f-key').trim();\n  const clear=$('f-clear');\n\n  if(base)patch.baseUrl=base;\n  if(model)patch.model=model;\n  if(concurrency)patch.concurrency=concurrency;\n  if(batchSize)patch.batchSize=batchSize;\n  if(key)patch.apiKey=key;\n  if(clear&&clear.checked)patch.apiKey='__clear__';\n\n  const out=$('api-out');\n  if(!Object.keys(patch).length){\n    if(out)out.textContent='没有改动。';\n    return;\n  }\n\n  try{\n    const config=await call('saveApi',patch);\n    const keyNode=$('f-key');\n    if(keyNode)keyNode.value='';\n    if(clear)clear.checked=false;\n    S.apiFilled=false;\n    fillApiForm(config,true);\n    if(out)out.textContent='已保存到工具链目录的 config.local.json。';\n    notify('接口配置已保存','ok');\n    await refreshStatus(true);\n  }catch(error){\n    if(out)out.textContent='保存失败：'+msgOf(error);\n    notify('保存失败：'+msgOf(error),'err');\n  }\n}\n\nasync function testApi(){\n  const out=$('api-out');\n  if(out)out.textContent='正在发一个小请求测试…';\n  try{\n    const result=await call('testApi');\n    const parts=['接口正常'];\n    if(result&&result.model)parts.push(String(result.model));\n    if(result&&result.ms!==undefined&&result.ms!==null)parts.push(num(result.ms)+' ms');\n    let line=parts.join(' · ');\n    if(result&&result.sample)line+=' · 返回样例：'+String(result.sample);\n    if(out)out.textContent=line;\n    notify('接口连通','ok');\n  }catch(error){\n    if(out)out.textContent='测试失败：'+msgOf(error);\n    notify('测试失败：'+msgOf(error),'err');\n  }\n}\n\n/* ---------------- 模组清单 ---------------- */\n\nasync function loadMods(force){\n  if(S.modsLoading)return;\n  S.modsLoading=true;\n  const body=$('mod-body');\n  if(body&&!S.items.length){\n    body.replaceChildren();\n    const row=document.createElement('tr');\n    const cell=document.createElement('td');\n    cell.className='table-empty';\n    cell.colSpan=6;\n    cell.textContent='正在读取模组清单…';\n    row.append(cell);\n    body.append(row);\n  }\n  try{\n    const data=await call('mods');\n    S.items=Array.isArray(data&&data.items)?data.items:[];\n    S.modsLoaded=true;\n    renderMods();\n  }catch(error){\n    S.modsLoaded=false;\n    if(body){\n      body.replaceChildren();\n      const row=document.createElement('tr');\n      const cell=document.createElement('td');\n      cell.className='table-empty';\n      cell.colSpan=6;\n      cell.textContent='读取模组清单失败：'+msgOf(error);\n      row.append(cell);\n      body.append(row);\n    }\n    notify('读取模组清单失败：'+msgOf(error),'err');\n  }finally{\n    S.modsLoading=false;\n  }\n}\n\nfunction filteredMods(){\n  const query=S.query.trim().toLowerCase();\n  const list=S.items.filter(item=>{\n    if(S.gapOnly&&num(item.gap)<=0)return false;\n    if(query&&String(item.ns||'').toLowerCase().indexOf(query)<0)return false;\n    return true;\n  });\n  const by={\n    gap:(left,right)=>num(right.gap)-num(left.gap)||num(right.en)-num(left.en),\n    pct:(left,right)=>num(left.pct)-num(right.pct)||num(right.gap)-num(left.gap),\n    en:(left,right)=>num(right.en)-num(left.en),\n    ns:(left,right)=>String(left.ns||'').localeCompare(String(right.ns||''),'zh-Hans-CN'),\n  };\n  return list.slice().sort(by[S.sort]||by.gap);\n}\n\nfunction renderMods(){\n  renderChips();\n  const body=$('mod-body');\n  if(!body)return;\n  const list=filteredMods();\n\n  const countText=$('mod-count');\n  if(countText){\n    const gapSum=list.reduce((sum,item)=>sum+num(item.gap),0);\n    countText.textContent=list.length?('显示 '+fmtInt(list.length)+' / '+fmtInt(S.items.length)+' 个命名空间，缺口 '+fmtInt(gapSum)+' 键'):('共 '+fmtInt(S.items.length)+' 个命名空间');\n  }\n\n  body.replaceChildren();\n\n  if(!list.length){\n    const row=document.createElement('tr');\n    const cell=document.createElement('td');\n    cell.className='table-empty';\n    cell.colSpan=6;\n    cell.textContent=S.items.length?'没有符合条件的结果，试试关掉「只看有缺口的」或清空搜索。':'还没有扫描结果。先到「翻译」里点一次「扫描估算」。';\n    row.append(cell);\n    body.append(row);\n    return;\n  }\n\n  for(const item of list){\n    const row=document.createElement('tr');\n    row.dataset.ns=String(item.ns||'');\n\n    const nsCell=document.createElement('td');\n    nsCell.className='ns-cell';\n    const code=document.createElement('span');\n    code.className='ns-name';\n    code.textContent=String(item.ns||'');\n    nsCell.append(code);\n    if(num(item.ai)>0){\n      const badge=document.createElement('span');\n      badge.className='badge';\n      badge.textContent='AI +'+fmtInt(item.ai);\n      nsCell.append(badge);\n    }\n\n    const enCell=cell('num',fmtInt(item.en));\n    const zhCell=cell('num',fmtInt(item.zh));\n    const gapCell=cell('num',fmtInt(item.gap));\n    if(num(item.gap)>0)gapCell.classList.add('bad');\n\n    const pctCell=document.createElement('td');\n    const wrap=document.createElement('div');\n    wrap.className='mini';\n    const track=document.createElement('div');\n    track.className='mini-bar';\n    const fill=document.createElement('i');\n    setBar(fill,num(item.pct));\n    track.append(fill);\n    const label=document.createElement('span');\n    label.className='mini-label';\n    label.textContent=fmtInt(item.pct)+'%';\n    wrap.append(track,label);\n    pctCell.append(wrap);\n\n    const actionCell=document.createElement('td');\n    actionCell.className='action-cell';\n    const button=document.createElement('button');\n    button.type='button';\n    button.className='ghost';\n    button.textContent='预览';\n    button.setAttribute('aria-label','预览模组 '+String(item.ns||''));\n    button.addEventListener('click',event=>{\n      event.stopPropagation();\n      openPreview(String(item.ns||''),button);\n    });\n    actionCell.append(button);\n\n    row.append(nsCell,enCell,zhCell,gapCell,pctCell,actionCell);\n    row.addEventListener('click',()=>openPreview(String(item.ns||''),row));\n    body.append(row);\n  }\n}\n\nfunction cell(className,text){\n  const node=document.createElement('td');\n  if(className)node.className=className;\n  node.textContent=text;\n  return node;\n}\n\nfunction renderChips(){\n  const box=$('mod-chips');\n  if(!box)return;\n  box.replaceChildren();\n  const top=S.items.filter(item=>num(item.gap)>0).slice().sort((left,right)=>num(right.gap)-num(left.gap)).slice(0,6);\n  if(!top.length){\n    box.hidden=true;\n    return;\n  }\n  box.hidden=false;\n  const label=document.createElement('span');\n  label.className='chips-label';\n  label.textContent='缺口最多：';\n  box.append(label);\n  for(const item of top){\n    const button=document.createElement('button');\n    button.type='button';\n    button.className='chip-btn';\n    button.setAttribute('aria-label','预览模组 '+String(item.ns||''));\n    button.append(document.createTextNode(String(item.ns||'')));\n    const badge=document.createElement('span');\n    badge.className='badge';\n    badge.textContent=fmtInt(item.gap);\n    button.append(badge);\n    button.addEventListener('click',()=>openPreview(String(item.ns||''),button));\n    box.append(button);\n  }\n}\n\n/* ---------------- 预览抽屉 ---------------- */\n\nasync function openPreview(ns,trigger){\n  const drawer=$('drawer');\n  if(!drawer||!ns)return;\n  S.drawerNs=ns;\n  S.drawerTrigger=trigger||null;\n  drawer.hidden=false;\n\n  const title=$('drawer-title');\n  if(title)title.textContent=ns;\n  const meta=$('drawer-meta');\n  if(meta)meta.textContent='正在读取语言文件…';\n  const body=$('drawer-body');\n  if(body){\n    body.replaceChildren();\n    const empty=document.createElement('p');\n    empty.className='drawer-empty';\n    empty.textContent='正在读取…';\n    body.append(empty);\n  }\n\n  try{\n    const data=await call('preview',ns);\n    if(S.drawerNs!==ns)return;\n    renderPreview(data);\n  }catch(error){\n    if(meta)meta.textContent='读取失败';\n    if(body){\n      body.replaceChildren();\n      const empty=document.createElement('p');\n      empty.className='drawer-empty';\n      empty.textContent='读取失败：'+msgOf(error);\n      body.append(empty);\n    }\n  }\n\n  const close=$('drawer-close');\n  if(close)close.focus();\n}\n\nfunction renderPreview(data){\n  const meta=$('drawer-meta');\n  const body=$('drawer-body');\n  if(!body)return;\n  const rows=Array.isArray(data&&data.rows)?data.rows:[];\n  const total=num(data&&data.total);\n  const translated=num(data&&data.translated);\n\n  if(meta){\n    let line=fmtInt(translated)+'/'+fmtInt(total)+' 键已有中文';\n    if(data&&data.note)line+=' · '+String(data.note);\n    if(rows.length&&total>rows.length)line+=' · 只显示前 '+rows.length+' 条';\n    meta.textContent=line;\n  }\n\n  body.replaceChildren();\n  if(!rows.length){\n    const empty=document.createElement('p');\n    empty.className='drawer-empty';\n    empty.textContent=(data&&data.note)?String(data.note):'没有可显示的条目。';\n    body.append(empty);\n    return;\n  }\n\n  const list=document.createElement('div');\n  list.className='preview-list';\n  for(const row of rows){\n    const line=document.createElement('div');\n    line.className='preview-row';\n\n    const key=document.createElement('div');\n    key.className='preview-key';\n    key.textContent=String(row.key||'');\n    key.title=String(row.key||'');\n\n    const en=document.createElement('div');\n    en.className='preview-en';\n    en.textContent=String(row.en||'');\n\n    const zh=document.createElement('div');\n    zh.className='preview-zh';\n    if(row.zh){\n      zh.textContent=String(row.zh);\n      if(row.src==='ai'||row.src==='jar'){\n        const tag=document.createElement('span');\n        tag.className='badge tag-'+(row.src==='ai'?'ai':'jar');\n        tag.textContent=row.src==='ai'?'AI':'自带';\n        zh.append(tag);\n      }\n    }else{\n      zh.classList.add('empty');\n      zh.textContent='未译';\n    }\n\n    line.append(key,en,zh);\n    list.append(line);\n  }\n  body.append(list);\n}\n\nfunction closeDrawer(){\n  const drawer=$('drawer');\n  if(drawer)drawer.hidden=true;\n  S.drawerNs='';\n  const trigger=S.drawerTrigger;\n  S.drawerTrigger=null;\n  if(trigger&&document.contains(trigger))trigger.focus();\n}\n\nfunction translateNs(ns){\n  closeDrawer();\n  showView('translate');\n  const kind=$('kind');\n  if(kind)kind.value='mods';\n  const mode=$('mode');\n  if(mode)mode.value='translate';\n  const nsInput=$('ns');\n  if(nsInput)nsInput.value=ns||'';\n  const run=$('run');\n  if(run)run.focus();\n}\n\n/* ---------------- 事件绑定 ---------------- */\n\nfunction bindEvents(){\n  for(const button of navButtons){\n    button.addEventListener('click',()=>showView(button.dataset.view));\n  }\n\n  const noticeClose=$('notice-close');\n  if(noticeClose)noticeClose.addEventListener('click',hideNotice);\n\n  /* 概览 */\n  const packInput=$('pack-input');\n  if(packInput){\n    packInput.addEventListener('input',()=>{S.packDirty=true;});\n    packInput.addEventListener('keydown',event=>{\n      if(event.key==='Enter'){event.preventDefault();applyPack();}\n    });\n  }\n  const packButton=$('pick-pack');\n  if(packButton)packButton.addEventListener('click',pickPack);\n  const applyButton=$('apply-pack');\n  if(applyButton)applyButton.addEventListener('click',applyPack);\n  const openPack=$('open-pack');\n  if(openPack)openPack.addEventListener('click',()=>openTarget('pack'));\n  const pickToolButton=$('pick-tool');\n  if(pickToolButton)pickToolButton.addEventListener('click',pickTool);\n  const openRoot=$('open-root');\n  if(openRoot)openRoot.addEventListener('click',()=>openTarget('root'));\n\n  for(const button of document.querySelectorAll('[data-open]')){\n    button.addEventListener('click',()=>openTarget(button.dataset.open));\n  }\n\n  /* 翻译 */\n  const runButton=$('run');\n  if(runButton)runButton.addEventListener('click',startRun);\n  const stopButton=$('stop');\n  if(stopButton)stopButton.addEventListener('click',stopRun);\n  const clearButton=$('clear-log');\n  if(clearButton)clearButton.addEventListener('click',clearLogs);\n  const log=$('log');\n  if(log){\n    log.addEventListener('scroll',()=>{\n      S.follow=log.scrollHeight-log.scrollTop-log.clientHeight<24;\n    });\n  }\n  for(const id of ['kind','ns','limit','mode']){\n    const node=$(id);\n    if(node)node.addEventListener('keydown',event=>{\n      if(event.key==='Enter'){event.preventDefault();startRun();}\n    });\n  }\n\n  /* 接口 */\n  const saveButton=$('save-config');\n  if(saveButton)saveButton.addEventListener('click',saveApiForm);\n  const testButton=$('test-api');\n  if(testButton)testButton.addEventListener('click',testApi);\n  for(const id of ['f-base','f-model','f-key','f-concurrency','f-batch']){\n    const node=$(id);\n    if(node)node.addEventListener('keydown',event=>{\n      if(event.key==='Enter'){event.preventDefault();saveApiForm();}\n    });\n  }\n\n  /* 模组清单 */\n  const search=$('mod-search');\n  if(search)search.addEventListener('input',()=>{S.query=search.value;renderMods();});\n  const sort=$('mod-sort');\n  if(sort){\n    sort.value=S.sort;\n    sort.addEventListener('change',()=>{S.sort=sort.value;renderMods();});\n  }\n  const gapOnly=$('mod-gap-only');\n  if(gapOnly){\n    gapOnly.checked=S.gapOnly;\n    gapOnly.addEventListener('change',()=>{S.gapOnly=gapOnly.checked;renderMods();});\n  }\n\n  /* 抽屉 */\n  const closeButton=$('drawer-close');\n  if(closeButton)closeButton.addEventListener('click',closeDrawer);\n  const drawerTranslate=$('drawer-translate');\n  if(drawerTranslate)drawerTranslate.addEventListener('click',()=>translateNs(S.drawerNs));\n\n  document.addEventListener('keydown',event=>{\n    if(event.key!=='Escape')return;\n    const drawer=$('drawer');\n    if(drawer&&!drawer.hidden){\n      event.preventDefault();\n      closeDrawer();\n    }\n  });\n}\n\n/* ---------------- 启动 ---------------- */\n\nfunction applyTheme(theme){\n  if(theme==='light'||theme==='dark')document.documentElement.dataset.theme=theme;\n}\n\nasync function startTheme(){\n  try{\n    if(core&&typeof core.onTheme==='function')core.onTheme(applyTheme);\n    if(core&&typeof core.initial==='function'){\n      const info=await core.initial();\n      if(info&&info.theme)applyTheme(info.theme);\n    }\n  }catch(error){\n    /* 主题拿不到就用宿主默认的浅色 */\n  }\n}\n\nfunction startTimers(){\n  clearInterval(S.timerStatus);\n  clearInterval(S.timerLog);\n  S.timerStatus=setInterval(()=>{if(!document.hidden)refreshStatus();},STATUS_MS);\n  S.timerLog=setInterval(()=>{if(!document.hidden)tickLogs();},LOG_MS);\n  document.addEventListener('visibilitychange',()=>{\n    if(document.hidden)return;\n    refreshStatus(true);\n    tickLogs();\n  });\n}\n\nasync function boot(){\n  bindEvents();\n  await startTheme();\n  await refreshStatus(true);\n  await tickLogs();\n  startTimers();\n}\n\nboot();\n","backend/ai.cjs":"// 读取/保存工具链的 config.local.json，并做一次连通性测试。\n// 与 tools/llm.mjs 的字段和优先级保持一致（环境变量 > 文件 > 默认值）。\nconst fs=require('node:fs'),path=require('node:path');\nconst {readText}=require('./paths.cjs');\n\nconst cfgFile=root=>path.join(root,'config.local.json');\n\nconst positive=(...values)=>{\n  for(const value of values){\n    const number=Number(value);\n    if(Number.isFinite(number)&&number>0)return number;\n  }\n  return 0;\n};\n\nfunction loadConfig(root){\n  const file=cfgFile(root);\n  let stored={},fileError='';\n  if(fs.existsSync(file)){\n    try{stored=JSON.parse(readText(file))||{};}catch(error){fileError='config.local.json 不是合法 JSON：'+error.message;stored={};}\n  }\n  if(!stored||typeof stored!=='object')stored={};\n  const cfg={\n    baseUrl:String(process.env.AI_BASE_URL||stored.baseUrl||'https://api.deepseek.com/v1').replace(/\\/+$/,''),\n    model:String(process.env.AI_MODEL||stored.model||'deepseek-chat'),\n    apiKey:String(process.env.AI_API_KEY||stored.apiKey||'').trim(),\n    concurrency:positive(process.env.AI_CONCURRENCY,stored.concurrency,4),\n    batchSize:positive(process.env.AI_BATCH,stored.batchSize,50),\n    temperature:Number.isFinite(Number(stored.temperature))?Number(stored.temperature):0.2,\n    timeoutMs:positive(stored.timeoutMs,120000),\n    jsonMode:stored.jsonMode!==false,\n  };\n  return {cfg,stored,fileError};\n}\n\nfunction safeConfig(root){\n  const {cfg,fileError}=loadConfig(root);\n  return {\n    hasKey:!!cfg.apiKey,\n    keyHint:cfg.apiKey?'••••'+cfg.apiKey.slice(-4):'',\n    baseUrl:cfg.baseUrl,\n    model:cfg.model,\n    concurrency:cfg.concurrency,\n    batchSize:cfg.batchSize,\n    temperature:cfg.temperature,\n    jsonMode:cfg.jsonMode,\n    fromEnv:!!process.env.AI_API_KEY,\n    error:fileError||undefined,\n  };\n}\n\nconst CONFIG_KEYS=['baseUrl','model','apiKey','concurrency','batchSize','temperature','jsonMode'];\n\nfunction saveConfig(root,patch){\n  const file=cfgFile(root);\n  let stored={};\n  if(fs.existsSync(file)){\n    try{stored=JSON.parse(readText(file))||{};}catch(error){throw Error('config.local.json 不是合法 JSON，先修好它：'+error.message);}\n  }\n  if(!stored||typeof stored!=='object')stored={};\n  const next={...stored};\n  for(const key of CONFIG_KEYS){\n    if(!Object.prototype.hasOwnProperty.call(patch,key))continue;\n    const value=patch[key];\n    if(value===undefined||value===null)continue;\n    if(key==='apiKey'){\n      const text=String(value).trim();\n      if(text==='__clear__')delete next.apiKey;\n      else if(text)next.apiKey=text;\n      continue;\n    }\n    if(key==='concurrency'||key==='batchSize'){\n      const number=Math.round(Number(value));\n      if(Number.isFinite(number)&&number>=1)next[key]=Math.min(number,64);\n      continue;\n    }\n    if(key==='temperature'){\n      const number=Number(value);\n      if(Number.isFinite(number))next.temperature=Math.max(0,Math.min(2,number));\n      continue;\n    }\n    if(key==='jsonMode'){next.jsonMode=!!value;continue;}\n    next[key]=String(value).trim();\n  }\n  fs.writeFileSync(file,JSON.stringify(next,null,2)+'\\n','utf8');\n  return safeConfig(root);\n}\n\nasync function testConnection(root){\n  const {cfg,fileError}=loadConfig(root);\n  if(fileError)throw Error(fileError);\n  if(!cfg.apiKey)throw Error('还没配置 API Key。填在下面，或设置环境变量 AI_API_KEY。');\n  const body={\n    model:cfg.model,\n    messages:[\n      {role:'system',content:'你是 Minecraft 模组汉化助手。只输出 JSON 对象，键是英文原文，值是简体中文译文。'},\n      {role:'user',content:'把这两条译成简体中文，返回 JSON 对象：{\"0\":\"Oak Planks\",\"1\":\"Marble Bricks Slab\"}'},\n    ],\n    temperature:cfg.temperature,\n  };\n  if(cfg.jsonMode)body.response_format={type:'json_object'};\n  const started=Date.now();\n  let response;\n  try{\n    response=await fetch(cfg.baseUrl+'/chat/completions',{\n      method:'POST',\n      headers:{'content-type':'application/json',authorization:'Bearer '+cfg.apiKey},\n      body:JSON.stringify(body),\n      signal:AbortSignal.timeout(Math.min(cfg.timeoutMs,60000)),\n    });\n  }catch(error){\n    throw Error('连不上 '+cfg.baseUrl+'：'+(error&&error.message?error.message:String(error)));\n  }\n  const text=await response.text();\n  if(!response.ok)throw Error('HTTP '+response.status+' '+text.slice(0,300));\n  let data;\n  try{data=JSON.parse(text);}catch{throw Error('接口返回的不是 JSON：'+text.slice(0,200));}\n  const content=String(data?.choices?.[0]?.message?.content||'');\n  let sample='';\n  try{\n    const map=JSON.parse(content);\n    sample=String(map['0']||Object.values(map)[0]||'');\n  }catch{sample=content.slice(0,80);}\n  return {ok:true,ms:Date.now()-started,model:cfg.model,sample,usage:data?.usage||null};\n}\n\nmodule.exports={cfgFile,loadConfig,safeConfig,saveConfig,testConnection};\n","backend/index.cjs":"// MC 汉化工作台插件后台：只做「读工具链状态 / 改配置 / 起停流水线」，翻译本身仍由\n// 工具链（tools/pipeline.mjs）完成，插件不重写一份，避免两条实现慢慢跑偏。\nconst fs=require('node:fs'),path=require('node:path');\nconst {spawn}=require('node:child_process');\nconst {readText,readJson,resolvePack}=require('./paths.cjs');\nconst {createSettings,PIPELINE,looksLikeToolRoot}=require('./settings.cjs');\nconst {safeConfig,saveConfig,testConnection,cfgFile}=require('./ai.cjs');\nconst {collectStatus,modsList,preview}=require('./state.cjs');\nconst {Pipeline}=require('./job.cjs');\n\nconst cleanPath=value=>String(value||'').trim();\n\nexports.create=async function create(context){\n  const settings=createSettings(context.dataDir);\n  const logFile=path.join(context.dataDir,'pipeline.log');\n  const job=new Pipeline({getRoot:()=>settings.read().toolRoot,getPack:()=>currentPack(),logFile});\n\n  function currentRoot(){return settings.read().toolRoot;}\n  function currentPack(){\n    const stored=settings.read().packPath;\n    if(stored)return stored;\n    const file=cfgFile(currentRoot());\n    const data=readJson(file,{});\n    const fallback=typeof data.packPath==='string'?data.packPath.trim():'';\n    return fallback;\n  }\n\n  function toolInfo(){\n    const root=currentRoot();\n    return {root,ok:!!root&&looksLikeToolRoot(root)};\n  }\n\n  // 写回工具链的 config.local.json，让命令行入口和插件用同一个整合包；\n  // 只动 packPath，其它字段原样保留，解析失败就跳过（绝不破坏用户配置）。\n  function rememberPack(pack){\n    const root=currentRoot();\n    if(!root)return;\n    const file=cfgFile(root);\n    let stored={};\n    try{\n      if(fs.existsSync(file))stored=JSON.parse(readText(file))||{};\n    }catch{return;}\n    if(!stored||typeof stored!=='object')return;\n    stored.packPath=pack;\n    try{fs.writeFileSync(file,JSON.stringify(stored,null,2)+'\\n','utf8');}catch{}\n  }\n\n  async function pickDirectory(){\n    const root=await context.host('dialog.directory');\n    if(!root)return null;\n    const dir=typeof root==='string'?root:root.path;\n    return cleanPath(dir)||null;\n  }\n\n  function openTarget(target){\n    const root=currentRoot();\n    const pack=currentPack();\n    const targets={\n      root:()=>root,\n      dist:()=>path.join(root,'dist'),\n      work:()=>path.join(root,'work'),\n      data:()=>path.join(root,'data'),\n      pack:()=>pack,\n      resourcepacks:()=>path.join(pack,'resourcepacks'),\n      quests:()=>path.join(pack,'config','ftbquests','quests','lang','zh_cn'),\n    };\n    const resolve=targets[String(target||'')];\n    if(!resolve)throw Error('未知的目录：'+String(target));\n    const dir=resolve();\n    if(!dir||!fs.existsSync(dir))throw Error('目录不存在：'+(dir||'（未设置）'));\n    spawn('explorer',[dir],{detached:true,stdio:'ignore',windowsHide:true}).unref();\n    return {path:dir};\n  }\n\n  function status(){\n    const tool=toolInfo();\n    const pack=currentPack();\n    let config;\n    try{config=safeConfig(tool.root||'');}catch(error){config={hasKey:false,keyHint:'',baseUrl:'',model:'',concurrency:4,batchSize:50,error:error.message};}\n    let snapshot;\n    if(tool.ok){\n      snapshot=collectStatus(tool.root,pack,config);\n    }else{\n      snapshot={tool,pack,ready:false,canWrite:false,scanned:'',stale:false,packver:null,config,mods:null,text:null,totalGap:null,verify:null,cache:0,dist:{rp:null,patch:null},installed:{rp:null,rpName:'',questFiles:0,questOk:false}};\n    }\n    snapshot.tool=tool;\n    snapshot.settings={toolRoot:tool.root,packPath:settings.read().packPath,logFile};\n    snapshot.job=job.snapshot();\n    return snapshot;\n  }\n\n  return {\n    async request(method,args){\n      const options=Array.isArray(args)?args:[];\n      switch(method){\n        case 'status':\n          return status();\n        case 'mods':\n          return modsList(currentRoot(),currentPack());\n        case 'preview':\n          return preview(currentRoot(),currentPack(),options[0]);\n        case 'savePack':{\n          const result=resolvePack(cleanPath(options[0]));\n          if(!result.ok)throw Error(result.error);\n          settings.write({packPath:result.path});\n          rememberPack(result.path);\n          return {ok:true,pack:result.path,note:result.note||''};\n        }\n        case 'pickPack':{\n          const dir=await pickDirectory();\n          if(!dir)return {ok:false,canceled:true};\n          const result=resolvePack(dir);\n          if(!result.ok)throw Error(result.error);\n          settings.write({packPath:result.path});\n          rememberPack(result.path);\n          return {ok:true,pack:result.path,note:result.note||''};\n        }\n        case 'setToolRoot':{\n          const dir=await pickDirectory();\n          if(!dir)return {ok:false,canceled:true};\n          if(!looksLikeToolRoot(dir))throw Error('这个目录里没有 tools/pipeline.mjs，不是汉化工具链：'+dir);\n          settings.write({toolRoot:dir});\n          return {ok:true,tool:{root:dir,ok:true}};\n        }\n        case 'saveApi':{\n          const patch=options[0]&&typeof options[0]==='object'?options[0]:{};\n          const allowed={};\n          for(const key of ['baseUrl','model','apiKey','concurrency','batchSize','temperature','jsonMode']){\n            if(Object.prototype.hasOwnProperty.call(patch,key))allowed[key]=patch[key];\n          }\n          return saveConfig(currentRoot(),allowed);\n        }\n        case 'testApi':\n          return testConnection(currentRoot());\n        case 'run':{\n          const mode=String(options[0]||'translate');\n          if(mode==='translate'){\n            const config=safeConfig(currentRoot());\n            if(!config.hasKey)throw Error('还没配置 API Key。先在「接口」里填 key，或设置环境变量 AI_API_KEY。');\n          }\n          const info=job.start(mode,options[1]||{});\n          return {...info,pack:currentPack()};\n        }\n        case 'stop':\n          return job.stop();\n        case 'logs':\n          return job.logs(options[0]);\n        case 'open':\n          return openTarget(options[0]);\n        default:\n          throw Error('未知的汉化操作：'+String(method));\n      }\n    },\n    async dispose(){\n      job.dispose();\n    },\n  };\n};\n\nmodule.exports.PIPELINE=PIPELINE;\n","backend/job.cjs":"// 流水线子进程：启动 tools/pipeline.mjs、合并两路输出成日志、可停止。\nconst fs=require('node:fs'),path=require('node:path');\nconst {spawn,execFileSync}=require('node:child_process');\nconst {PIPELINE}=require('./settings.cjs');\nconst {NAMESPACE}=require('./paths.cjs');\n\nconst MAX_LINES=2000;\nconst isWindows=process.platform==='win32';\n\nlet cachedNode=null;\nlet probedNode=false;\n\n// 后台跑在 Electron 的 utility process 里，process.execPath 是 electron.exe：\n// 优先找真正的 node.exe，找不到才用 ELECTRON_RUN_AS_NODE 复用 electron 的 node 内核。\nfunction resolveNode(){\n  if(probedNode)return cachedNode;\n  probedNode=true;\n  const candidates=[];\n  if(process.env.MC_HANHUA_NODE)candidates.push(process.env.MC_HANHUA_NODE);\n  if(/node(\\.exe)?$/i.test(path.basename(process.execPath)))candidates.push(process.execPath);\n  if(isWindows){\n    try{\n      const found=execFileSync('where.exe',['node'],{windowsHide:true,encoding:'utf8'});\n      for(const line of String(found).split(/\\r?\\n/)){\n        const file=line.trim();\n        if(file&&/node\\.exe$/i.test(file))candidates.push(file);\n      }\n    }catch{}\n    const programFiles=process.env.ProgramFiles||'C:\\\\Program Files';\n    const programFilesX86=process.env['ProgramFiles(x86)']||'C:\\\\Program Files (x86)';\n    candidates.push(path.join(programFiles,'nodejs','node.exe'));\n    candidates.push(path.join(programFilesX86,'nodejs','node.exe'));\n    if(process.env.LOCALAPPDATA)candidates.push(path.join(process.env.LOCALAPPDATA,'Programs','nodejs','node.exe'));\n  }\n  for(const candidate of candidates){\n    try{\n      if(candidate&&fs.statSync(candidate).isFile()){cachedNode={command:candidate,extraEnv:{}};return cachedNode;}\n    }catch{}\n  }\n  cachedNode={command:process.execPath,extraEnv:{ELECTRON_RUN_AS_NODE:'1'}};\n  return cachedNode;\n}\n\nfunction buildArgs(mode,options){\n  const opts=options||{};\n  if(mode==='dry')return ['--dry'];\n  if(mode==='build')return ['--no-ai'];\n  if(mode!=='translate')throw Error('未知的运行模式：'+String(mode));\n  const args=[];\n  const kind=String(opts.kind||'all');\n  if(kind!=='all'){\n    if(kind!=='mods'&&kind!=='text')throw Error('未知的翻译范围：'+kind);\n    args.push('--kind',kind);\n  }\n  const ns=String(opts.ns||'').trim();\n  if(ns){\n    if(!NAMESPACE.test(ns))throw Error('命名空间不合法：'+ns);\n    args.push('--ns',ns);\n  }\n  const limit=Number(opts.limit);\n  if(Number.isFinite(limit)&&limit>0)args.push('--limit',String(Math.min(Math.round(limit),100000)));\n  return args;\n}\n\nclass Pipeline{\n  constructor({getRoot,getPack,logFile}){\n    this.getRoot=getRoot;\n    this.getPack=getPack;\n    this.logFile=logFile;\n    this.child=null;\n    this.mode='';\n    this.startedAt=0;\n    this.seq=0;\n    this.lines=[];\n    this.lastExit=null;\n    this.lastFinishedAt=0;\n  }\n\n  get running(){return !!this.child;}\n\n  push(text){\n    const line=String(text);\n    if(!line.trim())return;\n    this.seq+=1;\n    this.lines.push({n:this.seq,t:line});\n    if(this.lines.length>MAX_LINES)this.lines.splice(0,this.lines.length-MAX_LINES);\n    if(this.logFile){\n      try{fs.appendFileSync(this.logFile,line+'\\n','utf8');}catch{}\n    }\n  }\n\n  snapshot(){\n    return {\n      running:this.running,\n      mode:this.mode||'',\n      startedAt:this.startedAt||0,\n      elapsed:this.running?Math.round((Date.now()-this.startedAt)/1000):0,\n      lastExit:this.lastExit,\n      lastFinishedAt:this.lastFinishedAt,\n    };\n  }\n\n  logs(since){\n    const from=Number(since)||0;\n    return {\n      seq:this.seq,\n      lines:this.lines.filter(line=>line.n>from),\n      job:this.snapshot(),\n    };\n  }\n\n  start(mode,options){\n    if(this.running)throw Error('已有任务在跑，先停止再启动新的。');\n    const root=this.getRoot();\n    const pipeline=PIPELINE(root);\n    if(!fs.existsSync(pipeline))throw Error('找不到汉化工具链：'+pipeline+'。在「设置」里指定工具链目录。');\n    const pack=this.getPack();\n    if(!pack)throw Error('还没选整合包目录。');\n    const args=buildArgs(mode,options);\n    const node=resolveNode();\n    const env={...process.env,...node.extraEnv,MC_PACK:pack};\n\n    this.lines=[];\n    this.seq=0;\n    if(this.logFile){\n      try{fs.mkdirSync(path.dirname(this.logFile),{recursive:true});fs.writeFileSync(this.logFile,'','utf8');}catch{}\n    }\n    const child=spawn(node.command,[pipeline,...args],{\n      cwd:root,\n      env,\n      windowsHide:true,\n      stdio:['ignore','pipe','pipe'],\n    });\n    this.child=child;\n    this.mode=mode;\n    this.startedAt=Date.now();\n    this.lastExit=null;\n\n    const read=(stream)=>{\n      let buffer='';\n      stream.setEncoding('utf8');\n      stream.on('data',chunk=>{\n        buffer+=chunk;\n        const parts=buffer.split(/\\r\\n|\\n|\\r/);\n        buffer=parts.pop()||'';\n        for(const part of parts){\n          if(part.trim())this.push(part.replace(/\\s+$/,''));\n        }\n      });\n      stream.on('end',()=>{if(buffer.trim())this.push(buffer);buffer='';});\n    };\n    read(child.stdout);\n    read(child.stderr);\n    child.on('error',error=>this.push('[错误] '+(error&&error.message?error.message:String(error))));\n    child.on('close',code=>{\n      this.child=null;\n      this.lastExit=typeof code==='number'?code:-1;\n      this.lastFinishedAt=Date.now();\n      this.push(code===0?'[完成] 流水线正常结束':'[结束] 退出码 '+String(code));\n    });\n\n    return {started:true,mode,args,node:node.command};\n  }\n\n  stop(){\n    if(!this.child)return {stopped:false};\n    const pid=this.child.pid;\n    this.push('[已请求停止]');\n    if(isWindows){\n      try{spawn('taskkill',['/F','/T','/PID',String(pid)],{windowsHide:true,stdio:'ignore'});}catch{}\n    }\n    try{this.child.kill('SIGKILL');}catch{}\n    return {stopped:true};\n  }\n\n  dispose(){\n    if(!this.child)return;\n    const pid=this.child.pid;\n    if(isWindows){\n      try{spawn('taskkill',['/F','/T','/PID',String(pid)],{windowsHide:true,stdio:'ignore'});}catch{}\n    }\n    try{this.child.kill('SIGKILL');}catch{}\n    this.child=null;\n  }\n}\n\nmodule.exports={Pipeline,resolveNode,buildArgs,MAX_LINES};\n","backend/loose.cjs":"// 容错 JSON 解析（JSON5 子集）：去 BOM、去字符串外注释与尾逗号、处理单引号与裸换行。\n// 逻辑与汉化工具链 tools/lib.mjs 的 parseLoose 保持一致，模组语言文件才能同样解析。\nfunction parseLoose(text){\n  if(text.charCodeAt(0)===0xfeff)text=text.slice(1);\n  let stage='';\n  for(let i=0;i<text.length;i+=1){\n    const c=text[i];\n    if(c==='\"'||c===\"'\"){\n      const quote=c;\n      let j=i+1,buf='';\n      while(j<text.length){\n        const d=text[j];\n        if(d==='\\\\'){\n          const n=text[j+1]??'';\n          if(n===\"'\"){buf+=\"'\";j+=2;continue;}\n          if(n==='\"'&&quote===\"'\"){buf+='\\\\\"';j+=2;continue;}\n          buf+=d+n;j+=2;continue;\n        }\n        if(d===quote)break;\n        if(d==='\"'&&quote===\"'\"){buf+='\\\\\"';j+=1;continue;}\n        if(d==='\\n'||d==='\\r'||d==='\\t'||d.charCodeAt(0)<0x20){buf+=JSON.stringify(d).slice(1,-1);j+=1;continue;}\n        buf+=d;j+=1;\n      }\n      stage+='\"'+buf+'\"';i=j;continue;\n    }\n    if(c==='/'&&text[i+1]==='/'){while(i<text.length&&text[i]!=='\\n')i+=1;stage+='\\n';continue;}\n    if(c==='/'&&text[i+1]==='*'){const k=text.indexOf('*/',i+2);i=k<0?text.length:k+1;continue;}\n    stage+=c;\n  }\n  let out='',inStr=false,lastSig='';\n  for(let i=0;i<stage.length;i+=1){\n    const c=stage[i];\n    if(inStr){\n      out+=c;\n      if(c==='\\\\'){out+=stage[++i]??'';continue;}\n      if(c==='\"'){inStr=false;lastSig='\"';}\n      continue;\n    }\n    if(c==='\"'){\n      if(lastSig==='\"'||lastSig==='}'||lastSig===']'||/[0-9a-zA-Z]/.test(lastSig))out+=',';\n      inStr=true;out+=c;continue;\n    }\n    if(c===','){\n      let j=i+1;\n      while(j<stage.length&&/\\s/.test(stage[j]))j+=1;\n      if(stage[j]==='}'||stage[j]===']')continue;\n    }\n    if(!/\\s/.test(c))lastSig=c;\n    out+=c;\n  }\n  if(!out.trim())return {};\n  return JSON.parse(out);\n}\n\nmodule.exports={parseLoose};\n","backend/paths.cjs":"// 整合包路径规则：产物文件名、模组译文文件、已装资源包定位、目录纠正。\n// 与汉化工具链 tools/lib.mjs、tools/build.mjs、tools/pack.mjs 的规则保持一致。\nconst fs=require('node:fs'),path=require('node:path');\n\nconst readText=file=>fs.readFileSync(file,'utf8').replace(/^\\uFEFF/,'');\nconst readJson=(file,fallback)=>{try{return JSON.parse(readText(file));}catch{return fallback;}};\n// 命名空间会拼进文件路径与命令行参数，只认字母数字开头的那一小撮字符。\nconst NAMESPACE=/^[a-z0-9][a-z0-9_.-]{0,63}$/i;\nconst stat=file=>{try{const info=fs.statSync(file);return {size:info.size,mtime:info.mtime.toISOString()};}catch{return null;}};\nconst ensureDir=dir=>fs.mkdirSync(dir,{recursive:true});\n\nfunction packTag(pack){return path.basename(String(pack||'')).replace(/[\\\\/:*?\"<>|]/g,'').replace(/\\s+/g,'-');}\nconst rpName=pack=>packTag(pack)+'-zh_cn-resourcepack.zip';\nconst patchName=pack=>packTag(pack)+'-zh_cn-patch.zip';\nconst modsZhFile=(work,pack)=>path.join(work,'zh-mods',packTag(pack)+'.json');\n\nfunction findInstalledRp(pack){\n  const dir=path.join(pack,'resourcepacks');\n  let list=[];\n  try{list=fs.readdirSync(dir);}catch{return null;}\n  const mine=rpName(pack);\n  if(list.includes(mine))return path.join(dir,mine);\n  const any=list.filter(file=>/-zh_cn-resourcepack\\.zip$/i.test(file)).sort().pop();\n  return any?path.join(dir,any):null;\n}\n\nfunction resolvePack(input){\n  const clean=String(input||'').trim().replace(/^\"+|\"+$/g,'').replace(/[\\\\/]+$/,'');\n  if(!clean)return {ok:false,error:'路径是空的'};\n  let info;\n  try{info=fs.statSync(clean);}catch{return {ok:false,error:'这个路径不存在：'+clean};}\n  if(!info.isDirectory())return {ok:false,error:'这不是文件夹：'+clean};\n  const has=name=>fs.existsSync(path.join(clean,name));\n  const tooMany=found=>'这个目录下有多个整合包：'+found.slice(0,6).map(item=>path.basename(item)).join(' / ')+(found.length>6?' 等':'')+'，请选具体那一个版本文件夹';\n  if(has('versions')){\n    const base=path.join(clean,'versions'),found=[];\n    try{for(const entry of fs.readdirSync(base,{withFileTypes:true})){if(!entry.isDirectory())continue;const dir=path.join(base,entry.name);if(fs.existsSync(path.join(dir,'mods')))found.push(dir);}}catch{}\n    if(found.length===1)return {ok:true,path:found[0],note:'你选的是上层目录，已自动定位到版本文件夹：'+path.basename(found[0])};\n    if(found.length>1)return {ok:false,error:tooMany(found)};\n  }\n  if(has('mods'))return {ok:true,path:clean,note:has('config')?'':'没有 config 目录，任务书/KubeJS 层会跳过（模组层照常）'};\n  const found=[];\n  for(const base of [path.join(clean,'versions'),clean]){\n    if(!fs.existsSync(base))continue;\n    let entries=[];\n    try{entries=fs.readdirSync(base,{withFileTypes:true});}catch{continue;}\n    for(const entry of entries){if(!entry.isDirectory())continue;const dir=path.join(base,entry.name);if(fs.existsSync(path.join(dir,'mods')))found.push(dir);}\n    if(found.length)break;\n  }\n  if(found.length===1)return {ok:true,path:found[0],note:'你选的是上层目录，已自动定位到版本文件夹：'+path.basename(found[0])};\n  if(found.length>1)return {ok:false,error:tooMany(found)};\n  return {ok:false,error:'里面没有 mods 目录，不像整合包版本文件夹：'+clean};\n}\n\nmodule.exports={readText,readJson,stat,ensureDir,NAMESPACE,packTag,rpName,patchName,modsZhFile,findInstalledRp,resolvePack};\n","backend/settings.cjs":"// 工具链位置与插件设置（存插件自己的 dataDir，不污染工具链目录）。\nconst fs=require('node:fs'),path=require('node:path');\nconst {readText}=require('./paths.cjs');\n\nconst PIPELINE=root=>path.join(root,'tools','pipeline.mjs');\n\nfunction looksLikeToolRoot(root){\n  try{return fs.statSync(PIPELINE(root)).isFile();}catch{return false;}\n}\n\nfunction defaultToolRoot(){\n  const candidates=[\n    process.env.MC_HANHUA_ROOT,\n    'F:\\\\Deepseek\\\\mc-hanhua',\n    path.join(process.env.USERPROFILE||'', 'mc-hanhua'),\n  ].filter(Boolean);\n  for(const root of candidates){if(looksLikeToolRoot(root))return root;}\n  return candidates[1]||'';\n}\n\nfunction createSettings(dataDir){\n  const file=path.join(dataDir,'settings.json');\n  function read(){\n    let raw={};\n    try{raw=JSON.parse(readText(file));}catch{raw={};}\n    if(!raw||typeof raw!=='object')raw={};\n    const toolRoot=typeof raw.toolRoot==='string'&&raw.toolRoot.trim()?raw.toolRoot.trim():defaultToolRoot();\n    const packPath=typeof raw.packPath==='string'?raw.packPath.trim():'';\n    const nodePath=typeof raw.nodePath==='string'?raw.nodePath.trim():'';\n    return {toolRoot,packPath,nodePath};\n  }\n  function write(patch){\n    const next={...read(),...patch};\n    fs.mkdirSync(dataDir,{recursive:true});\n    fs.writeFileSync(file,JSON.stringify(next,null,2),'utf8');\n    return next;\n  }\n  return {file,read,write};\n}\n\nmodule.exports={PIPELINE,looksLikeToolRoot,defaultToolRoot,createSettings};\n","backend/state.cjs":"// 汇总工作台要显示的一切：整合包校验、覆盖率、缺口、产物、已装状态、缓存行数。\n// 数据源都是工具链的 work/*.json 与 dist/*.zip，不自己算翻译。\nconst fs=require('node:fs'),path=require('node:path');\nconst {readText,readJson,stat,modsZhFile,findInstalledRp,rpName,patchName,NAMESPACE}=require('./paths.cjs');\nconst {parseLoose}=require('./loose.cjs');\n\nconst lineCache=new Map();\n\nfunction countLines(file){\n  const info=stat(file);\n  if(!info)return 0;\n  const hit=lineCache.get(file);\n  if(hit&&hit.size===info.size&&hit.mtime===info.mtime)return hit.lines;\n  let lines=0;\n  try{\n    for(const line of readText(file).split('\\n'))if(line.trim())lines+=1;\n  }catch{return 0;}\n  lineCache.set(file,{size:info.size,mtime:info.mtime,lines});\n  return lines;\n}\n\nfunction canWriteInto(dir){\n  if(!dir)return false;\n  const probe=path.join(dir,'.wb-write-probe');\n  try{fs.writeFileSync(probe,'','utf8');fs.unlinkSync(probe);return true;}catch{return false;}\n}\n\nfunction countQuestFiles(pack){\n  const base=path.join(pack,'config','ftbquests','quests','lang');\n  let count=0;\n  const walk=dir=>{\n    let entries=[];\n    try{entries=fs.readdirSync(dir,{withFileTypes:true});}catch{return;}\n    for(const entry of entries){\n      const full=path.join(dir,entry.name);\n      if(entry.isDirectory())walk(full);\n      else if(/\\.(json|json5|snbt)$/i.test(entry.name))count+=1;\n    }\n  };\n  walk(path.join(base,'zh_cn'));\n  if(fs.existsSync(path.join(base,'zh_cn.snbt')))count+=1;\n  return count;\n}\n\nfunction modsZh(root,pack){\n  const data=readJson(modsZhFile(path.join(root,'work'),pack),{});\n  return data&&typeof data==='object'?data:{};\n}\n\nfunction sumKeys(map){\n  let total=0;\n  for(const value of Object.values(map||{})){\n    if(value&&typeof value==='object')total+=Object.keys(value).length;\n  }\n  return total;\n}\n\nfunction collectStatus(root,pack,config){\n  const work=path.join(root,'work');\n  const dist=path.join(root,'dist');\n  const toolOk=!!root&&fs.existsSync(path.join(root,'tools','pipeline.mjs'));\n  const modstats=readJson(path.join(work,'modstats.json'),null);\n  const verify=readJson(path.join(work,'verify.json'),null);\n  const gap=readJson(path.join(work,'gap.json'),null);\n  const packver=readJson(path.join(work,'packver.json'),null);\n  const aiMods=modsZh(root,pack);\n  const aiModKeys=sumKeys(aiMods);\n\n  let scanned='';\n  try{scanned=readText(path.join(work,'packpath.txt')).trim();}catch{}\n\n  const ready=!!pack&&fs.existsSync(path.join(pack,'mods'));\n  const stale=!!(scanned&&pack&&path.resolve(scanned).toLowerCase()!==path.resolve(pack).toLowerCase());\n\n  let mods=null;\n  if(modstats&&Number.isFinite(Number(modstats.totalEn))){\n    const en=Number(modstats.totalEn)||0;\n    const zh=Math.min(en,(Number(modstats.alreadyZh)||0)+aiModKeys);\n    const missing=Math.max(0,(Number(modstats.gap)||0)-aiModKeys);\n    mods={namespaces:Number(modstats.namespaces)||0,en,zh,gap:missing,pct:en?Math.round(zh/en*1000)/10:0,aiTranslated:aiModKeys};\n  }\n\n  let text=null;\n  if(gap&&gap.surfaces){\n    const quests=gap.surfaces.quests||{};\n    const kubejs=gap.surfaces.kubejs||{};\n    text={\n      quests:{units:Number(quests.units)||0,done:Number(quests.done)||0,pct:quests.pct||''},\n      kubejs:{units:Number(kubejs.units)||0,done:Number(kubejs.done)||0,pct:kubejs.pct||''},\n      manuals:gap.guides||null,\n    };\n  }\n\n  let verifyInfo=null;\n  if(verify){\n    const errors=Array.isArray(verify.errors)?verify.errors:[];\n    const warns=Array.isArray(verify.warns)?verify.warns:[];\n    verifyInfo={\n      files:Number(verify.files)||0,\n      keys:Number(verify.keys)||0,\n      total:Number(verify.total)||0,\n      translated:Number(verify.translated)||0,\n      coverage:verify.coverage||'',\n      errors:errors.length,\n      warns:warns.length,\n      errorList:errors.slice(0,20),\n    };\n  }\n\n  const installedPath=ready?findInstalledRp(pack):null;\n  const questFiles=ready?countQuestFiles(pack):0;\n\n  return {\n    tool:{root:root||'',ok:toolOk},\n    pack:pack||'',\n    ready,\n    canWrite:ready?canWriteInto(pack):false,\n    scanned,\n    stale,\n    packver:packver||null,\n    config:config||null,\n    mods,\n    text,\n    totalGap:gap&&Number.isFinite(Number(gap.totalMissingKeys))?Number(gap.totalMissingKeys):null,\n    verify:verifyInfo,\n    cache:countLines(path.join(work,'tm.jsonl')),\n    dist:{\n      rp:stat(path.join(dist,rpName(pack||''))),\n      patch:stat(path.join(dist,patchName(pack||''))),\n    },\n    installed:{\n      rp:installedPath?stat(installedPath):null,\n      rpName:installedPath?path.basename(installedPath):'',\n      questFiles,\n      questOk:questFiles>0,\n    },\n  };\n}\n\nfunction modsList(root,pack){\n  const modstats=readJson(path.join(root,'work','modstats.json'),null);\n  const perNs=(modstats&&modstats.perNs)||{};\n  const aiMods=modsZh(root,pack);\n  const items=Object.entries(perNs).map(([ns,value])=>{\n    const en=Number(value&&value.en)||0;\n    const ai=Math.min(value&&aiMods[ns]&&typeof aiMods[ns]==='object'?Object.keys(aiMods[ns]).length:0,en);\n    const jarZh=Number(value&&value.zh)||0;\n    const zh=Math.min(en,jarZh+ai);\n    const missing=Math.max(0,(Number(value&&value.gap)||0)-ai);\n    return {ns,en,zh,ai,jarZh,gap:missing,pct:en?Math.round(zh/en*100):100};\n  });\n  items.sort((left,right)=>right.gap-left.gap||right.en-left.en);\n  return {items};\n}\n\nfunction readLang(file){\n  try{\n    return {data:parseLoose(readText(file)),error:''};\n  }catch(error){\n    return {data:null,error:error&&error.message?error.message:String(error)};\n  }\n}\n\nfunction preview(root,pack,ns){\n  const name=String(ns||'').trim();\n  if(!NAMESPACE.test(name))throw Error('命名空间不合法：'+name);\n  const assets=path.join(root,'work','jars','assets');\n  let enFile=path.join(assets,name+'.en_us.json');\n  if(!fs.existsSync(enFile))enFile=path.join(assets,name+'.en_US.json');\n  if(!fs.existsSync(enFile)){\n    // assets 整个空掉是常见状态（换过包、清理过 work），这时给的是「先扫描」而不是「没这个模组」。\n    let emptyAssets=false;\n    try{emptyAssets=fs.readdirSync(assets).length===0;}catch{emptyAssets=true;}\n    return {ns:name,rows:[],total:0,translated:0,note:emptyAssets?'还没解出语言文件：先跑一次「只估算」或「开始」，会在 work/jars/assets 里生成':'没有这个命名空间的英文语言文件'};\n  }\n\n  const en=readLang(enFile);\n  if(!en.data)return {ns:name,rows:[],total:0,translated:0,note:'语言文件解析失败：'+en.error};\n  let jarZh={};\n  const zhFile=path.join(assets,name+'.zh_cn.json');\n  if(fs.existsSync(zhFile)){\n    const parsed=readLang(zhFile);\n    if(parsed.data&&typeof parsed.data==='object')jarZh=parsed.data;\n  }\n  const aiMods=modsZh(root,pack);\n  const ai=(aiMods[name]&&typeof aiMods[name]==='object')?aiMods[name]:{};\n  const keys=Object.keys(en.data);\n  const rows=[];\n  for(const key of keys.slice(0,300)){\n    const source=String(en.data[key]??'');\n    const mine=typeof ai[key]==='string'?ai[key]:'';\n    const built=typeof jarZh[key]==='string'?jarZh[key]:'';\n    rows.push({key,en:source,zh:mine||built||'',src:mine?'ai':(built?'jar':'')});\n  }\n  return {ns:name,rows,total:keys.length,translated:rows.filter(row=>row.zh).length};\n}\n\nmodule.exports={collectStatus,modsList,preview,countLines,sumKeys,modsZh};\n","index.html":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>MC 汉化</title>\n<link rel=\"stylesheet\" href=\"tokens.css\">\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n<svg class=\"icon-sprite\" aria-hidden=\"true\" focusable=\"false\">\n <symbol id=\"i-overview\" viewBox=\"0 0 24 24\"><rect x=\"3.5\" y=\"3.5\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"13.5\" y=\"3.5\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"3.5\" y=\"13.5\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"13.5\" y=\"13.5\" width=\"7\" height=\"7\" rx=\"1.5\"/></symbol>\n <symbol id=\"i-translate\" viewBox=\"0 0 24 24\"><path d=\"M3 5h8M7 5v2c0 4-2 6.5-4.5 8M5 10c1.2 3 3.6 5 6.5 6\"/><path d=\"M13 20l4.5-11L22 20M14.6 16h5.8\"/></symbol>\n <symbol id=\"i-api\" viewBox=\"0 0 24 24\"><path d=\"M9 3v6M15 3v6M7 9h10v2a5 5 0 0 1-10 0zM12 16v5\"/></symbol>\n <symbol id=\"i-mods\" viewBox=\"0 0 24 24\"><path d=\"M12 3l8 4.5v9L12 21l-8-4.5v-9zM4 7.5l8 4.5 8-4.5M12 12v9\"/></symbol>\n</svg>\n\n<aside class=\"sidebar\">\n <div class=\"brand\">\n  <span class=\"brand-mark\" aria-hidden=\"true\">汉</span>\n  <div class=\"brand-text\"><strong>MC 汉化</strong><small>模组与任务书</small></div>\n </div>\n <nav class=\"nav\" aria-label=\"主导航\">\n  <button type=\"button\" data-view=\"overview\" class=\"selected\" aria-current=\"page\" aria-label=\"概览\"><svg class=\"icon\" aria-hidden=\"true\"><use href=\"#i-overview\"></use></svg><span>概览</span></button>\n  <button type=\"button\" data-view=\"translate\" aria-label=\"翻译\"><svg class=\"icon\" aria-hidden=\"true\"><use href=\"#i-translate\"></use></svg><span>翻译</span></button>\n  <button type=\"button\" data-view=\"api\" aria-label=\"接口\"><svg class=\"icon\" aria-hidden=\"true\"><use href=\"#i-api\"></use></svg><span>接口</span></button>\n  <button type=\"button\" data-view=\"mods\" aria-label=\"模组清单\"><svg class=\"icon\" aria-hidden=\"true\"><use href=\"#i-mods\"></use></svg><span>模组清单</span></button>\n </nav>\n <div class=\"side-foot\">\n  <span class=\"dot\" aria-hidden=\"true\" id=\"tool-dot\"></span>\n  <span id=\"tool-state\">正在读取工具链</span>\n </div>\n</aside>\n\n<main>\n <header class=\"topbar\">\n  <div class=\"pack\">\n   <h1 id=\"pack-name\">正在读取整合包</h1>\n   <p class=\"pack-path\" id=\"pack-path\">正在读取整合包信息</p>\n  </div>\n  <div class=\"topbar-status\">\n   <span class=\"chip\" id=\"api-chip\"><span class=\"dot\" aria-hidden=\"true\"></span><span id=\"api-chip-text\">接口未配置</span></span>\n   <span class=\"chip\" id=\"job-chip\"><span class=\"dot\" aria-hidden=\"true\"></span><span id=\"job-chip-text\">空闲</span></span>\n  </div>\n </header>\n\n <div class=\"notice\" id=\"notice\" role=\"status\" aria-live=\"polite\" hidden>\n  <p id=\"notice-text\"></p>\n  <button type=\"button\" id=\"notice-close\" aria-label=\"关闭提示\">关闭</button>\n </div>\n\n <div class=\"views\" id=\"views\">\n\n  <section class=\"view\" id=\"view-overview\" data-view=\"overview\" aria-label=\"概览\">\n   <div class=\"flags\" id=\"flags\" hidden></div>\n\n   <section class=\"card\">\n    <h2 class=\"card-title\">整合包目录</h2>\n    <div class=\"path-row\">\n     <input class=\"path-input\" id=\"pack-input\" type=\"text\" spellcheck=\"false\" autocomplete=\"off\" aria-label=\"整合包版本文件夹路径\" placeholder=\"粘贴版本文件夹路径，回车生效\">\n     <div class=\"btn-row\">\n      <button type=\"button\" id=\"pick-pack\" aria-label=\"选择整合包文件夹\">选择文件夹</button>\n      <button type=\"button\" id=\"apply-pack\" class=\"primary\" aria-label=\"应用整合包路径\">应用路径</button>\n      <button type=\"button\" id=\"open-pack\" aria-label=\"打开整合包目录\">打开目录</button>\n     </div>\n    </div>\n    <p class=\"hint\" id=\"pack-hint\">这个文件夹里要有 mods 和 config，也就是 Minecraft 的版本文件夹。</p>\n   </section>\n\n   <section class=\"card\">\n    <h2 class=\"card-title\">汉化工具链目录</h2>\n    <div class=\"path-row\">\n     <input class=\"path-input\" id=\"tool-input\" type=\"text\" readonly aria-label=\"汉化工具链目录\">\n     <div class=\"btn-row\">\n      <button type=\"button\" id=\"pick-tool\" aria-label=\"选择汉化工具链目录\">选择工具链目录</button>\n      <button type=\"button\" id=\"open-root\" aria-label=\"打开工具链目录\">打开</button>\n     </div>\n    </div>\n    <p class=\"hint\" id=\"tool-hint\">目录里要有 tools/pipeline.mjs。</p>\n   </section>\n\n   <div class=\"stats\">\n    <article class=\"card stat\">\n     <h3 class=\"stat-label\">模组键覆盖率</h3>\n     <p class=\"stat-value\" id=\"stat-pct\">—</p>\n     <div class=\"bar\" id=\"stat-pct-bar\" role=\"progressbar\" aria-label=\"模组键覆盖率\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"0\"><i id=\"bar-pct\"></i></div>\n     <p class=\"stat-note\" id=\"stat-pct-note\">尚未扫描</p>\n    </article>\n    <article class=\"card stat\">\n     <h3 class=\"stat-label\">模组缺口</h3>\n     <p class=\"stat-value\" id=\"stat-gap\">—</p>\n     <p class=\"stat-note\" id=\"stat-gap-note\">尚未扫描</p>\n    </article>\n    <article class=\"card stat\">\n     <h3 class=\"stat-label\">文本完成度</h3>\n     <p class=\"stat-value\" id=\"stat-text\">—</p>\n     <p class=\"stat-note\" id=\"stat-text-note\">尚未扫描</p>\n    </article>\n    <article class=\"card stat\">\n     <h3 class=\"stat-label\">校验覆盖率</h3>\n     <p class=\"stat-value\" id=\"stat-verify\">—</p>\n     <p class=\"stat-note\" id=\"stat-verify-note\">尚未扫描</p>\n    </article>\n   </div>\n\n   <section class=\"card\">\n    <h2 class=\"card-title\">产物与缓存</h2>\n    <dl class=\"kv\">\n     <dt>已装资源包</dt><dd id=\"art-rp\">—</dd>\n     <dt>任务书中文文件</dt><dd id=\"art-quest\">—</dd>\n     <dt>翻译缓存（命中不花钱）</dt><dd id=\"art-cache\">—</dd>\n     <dt>缺口合计（键 + 单元）</dt><dd id=\"art-gap\">—</dd>\n    </dl>\n    <p class=\"hint\" id=\"game-hint\">进游戏后在资源包列表最上面启用中文资源包。</p>\n   </section>\n\n   <section class=\"card\">\n    <h2 class=\"card-title\">目录</h2>\n    <div class=\"btn-row\">\n     <button type=\"button\" data-open=\"dist\" aria-label=\"打开 dist 目录\">打开 dist</button>\n     <button type=\"button\" data-open=\"work\" aria-label=\"打开 work 目录\">打开 work</button>\n     <button type=\"button\" data-open=\"data\" aria-label=\"打开 data 目录\">打开 data</button>\n     <button type=\"button\" data-open=\"resourcepacks\" aria-label=\"打开 resourcepacks 目录\">打开 resourcepacks</button>\n     <button type=\"button\" data-open=\"quests\" aria-label=\"打开任务书中文目录\">打开任务书 zh_cn</button>\n    </div>\n   </section>\n  </section>\n\n  <section class=\"view\" id=\"view-translate\" data-view=\"translate\" aria-label=\"翻译\" hidden>\n   <section class=\"card\">\n    <div class=\"controls\" id=\"run-form\">\n     <label class=\"field\"><span>运行方式</span>\n      <select id=\"mode\">\n       <option value=\"translate\">AI 翻译</option>\n       <option value=\"dry\">只估算</option>\n       <option value=\"build\">只打包回写</option>\n      </select>\n     </label>\n     <label class=\"field\"><span>范围</span>\n      <select id=\"kind\">\n       <option value=\"all\">全部</option>\n       <option value=\"mods\">只要模组</option>\n       <option value=\"text\">只要任务书 KubeJS</option>\n      </select>\n     </label>\n     <label class=\"field\"><span>命名空间</span><input id=\"ns\" type=\"text\" spellcheck=\"false\" autocomplete=\"off\" placeholder=\"可空，例如 chisel\"></label>\n     <label class=\"field narrow\"><span>本次最多翻</span><input id=\"limit\" type=\"number\" min=\"0\" step=\"50\" placeholder=\"不限\"></label>\n     <div class=\"btn-row actions\">\n      <button type=\"button\" id=\"run\" class=\"primary\" aria-label=\"按上面选项开始运行流水线\">开始</button>\n      <button type=\"button\" id=\"stop\" class=\"danger\" disabled aria-label=\"停止当前任务\">停止</button>\n     </div>\n    </div>\n    <p class=\"hint\" id=\"run-hint\">「只估算」不调接口、不花钱，用来看规模；「只打包回写」不发请求，把已有译文打包安装。</p>\n   </section>\n\n   <div class=\"progress-row\">\n    <div class=\"bar\" id=\"job-bar-wrap\" role=\"progressbar\" aria-label=\"任务进度\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"0\"><i id=\"job-bar\"></i></div>\n    <p class=\"progress-text\" id=\"progress-text\" aria-live=\"polite\">空闲</p>\n   </div>\n\n   <div class=\"log-wrap\">\n    <div class=\"log\" id=\"log\" role=\"log\" aria-label=\"任务日志\" tabindex=\"0\"><p class=\"log-empty\">日志会出现在这里。先点「只估算」看规模，不发请求、不花钱。</p></div>\n   </div>\n\n   <div class=\"btn-row\">\n    <button type=\"button\" id=\"clear-log\" aria-label=\"清空日志面板\">清空日志</button>\n    <button type=\"button\" data-open=\"dist\" aria-label=\"打开 dist 目录\">打开 dist</button>\n    <button type=\"button\" data-open=\"resourcepacks\" aria-label=\"打开 resourcepacks 目录\">打开 resourcepacks</button>\n    <button type=\"button\" data-open=\"quests\" aria-label=\"打开任务书中文目录\">打开任务书 zh_cn</button>\n   </div>\n  </section>\n\n  <section class=\"view\" id=\"view-api\" data-view=\"api\" aria-label=\"接口设置\" hidden>\n   <div class=\"api-grid\">\n    <section class=\"card\">\n     <h2 class=\"card-title\">OpenAI 兼容接口</h2>\n     <div class=\"form-stack\">\n      <label class=\"field\"><span>Base URL</span><input id=\"f-base\" type=\"text\" spellcheck=\"false\" autocomplete=\"off\" placeholder=\"接口地址，要带协议前缀\"></label>\n      <label class=\"field\"><span>模型</span><input id=\"f-model\" type=\"text\" spellcheck=\"false\" autocomplete=\"off\" placeholder=\"例如 deepseek-chat\"></label>\n      <label class=\"field\"><span>API Key</span><input id=\"f-key\" type=\"password\" autocomplete=\"off\" placeholder=\"粘贴 API Key\"></label>\n      <label class=\"check-row\" id=\"key-clear-row\" hidden><input type=\"checkbox\" id=\"f-clear\"><span>清除已保存的 Key</span></label>\n      <div class=\"field-row\">\n       <label class=\"field\"><span>并发</span><input id=\"f-concurrency\" type=\"number\" min=\"1\" max=\"64\" step=\"1\" placeholder=\"4\"></label>\n       <label class=\"field\"><span>每批条数</span><input id=\"f-batch\" type=\"number\" min=\"1\" max=\"2000\" step=\"10\" placeholder=\"50\"></label>\n      </div>\n      <div class=\"btn-row\">\n       <button type=\"button\" id=\"save-config\" class=\"primary\" aria-label=\"保存接口配置\">保存</button>\n       <button type=\"button\" id=\"test-api\" aria-label=\"测试接口连通性\">测试接口</button>\n      </div>\n      <p class=\"hint\" id=\"api-out\" role=\"status\" aria-live=\"polite\"></p>\n     </div>\n    </section>\n    <section class=\"card\">\n     <h2 class=\"card-title\">当前状态</h2>\n     <dl class=\"kv\">\n      <dt>接口</dt><dd id=\"cfg-api-state\">—</dd>\n      <dt>当前模型</dt><dd id=\"cfg-model\">—</dd>\n      <dt>并发 / 每批</dt><dd id=\"cfg-nums\">—</dd>\n      <dt>配置文件</dt><dd id=\"cfg-file\">—</dd>\n     </dl>\n     <p class=\"hint\">Key 只存在本机工具链目录的 config.local.json，不写进工作台数据目录，页面也不回显。并发 4–16、每批 30–80 最稳；填太大会大量重试反而更慢。</p>\n    </section>\n   </div>\n  </section>\n\n  <section class=\"view\" id=\"view-mods\" data-view=\"mods\" aria-label=\"模组清单\" hidden>\n   <div class=\"toolbar\">\n    <label class=\"field grow\"><span>搜索命名空间</span><input id=\"mod-search\" type=\"search\" spellcheck=\"false\" placeholder=\"例如 chisel / ae2 / create\"></label>\n    <label class=\"field\"><span>排序</span>\n     <select id=\"mod-sort\">\n      <option value=\"gap\">缺口大 → 小</option>\n      <option value=\"pct\">覆盖率低 → 高</option>\n      <option value=\"en\">键数多 → 少</option>\n      <option value=\"ns\">按名称</option>\n     </select>\n    </label>\n    <label class=\"switch\"><input type=\"checkbox\" id=\"mod-gap-only\" checked><span>只看有缺口的</span></label>\n    <span class=\"count\" id=\"mod-count\"></span>\n   </div>\n\n   <div class=\"chips-row\" id=\"mod-chips\" aria-label=\"缺口最多的模组\"></div>\n\n   <div class=\"table-wrap\">\n    <table class=\"mods\">\n     <thead>\n      <tr>\n       <th scope=\"col\">命名空间</th>\n       <th scope=\"col\" class=\"num\">键数</th>\n       <th scope=\"col\" class=\"num\">已有中文</th>\n       <th scope=\"col\" class=\"num\">缺口</th>\n       <th scope=\"col\">覆盖率</th>\n       <th scope=\"col\"><span class=\"sr-only\">操作</span></th>\n      </tr>\n     </thead>\n     <tbody id=\"mod-body\">\n      <tr><td class=\"table-empty\" colspan=\"6\">正在读取模组清单…</td></tr>\n     </tbody>\n    </table>\n   </div>\n  </section>\n\n </div>\n\n <aside class=\"drawer\" id=\"drawer\" hidden aria-label=\"模组预览\">\n  <div class=\"drawer-head\">\n   <div class=\"drawer-title-wrap\">\n    <h2 id=\"drawer-title\">预览</h2>\n    <p class=\"drawer-meta\" id=\"drawer-meta\" aria-live=\"polite\"></p>\n   </div>\n   <div class=\"btn-row\">\n    <button type=\"button\" id=\"drawer-translate\" class=\"primary\" aria-label=\"翻译这个模组\">翻译这个模组</button>\n    <button type=\"button\" id=\"drawer-close\" aria-label=\"关闭预览\">关闭</button>\n   </div>\n  </div>\n  <div class=\"drawer-body\" id=\"drawer-body\"></div>\n </aside>\n</main>\n\n<script src=\"app.js\"></script>\n</body>\n</html>\n","style.css":"/* MC 汉化插件样式：颜色全部来自宿主 tokens.css，主题切换由 [data-theme] 变量覆盖完成。 */\n\n:root{\n --font-mono: ui-monospace, \"Cascadia Mono\", Consolas, \"Courier New\", monospace;\n --side-width: var(--sidebar-width, 208px);\n}\n\n*{box-sizing:border-box}\n[hidden]{display:none !important}\nhtml,body{height:100%}\n\nbody{\n margin:0;\n display:grid;\n grid-template-columns:var(--side-width) minmax(0,1fr);\n height:100vh;\n overflow:hidden;\n background:var(--color-bg);\n color:var(--color-text);\n font-family:var(--font-ui);\n font-size:var(--font-size-body);\n line-height:1.5;\n -webkit-font-smoothing:antialiased;\n}\n\nh1,h2,h3{margin:0;font-weight:600}\np{margin:0}\n\n.icon-sprite{display:none}\nsvg.icon{width:18px;height:18px;flex:none;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}\n\n.sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}\n\n/* ---------- 侧栏 ---------- */\n\n.sidebar{\n display:flex;\n flex-direction:column;\n gap:var(--space-4);\n min-height:0;\n padding:var(--space-4) var(--space-3);\n background:var(--color-surface);\n border-right:1px solid var(--color-border);\n overflow:auto;\n}\n\n.brand{display:flex;align-items:center;gap:var(--space-2);padding:0 var(--space-1) var(--space-3);border-bottom:1px solid var(--color-border)}\n.brand-mark{display:grid;place-items:center;width:28px;height:28px;flex:none;border-radius:var(--radius-control);background:var(--color-accent);color:var(--color-accent-text);font-weight:600}\n.brand-text strong{display:block;font-size:14px}\n.brand-text small{display:block;color:var(--color-muted);font-size:12px}\n\n.nav{display:flex;flex-direction:column;gap:var(--space-1)}\n.nav button{\n display:flex;align-items:center;gap:var(--space-2);\n height:36px;padding:0 var(--space-3);\n border:1px solid transparent;border-radius:var(--radius-control);\n background:transparent;color:var(--color-text);\n font:inherit;text-align:left;cursor:pointer;\n}\n.nav button:hover{background:var(--color-surface-hover)}\n.nav button.selected{background:var(--color-text);color:var(--color-surface)}\n.nav button.selected:hover{background:var(--color-text)}\n\n.side-foot{display:flex;align-items:center;gap:var(--space-2);margin-top:auto;padding:var(--space-2) var(--space-1) 0;border-top:1px solid var(--color-border);color:var(--color-muted);font-size:12px;line-height:1.35}\n.dot{width:7px;height:7px;border-radius:50%;flex:none;background:var(--color-success)}\n.dot.bad{background:var(--color-danger)}\n\n/* ---------- 主区 ---------- */\n\nmain{position:relative;display:flex;flex-direction:column;min-width:0;min-height:0;height:100vh;overflow:hidden}\n\n.topbar{\n display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-4);\n padding:var(--space-4) var(--space-6);\n background:var(--color-surface);\n border-bottom:1px solid var(--color-border);\n}\n.pack{min-width:0}\n.pack h1{font-size:20px;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.pack-path{\n margin-top:2px;color:var(--color-muted);font-size:12px;\n font-family:var(--font-mono);\n white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\n}\n\n.topbar-status{display:flex;flex:0 0 auto;flex-wrap:wrap;justify-content:flex-end;gap:var(--space-2)}\n.chip{\n display:inline-flex;align-items:center;gap:6px;\n height:26px;padding:0 10px;\n border:1px solid var(--color-border);border-radius:999px;\n background:var(--color-bg);color:var(--color-muted);\n font-size:12px;white-space:nowrap;\n}\n.chip .dot{background:var(--color-muted)}\n.chip.ok{color:var(--color-success);border-color:var(--color-success)}\n.chip.ok .dot{background:var(--color-success)}\n.chip.warn{color:var(--color-danger);border-color:var(--color-danger)}\n.chip.warn .dot{background:var(--color-danger)}\n\n/* 提示条 */\n.notice{\n display:flex;align-items:center;gap:var(--space-3);\n margin:var(--space-3) var(--space-6) 0;\n padding:var(--space-2) var(--space-3);\n border:1px solid var(--color-danger);border-radius:var(--radius-control);\n background:var(--color-surface);color:var(--color-danger);\n}\n.notice p{flex:1;min-width:0;font-size:13px;overflow-wrap:anywhere}\n.notice.ok{border-color:var(--color-success);color:var(--color-success)}\n\n/* ---------- 视图 ---------- */\n\n.views{flex:1;min-height:0;display:flex;flex-direction:column;gap:var(--space-4);padding:var(--space-4) var(--space-6) var(--space-6);overflow:auto}\n.view{display:flex;flex-direction:column;gap:var(--space-4);min-width:0}\n.view[data-view=\"translate\"]{flex:1;min-height:0}\n.view[data-view=\"mods\"]{flex:1;min-height:0}\n\n.card{\n padding:var(--space-4);\n background:var(--color-surface);\n border:1px solid var(--color-border);\n border-radius:var(--radius-panel);\n}\n.card-title{margin-bottom:var(--space-3);color:var(--color-muted);font-size:12px;font-weight:600;letter-spacing:.04em}\n.hint{margin-top:var(--space-2);color:var(--color-muted);font-size:12px;overflow-wrap:anywhere}\n\n/* 提示块 */\n.flags{display:flex;flex-direction:column;gap:var(--space-2)}\n.flag{\n display:flex;align-items:center;gap:var(--space-3);\n padding:var(--space-2) var(--space-3);\n border:1px solid var(--color-danger);border-radius:var(--radius-control);\n background:var(--color-surface);color:var(--color-danger);\n}\n.flag p{flex:1;min-width:0;font-size:13px}\n\n/* ---------- 通用控件 ---------- */\n\nbutton{\n height:var(--control-height);padding:0 var(--space-3);\n border:1px solid var(--color-border);border-radius:var(--radius-control);\n background:var(--color-surface);color:var(--color-text);\n font:inherit;font-size:13px;cursor:pointer;white-space:nowrap;\n}\nbutton:hover:not(:disabled){background:var(--color-surface-hover)}\nbutton:disabled{opacity:.5;cursor:default}\nbutton.primary{background:var(--color-accent);border-color:var(--color-accent);color:var(--color-accent-text)}\nbutton.danger{color:var(--color-danger);border-color:var(--color-danger)}\nbutton.ghost{height:26px;padding:0 var(--space-2);font-size:12px}\n\ninput,select{\n height:var(--control-height);min-width:0;padding:0 var(--space-2);\n border:1px solid var(--color-border);border-radius:var(--radius-control);\n background:var(--color-bg);color:var(--color-text);\n font:inherit;font-size:13px;\n}\ninput::placeholder{color:var(--color-muted)}\ninput[readonly]{color:var(--color-muted)}\ninput[type=\"number\"]{text-align:right;font-variant-numeric:tabular-nums}\n\n:focus-visible{outline:2px solid var(--color-focus);outline-offset:1px}\n\n.btn-row{display:flex;flex-wrap:wrap;gap:var(--space-2)}\n\n/* ---------- 概览 ---------- */\n\n.path-row{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-2)}\n.path-input{flex:1 1 320px;font-family:var(--font-mono);font-size:12px}\n\n.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-3)}\n.stat{display:flex;flex-direction:column;gap:var(--space-1);padding:var(--space-3)}\n.stat-label{color:var(--color-muted);font-size:12px;font-weight:600}\n.stat-value{margin:0;font-size:22px;font-weight:600;line-height:1.2;font-variant-numeric:tabular-nums}\n.stat-value.bad{color:var(--color-danger)}\n.stat-value.good{color:var(--color-success)}\n.stat-note{color:var(--color-muted);font-size:12px;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}\n\n.bar{height:6px;border-radius:999px;background:var(--color-border);overflow:hidden}\n.bar>i{display:block;height:100%;width:0;border-radius:999px;background:var(--color-accent);transition:width .25s ease}\n.bar.indeterminate>i{animation:sweep 1.3s ease-in-out infinite}\n@keyframes sweep{\n 0%{transform:translateX(-110%)}\n 100%{transform:translateX(340%)}\n}\n\n.kv{display:grid;grid-template-columns:auto minmax(0,1fr);gap:var(--space-2) var(--space-4);font-size:13px}\n.kv dt{color:var(--color-muted)}\n.kv dd{margin:0;min-width:0;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}\n\n/* ---------- 翻译 ---------- */\n\n.controls{display:flex;flex-wrap:wrap;align-items:flex-end;gap:var(--space-3)}\n.field{display:flex;flex-direction:column;gap:4px;min-width:0}\n.field>span{color:var(--color-muted);font-size:12px}\n.field input,.field select{width:100%}\n.field.narrow input{width:118px}\n.field.grow{flex:1 1 220px}\n.field-row{display:flex;flex-wrap:wrap;gap:var(--space-3)}\n.actions{margin-left:auto}\n\n.progress-row{display:flex;align-items:center;gap:var(--space-3)}\n.progress-row .bar{flex:1;min-width:120px}\n.progress-text{color:var(--color-muted);font-size:12px;font-variant-numeric:tabular-nums;white-space:nowrap}\n\n.log-wrap{display:flex;flex:1;min-height:200px}\n.log{\n flex:1;min-height:0;overflow:auto;\n padding:var(--space-3);\n background:var(--color-paper);\n border:1px solid var(--color-paper-line);border-radius:var(--radius-panel);\n font-family:var(--font-mono);font-size:12px;line-height:1.65;\n white-space:pre-wrap;overflow-wrap:anywhere;\n}\n.log-empty{margin:0;color:var(--color-muted);font-family:var(--font-mono);font-size:12px}\n.log-line{white-space:pre-wrap;overflow-wrap:anywhere}\n.log-line.err{color:var(--color-danger)}\n.log-line.ok{color:var(--color-success)}\n.log-line.warn{color:var(--color-muted);font-style:italic}\n.log-line.step{color:var(--color-accent);font-weight:600}\n.log-line.end{color:var(--color-muted)}\n\n/* ---------- 接口 ---------- */\n\n.api-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:var(--space-4);align-items:start}\n.form-stack{display:flex;flex-direction:column;gap:var(--space-3)}\n.check-row{display:flex;align-items:center;gap:var(--space-2);color:var(--color-muted);font-size:12px}\n.check-row input{height:auto}\n\n/* ---------- 模组清单 ---------- */\n\n.toolbar{display:flex;flex-wrap:wrap;align-items:flex-end;gap:var(--space-3)}\n.switch{display:inline-flex;align-items:center;gap:6px;height:var(--control-height);font-size:13px}\n.switch input{height:auto}\n.count{margin-left:auto;color:var(--color-muted);font-size:12px;font-variant-numeric:tabular-nums}\n\n.chips-row{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-2)}\n.chips-label{color:var(--color-muted);font-size:12px}\n.chip-btn{\n display:inline-flex;align-items:center;gap:6px;\n height:26px;padding:0 6px 0 10px;\n border-radius:999px;font-size:12px;\n}\n.chip-btn .badge{margin-left:0}\n\n.badge{\n display:inline-flex;align-items:center;\n height:18px;padding:0 6px;margin-left:6px;\n border-radius:999px;\n background:var(--color-selected);color:var(--color-accent);\n font-size:11px;font-variant-numeric:tabular-nums;white-space:nowrap;\n}\n.badge.tag-jar{background:var(--color-border);color:var(--color-muted)}\n\n.table-wrap{flex:1;min-height:0;overflow:auto;border:1px solid var(--color-border);border-radius:var(--radius-panel);background:var(--color-surface)}\ntable.mods{width:100%;border-collapse:collapse;font-size:13px}\ntable.mods th,table.mods td{padding:var(--space-2) var(--space-3);border-bottom:1px solid var(--color-border);text-align:left;white-space:nowrap}\ntable.mods th{\n position:sticky;top:0;z-index:1;\n background:var(--color-surface);color:var(--color-muted);\n font-size:12px;font-weight:600;\n}\ntable.mods .num{text-align:right;font-variant-numeric:tabular-nums}\ntable.mods tbody tr{cursor:pointer}\ntable.mods tbody tr:hover{background:var(--color-surface-hover)}\ntd.bad{color:var(--color-danger)}\ntd.action-cell{text-align:right}\n.ns-name{font-family:var(--font-mono);font-size:12px}\n.table-empty{padding:var(--space-6);color:var(--color-muted);text-align:center;white-space:normal;cursor:default}\n\n.mini{display:inline-flex;align-items:center;gap:var(--space-2)}\n.mini-bar{width:72px;height:5px;border-radius:999px;background:var(--color-border);overflow:hidden}\n.mini-bar>i{display:block;height:100%;width:0;background:var(--color-accent)}\n.mini-label{color:var(--color-muted);font-size:12px;font-variant-numeric:tabular-nums;min-width:34px;text-align:right}\n\n/* ---------- 预览抽屉 ---------- */\n\n.drawer{\n position:absolute;left:0;right:0;bottom:0;z-index:5;\n display:flex;flex-direction:column;\n max-height:64%;\n background:var(--color-surface);\n border-top:1px solid var(--color-border);\n box-shadow:var(--shadow-paper);\n}\n.drawer-head{display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-3);padding:var(--space-3) var(--space-4);border-bottom:1px solid var(--color-border)}\n.drawer-title-wrap{min-width:0}\n.drawer-head h2{font-size:15px;font-family:var(--font-mono);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.drawer-meta{margin-top:2px;color:var(--color-muted);font-size:12px;overflow-wrap:anywhere}\n.drawer-body{flex:1;min-height:0;overflow:auto;padding:var(--space-2) var(--space-4) var(--space-4)}\n\n.preview-list{display:flex;flex-direction:column}\n.preview-row{\n display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);\n gap:var(--space-1) var(--space-3);\n padding:var(--space-2) 0;\n border-bottom:1px solid var(--color-border);\n font-size:13px;\n}\n.preview-key{grid-column:1 / -1;color:var(--color-muted);font-family:var(--font-mono);font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.preview-en{min-width:0;overflow-wrap:anywhere}\n.preview-zh{min-width:0;overflow-wrap:anywhere}\n.preview-zh.empty{color:var(--color-muted)}\n.drawer-empty{padding:var(--space-4) 0;color:var(--color-muted);font-size:13px}\n\n/* ---------- 窄屏 ---------- */\n\n@media (max-width:1180px){\n .stats{grid-template-columns:repeat(2,minmax(0,1fr))}\n .api-grid{grid-template-columns:minmax(0,1fr)}\n}\n\n@media (max-width:960px){\n .views{padding:var(--space-3) var(--space-4)}\n .topbar{padding:var(--space-3) var(--space-4)}\n .notice{margin:var(--space-2) var(--space-4) 0}\n .preview-row{grid-template-columns:minmax(0,1fr)}\n .preview-key{grid-column:auto}\n .drawer{max-height:74%}\n}\n\n@media (max-width:720px){\n body{grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr)}\n .sidebar{\n  flex-direction:row;align-items:center;gap:var(--space-2);\n  padding:var(--space-2) var(--space-3);\n  border-right:0;border-bottom:1px solid var(--color-border);\n  overflow-x:auto;\n }\n .brand{border-bottom:0;padding:0 var(--space-2) 0 0}\n .brand-text{display:none}\n .nav{flex-direction:row;gap:var(--space-1)}\n .nav button{height:30px;padding:0 var(--space-2)}\n .nav button span{display:none}\n .side-foot{display:none}\n main{height:auto;min-height:0}\n .topbar{flex-wrap:wrap;gap:var(--space-2)}\n .topbar-status{justify-content:flex-start}\n .pack-path{max-width:100%}\n .stats{grid-template-columns:repeat(2,minmax(0,1fr))}\n .count{margin-left:0}\n}\n","tokens.css":":root {\r\n  color-scheme: light;\r\n  --color-bg: #eeeee8;\r\n  --color-surface: #fafaf6;\r\n  --color-surface-hover: #eef1f5;\r\n  --color-border: #dcded5;\r\n  --color-text: #303c36;\r\n  --color-muted: #6d786f;\r\n  --color-accent: #356855;\r\n  --color-accent-text: #ffffff;\r\n  --color-selected: #e0e9df;\r\n  --color-danger: #b42318;\r\n  --color-success: #177245;\r\n  --color-focus: #356855;\r\n  --syntax-keyword: #8541a3;\r\n  --syntax-string: #34734c;\r\n  --syntax-comment: #6a786f;\r\n  --syntax-number: #a15b21;\r\n  --syntax-function: #276c9c;\r\n  --syntax-key: #96524c;\r\n  --syntax-warning: #875f10;\r\n  --syntax-mark: #f4df91;\r\n  --color-paper: #fffef9;\r\n  --color-paper-line: #e9e9df;\r\n  --color-decor: #94aa8e;\r\n  --color-dock: #fafbf7;\r\n  --color-dock-note: #e7e9d9;\r\n  --color-dock-task: #dce9df;\r\n  --color-dock-file: #eae0ce;\r\n  --shadow-paper: 0 12px 30px #394b3510;\r\n  --shadow-dock: 0 10px 35px #34403216;\r\n  --font-ui: 'Segoe UI Variable', 'Segoe UI', 'Microsoft YaHei UI', sans-serif;\r\n  --font-size-body: 14px;\r\n  --radius-control: 6px;\r\n  --radius-panel: 8px;\r\n  --space-1: 4px;\r\n  --space-2: 8px;\r\n  --space-3: 12px;\r\n  --space-4: 16px;\r\n  --space-6: 24px;\r\n  --sidebar-width: 208px;\r\n  --control-height: 32px;\r\n}\r\n[data-theme='dark'] {\r\n  color-scheme: dark;\r\n  --color-bg: #202723;\r\n  --color-surface: #2a322c;\r\n  --color-surface-hover: #2b3340;\r\n  --color-border: #465048;\r\n  --color-text: #edf0f5;\r\n  --color-muted: #abb6c7;\r\n  --color-accent: #b3ceb9;\r\n  --color-accent-text: #223d30;\r\n  --color-selected: #3a4d3e;\r\n  --color-danger: #ffaca4;\r\n  --color-success: #85d6ad;\r\n  --color-focus: #b3ceb9;\r\n  --syntax-keyword: #cf9ee6;\r\n  --syntax-string: #a6c897;\r\n  --syntax-comment: #9da99e;\r\n  --syntax-number: #e5b481;\r\n  --syntax-function: #8bc2df;\r\n  --syntax-key: #e3a49b;\r\n  --syntax-warning: #e4bd6b;\r\n  --syntax-mark: #605b35;\r\n  --color-paper: #303831;\r\n  --color-paper-line: #454e43;\r\n  --color-decor: #78916f;\r\n  --color-dock: #2a352d;\r\n  --color-dock-note: #4a4b39;\r\n  --color-dock-task: #3d5747;\r\n  --color-dock-file: #594e3b;\r\n}\r\n"}}