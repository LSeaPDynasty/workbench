{"manifest":{"id":"log-viewer","name":"日志查看器","version":"1.0.0","apiVersion":1,"entry":"index.html","permissions":["file.receive"],"fileTypes":[".log",".txt",".out",".jsonl",".ndjson"]},"files":{"app.js":"const api=window.workbench,$=id=>document.getElementById(id);let current=null,entries=[],visible=[],page=0,generation=0;const PAGE=300;\nfunction marked(node,text){const q=$('query').value;if(!q){node.textContent=text;return;}let start=0;const lower=text.toLowerCase();for(;;){const index=lower.indexOf(q.toLowerCase(),start);if(index<0){node.append(document.createTextNode(text.slice(start)));break;}node.append(document.createTextNode(text.slice(start,index)));const mark=document.createElement('mark');mark.textContent=text.slice(index,index+q.length);node.append(mark);start=index+q.length;}}\nfunction render(){const container=$('content');container.replaceChildren();for(const line of visible.slice(page*PAGE,(page+1)*PAGE)){const row=document.createElement('div');row.className='log-line level-'+line.level.toLowerCase();const number=document.createElement('span');number.className='line-number';number.textContent=line.number;const level=document.createElement('span');level.className='level';level.textContent=line.first?(line.level==='UNKNOWN'?'—':line.level):'';const message=document.createElement('code');marked(message,line.text);row.append(number,level,message);container.append(row);}if(!visible.length){const empty=document.createElement('p');empty.className='empty';empty.textContent=current?'无匹配日志':'未打开文件';container.append(empty);}$('prev').disabled=page===0;$('next').disabled=(page+1)*PAGE>=visible.length;$('end').disabled=!visible.length;$('page').textContent=visible.length?(page+1)+' / '+Math.ceil(visible.length/PAGE):'';$('status').textContent=visible.length+' 行';}\nfunction apply(){page=0;const filtered=window.LogParser.filter(entries,$('level').value,$('query').value);visible=filtered.flatMap(e=>e.lines.map((line,i)=>({...line,level:e.level,first:i===0})));$('summary').textContent=filtered.length+' / '+entries.length+' 条';render();}\nasync function open(file,refresh=false){if(!file)return;const run=++generation;current=file;entries=[];visible=[];page=0;if(!refresh){$('query').value='';$('level').value='ALL';}$('name').textContent=file.name;$('error').textContent='';$('refresh').disabled=true;render();$('content').textContent='加载中…';try{const data=await api.files.readText(file.token);if(run!==generation)return;entries=window.LogParser.parse(data.text);apply();}catch(e){if(run===generation){$('error').textContent=e.message;$('content').textContent='';}}finally{if(run===generation)$('refresh').disabled=false;}}\n$('query').oninput=apply;$('level').onchange=apply;$('wrap').onchange=()=>document.body.classList.toggle('wrap',$('wrap').checked);$('prev').onclick=()=>{page--;render();$('content').scrollTop=0;};$('next').onclick=()=>{page++;render();$('content').scrollTop=0;};$('end').onclick=()=>{page=Math.max(0,Math.ceil(visible.length/PAGE)-1);render();$('content').scrollTop=$('content').scrollHeight;};$('refresh').onclick=()=>open(current,true);\napi.onOpen(file=>open(file));api.onTheme(theme=>document.documentElement.dataset.theme=theme);api.initial().then(d=>{document.documentElement.dataset.theme=d.theme;open(d.file);}).catch(e=>$('error').textContent=e.message);\n","index.html":"<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"tokens.css\"><link rel=\"stylesheet\" href=\"style.css\"></head><body><header><strong id=\"name\">日志查看器</strong><span>只读</span><button id=\"refresh\" disabled>刷新</button></header><div class=\"toolbar\"><select id=\"level\" aria-label=\"日志级别\"><option value=\"ALL\">全部级别</option><option>TRACE</option><option>DEBUG</option><option>INFO</option><option>NOTICE</option><option>WARN</option><option>ERROR</option><option>FATAL</option><option value=\"UNKNOWN\">未知</option></select><input id=\"query\" placeholder=\"搜索\" aria-label=\"搜索日志\"><label><input id=\"wrap\" type=\"checkbox\">折行</label><button id=\"end\">末尾</button><span id=\"summary\"></span></div><p id=\"error\" role=\"status\"></p><div id=\"content\"><p class=\"empty\">未打开文件</p></div><footer><span id=\"status\"></span><button id=\"prev\" disabled>上一页</button><span id=\"page\"></span><button id=\"next\" disabled>下一页</button></footer><script src=\"parser.js\"></script><script src=\"app.js\"></script></body></html>\n","parser.js":"(function(root){\n const normalize=value=>{const v=String(value||'').toUpperCase();return ({WARNING:'WARN',CRITICAL:'FATAL',ERR:'ERROR',INFORMATION:'INFO'})[v]||(['TRACE','DEBUG','INFO','NOTICE','WARN','ERROR','FATAL'].includes(v)?v:'UNKNOWN');};\n function metadata(line){let match;const timestamp=line.match(/^\\s*(?:\\[)?(\\d{4}[-/]\\d{2}[-/]\\d{2}[T ][\\d:.,+Z-]+)/)?.[1]||'';\n  if(line.trim().startsWith('{')){try{const j=JSON.parse(line);if(j&&typeof j==='object'){const value=j.level??j.severity??j.log_level;const normalized=normalize(value);return {level:normalized,timestamp:String(j.timestamp??j.time??j['@timestamp']??''),start:value!==undefined||j.timestamp!==undefined||j.time!==undefined};}}catch{}}\n  match=line.match(/(?:^|\\[|\\s)(TRACE|DEBUG|INFO|NOTICE|WARN(?:ING)?|ERROR|ERR|FATAL|CRITICAL)(?=\\]|\\s|:|$)/i);\n  return {level:normalize(match?.[1]),timestamp,start:!!match||!!timestamp};\n }\n function parse(text){const entries=[];text.replace(/\\r\\n/g,'\\n').split('\\n').forEach((line,index)=>{const meta=metadata(line);if(meta.start||!entries.length)entries.push({level:meta.level,timestamp:meta.timestamp,lines:[{number:index+1,text:line}]});else entries.at(-1).lines.push({number:index+1,text:line});});return entries;}\n function filter(entries,level,query){const q=query.toLowerCase();return entries.filter(e=>(level==='ALL'||e.level===level)&&(!q||e.lines.some(l=>l.text.toLowerCase().includes(q))));}\n const api={parse,filter,metadata,normalize};if(typeof module!=='undefined')module.exports=api;else root.LogParser=api;\n})(globalThis);\n","style.css":"*{box-sizing:border-box}body{height:100vh;margin:0;display:flex;flex-direction:column;background:var(--color-paper);color:var(--color-text);font:13px var(--font-ui)}header{display:flex;gap:18px;align-items:center;padding:12px 20px;border-bottom:1px solid var(--color-border)}header strong{flex:1;font-weight:500}header span{font-size:11px;color:var(--color-muted)}button,select,input{background:var(--color-surface);border:1px solid var(--color-border);border-radius:4px;padding:5px 9px;color:inherit;font:inherit}button{cursor:pointer}button:disabled{opacity:.4;cursor:default}button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--color-focus)}input[type=checkbox]{accent-color:var(--color-accent)}.toolbar{display:flex;align-items:center;gap:12px;padding:10px 20px;font-size:11px;border-bottom:1px solid var(--color-border)}.toolbar>input{width:240px}#summary{margin-left:auto;color:var(--color-muted)}#content{flex:1;min-height:0;overflow:auto;padding:10px 0}.log-line{display:flex;min-width:max-content;font:12px/1.9 Consolas,'Microsoft YaHei',monospace}.line-number{width:55px;text-align:right;padding-right:15px;flex-shrink:0;font-size:10px;color:var(--color-muted);user-select:none;background:var(--color-paper);position:sticky;left:0}.level{width:65px;flex-shrink:0;font-size:10px;color:var(--color-muted)}code{font:inherit;white-space:pre;padding-right:20px}.wrap .log-line{min-width:0}.wrap code{white-space:pre-wrap;overflow-wrap:anywhere;min-width:0}.level-error,.level-fatal{color:var(--color-danger)}.level-warn{color:var(--syntax-warning)}.level-info .level,.level-notice .level{color:var(--color-success)}.level-debug .level,.level-trace .level{color:var(--syntax-comment)}mark{background:var(--syntax-mark);color:var(--color-text)}footer{display:flex;align-items:center;gap:10px;padding:8px 20px;border-top:1px solid var(--color-border);font-size:11px}footer>span:first-child{margin-right:auto}#error{padding:0 20px;color:var(--color-danger)}#error:empty{display:none}.empty{padding:20px;color:var(--color-muted)}\n","tokens.css":":root {\n  color-scheme: light;\n  --color-bg: #eeeee8;\n  --color-surface: #fafaf6;\n  --color-surface-hover: #eef1f5;\n  --color-border: #dcded5;\n  --color-text: #303c36;\n  --color-muted: #6d786f;\n  --color-accent: #356855;\n  --color-accent-text: #ffffff;\n  --color-selected: #e0e9df;\n  --color-danger: #b42318;\n  --color-success: #177245;\n  --color-focus: #356855;\n  --syntax-keyword: #8541a3;\n  --syntax-string: #34734c;\n  --syntax-comment: #6a786f;\n  --syntax-number: #a15b21;\n  --syntax-function: #276c9c;\n  --syntax-key: #96524c;\n  --syntax-warning: #875f10;\n  --syntax-mark: #f4df91;\n  --color-paper: #fffef9;\n  --color-paper-line: #e9e9df;\n  --color-decor: #94aa8e;\n  --color-dock: #fafbf7;\n  --color-dock-note: #e7e9d9;\n  --color-dock-task: #dce9df;\n  --color-dock-file: #eae0ce;\n  --shadow-paper: 0 12px 30px #394b3510;\n  --shadow-dock: 0 10px 35px #34403216;\n  --font-ui: 'Segoe UI Variable', 'Segoe UI', 'Microsoft YaHei UI', sans-serif;\n  --font-size-body: 14px;\n  --radius-control: 6px;\n  --radius-panel: 8px;\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-6: 24px;\n  --sidebar-width: 208px;\n  --control-height: 32px;\n}\n[data-theme='dark'] {\n  color-scheme: dark;\n  --color-bg: #202723;\n  --color-surface: #2a322c;\n  --color-surface-hover: #2b3340;\n  --color-border: #465048;\n  --color-text: #edf0f5;\n  --color-muted: #abb6c7;\n  --color-accent: #b3ceb9;\n  --color-accent-text: #223d30;\n  --color-selected: #3a4d3e;\n  --color-danger: #ffaca4;\n  --color-success: #85d6ad;\n  --color-focus: #b3ceb9;\n  --syntax-keyword: #cf9ee6;\n  --syntax-string: #a6c897;\n  --syntax-comment: #9da99e;\n  --syntax-number: #e5b481;\n  --syntax-function: #8bc2df;\n  --syntax-key: #e3a49b;\n  --syntax-warning: #e4bd6b;\n  --syntax-mark: #605b35;\n  --color-paper: #303831;\n  --color-paper-line: #454e43;\n  --color-decor: #78916f;\n  --color-dock: #2a352d;\n  --color-dock-note: #4a4b39;\n  --color-dock-task: #3d5747;\n  --color-dock-file: #594e3b;\n}\n"}}