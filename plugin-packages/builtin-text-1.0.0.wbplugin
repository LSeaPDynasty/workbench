{"manifest":{"id":"builtin-text","name":"文本阅读器","version":"1.0.0","apiVersion":1,"entry":"index.html","permissions":["file.receive"],"fileTypes":[".txt",".md",".json",".csv",".log",".js",".ts",".css",".html",".xml",".yaml",".yml",".py",".sql",".ini"]},"files":{"index.html":"<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"tokens.css\"><link rel=\"stylesheet\" href=\"style.css\"></head><body><header><strong id=\"name\">文本阅读器</strong><span>只读</span></header><p id=\"error\" role=\"status\"></p><pre id=\"content\">未打开文件</pre><script src=\"app.js\"></script></body></html>\n","app.js":"const api=window.workbench;let generation=0;\nasync function open(file){if(!file)return;const run=++generation;document.getElementById('name').textContent=file.name;document.getElementById('error').textContent='';document.getElementById('content').textContent='加载中…';try{const data=await api.files.readText(file.token);if(run===generation)document.getElementById('content').textContent=data.text;}catch(e){if(run===generation){document.getElementById('error').textContent=e.message;document.getElementById('content').textContent='';}}}\napi.onOpen(open);api.onTheme(theme=>document.documentElement.dataset.theme=theme);api.initial().then(data=>{document.documentElement.dataset.theme=data.theme;open(data.file);}).catch(e=>document.getElementById('error').textContent=e.message);\n","style.css":"body{margin:0;background:var(--color-paper);color:var(--color-text);font:14px var(--font-ui)}header{display:flex;justify-content:space-between;align-items:center;padding:17px 25px;border-bottom:1px solid var(--color-border);position:sticky;top:0;background:var(--color-paper)}header strong{font-weight:500}header span{font-size:11px;color:var(--color-muted)}pre{font:13px/1.8 Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;padding:20px 25px;margin:0}#error{color:var(--color-danger);padding:0 25px;font-size:12px}#error:empty{display:none}\n","tokens.css":":root {\n  color-scheme: light;\n  --color-bg: #eeeee8;\n  --color-surface: #fafaf6;\n  --color-surface-hover: #eef1f5;\n  --color-border: #dcded5;\n  --color-text: #303c36;\n  --color-muted: #6d786f;\n  --color-accent: #356855;\n  --color-accent-text: #ffffff;\n  --color-selected: #e0e9df;\n  --color-danger: #b42318;\n  --color-success: #177245;\n  --color-focus: #356855;\n  --color-paper: #fffef9;\n  --color-paper-line: #e9e9df;\n  --color-decor: #94aa8e;\n  --color-dock: #fafbf7;\n  --color-dock-note: #e7e9d9;\n  --color-dock-task: #dce9df;\n  --color-dock-file: #eae0ce;\n  --shadow-paper: 0 12px 30px #394b3510;\n  --shadow-dock: 0 10px 35px #34403216;\n  --font-ui: 'Segoe UI Variable', 'Segoe UI', 'Microsoft YaHei UI', sans-serif;\n  --font-size-body: 14px;\n  --radius-control: 6px;\n  --radius-panel: 8px;\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-6: 24px;\n  --sidebar-width: 208px;\n  --control-height: 32px;\n}\n[data-theme='dark'] {\n  color-scheme: dark;\n  --color-bg: #202723;\n  --color-surface: #2a322c;\n  --color-surface-hover: #2b3340;\n  --color-border: #465048;\n  --color-text: #edf0f5;\n  --color-muted: #abb6c7;\n  --color-accent: #b3ceb9;\n  --color-accent-text: #223d30;\n  --color-selected: #3a4d3e;\n  --color-danger: #ffaca4;\n  --color-success: #85d6ad;\n  --color-focus: #b3ceb9;\n  --color-paper: #303831;\n  --color-paper-line: #454e43;\n  --color-decor: #78916f;\n  --color-dock: #2a352d;\n  --color-dock-note: #4a4b39;\n  --color-dock-task: #3d5747;\n  --color-dock-file: #594e3b;\n}\n"}}