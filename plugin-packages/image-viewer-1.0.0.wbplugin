{"manifest":{"id":"image-viewer","name":"图片查看器","version":"1.0.0","apiVersion":1,"entry":"index.html","permissions":["file.receive"],"fileTypes":[".png",".jpg",".jpeg",".gif",".webp"]},"files":{"app.js":"const api=window.workbench;let generation=0;\nasync function open(file){if(!file)return;const run=++generation;const img=document.getElementById('image');img.hidden=true;img.removeAttribute('src');document.getElementById('name').textContent=file.name;document.getElementById('error').textContent='';try{const data=await api.files.readImage(file.token);if(run!==generation)return;img.alt=data.name;img.onerror=()=>{img.hidden=true;document.getElementById('error').textContent='无法解码图片';};img.src=data.data;img.hidden=false;}catch(e){if(run===generation)document.getElementById('error').textContent=e.message;}}\napi.onOpen(open);api.onTheme(theme=>document.documentElement.dataset.theme=theme);api.initial().then(d=>{document.documentElement.dataset.theme=d.theme;open(d.file);}).catch(e=>document.getElementById('error').textContent=e.message);\n","index.html":"<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"tokens.css\"><link rel=\"stylesheet\" href=\"style.css\"></head><body><header id=\"name\">图片查看器</header><p id=\"error\" role=\"status\">未打开文件</p><img id=\"image\" alt=\"\" hidden><script src=\"app.js\"></script></body></html>\n","style.css":"body{margin:0;background:var(--color-bg);color:var(--color-text);font:13px var(--font-ui)}header{padding:17px 25px;border-bottom:1px solid var(--color-border)}img{display:block;max-width:calc(100vw - 50px);max-height:calc(100vh - 100px);object-fit:contain;margin:20px auto}img[hidden]{display:none}p{padding:10px 25px;color:var(--color-muted)}\n","tokens.css":":root {\n  color-scheme: light;\n  --color-bg: #eeeee8;\n  --color-surface: #fafaf6;\n  --color-surface-hover: #eef1f5;\n  --color-border: #dcded5;\n  --color-text: #303c36;\n  --color-muted: #6d786f;\n  --color-accent: #356855;\n  --color-accent-text: #ffffff;\n  --color-selected: #e0e9df;\n  --color-danger: #b42318;\n  --color-success: #177245;\n  --color-focus: #356855;\n  --syntax-keyword: #8541a3;\n  --syntax-string: #34734c;\n  --syntax-comment: #6a786f;\n  --syntax-number: #a15b21;\n  --syntax-function: #276c9c;\n  --syntax-key: #96524c;\n  --syntax-warning: #875f10;\n  --syntax-mark: #f4df91;\n  --color-paper: #fffef9;\n  --color-paper-line: #e9e9df;\n  --color-decor: #94aa8e;\n  --color-dock: #fafbf7;\n  --color-dock-note: #e7e9d9;\n  --color-dock-task: #dce9df;\n  --color-dock-file: #eae0ce;\n  --shadow-paper: 0 12px 30px #394b3510;\n  --shadow-dock: 0 10px 35px #34403216;\n  --font-ui: 'Segoe UI Variable', 'Segoe UI', 'Microsoft YaHei UI', sans-serif;\n  --font-size-body: 14px;\n  --radius-control: 6px;\n  --radius-panel: 8px;\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-6: 24px;\n  --sidebar-width: 208px;\n  --control-height: 32px;\n}\n[data-theme='dark'] {\n  color-scheme: dark;\n  --color-bg: #202723;\n  --color-surface: #2a322c;\n  --color-surface-hover: #2b3340;\n  --color-border: #465048;\n  --color-text: #edf0f5;\n  --color-muted: #abb6c7;\n  --color-accent: #b3ceb9;\n  --color-accent-text: #223d30;\n  --color-selected: #3a4d3e;\n  --color-danger: #ffaca4;\n  --color-success: #85d6ad;\n  --color-focus: #b3ceb9;\n  --syntax-keyword: #cf9ee6;\n  --syntax-string: #a6c897;\n  --syntax-comment: #9da99e;\n  --syntax-number: #e5b481;\n  --syntax-function: #8bc2df;\n  --syntax-key: #e3a49b;\n  --syntax-warning: #e4bd6b;\n  --syntax-mark: #605b35;\n  --color-paper: #303831;\n  --color-paper-line: #454e43;\n  --color-decor: #78916f;\n  --color-dock: #2a352d;\n  --color-dock-note: #4a4b39;\n  --color-dock-task: #3d5747;\n  --color-dock-file: #594e3b;\n}\n"}}