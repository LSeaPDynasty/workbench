{"manifest":{"id":"local-media","name":"影音库","version":"1.0.0","apiVersion":1,"entry":"index.html","backend":"backend/index.cjs","permissions":["folders.read","native.backend","browser.open"]},"files":{"app.js":"const core=window.workbench,$=id=>document.getElementById(id),call=(method,...args)=>core.backend?core.backend.request(method,args):Promise.reject(Error('请先更新主体到 0.5.0'));\nlet libraries=[],items=[],kind='all',library='',favorite=false,next=null,generation=0,busy=false,scanRunning=false,poll=null,searchTimer=null,coverObserver,lastRevision=-1,lastShareLinks='';\nconst error=value=>{$('error').textContent=value?.message||'';};\nasync function action(fn){if(busy)return;busy=true;for(const id of ['add','add-side','scan','share-start','share-stop','player'])$(id).disabled=true;error(null);try{await fn();}catch(e){error(e);if($('share-dialog').open)$('share-error').textContent=e.message;}finally{busy=false;for(const id of ['add','add-side','scan','share-start','share-stop','player'])$(id).disabled=false;}}\nfunction renderLibraries(){const node=$('libraries');node.replaceChildren();for(const item of libraries){const row=document.createElement('div');row.className='library '+(library===item.id?'selected':'');const enabled=document.createElement('input');enabled.type='checkbox';enabled.checked=item.enabled;enabled.setAttribute('aria-label','启用媒体库 '+item.name);enabled.onchange=()=>action(async()=>{libraries=await call('enable',item.id,enabled.checked);renderLibraries();await load();});const name=document.createElement('button');name.className='name';name.textContent=item.name;name.title=item.name;name.onclick=()=>{library=library===item.id?'':item.id;renderLibraries();void load();};const remove=document.createElement('button');remove.className='remove';remove.textContent='×';remove.setAttribute('aria-label','移除媒体库 '+item.name);remove.onclick=()=>{if(confirm('移除此媒体库？不删除原文件。'))void action(async()=>{libraries=await call('remove',item.id);if(library===item.id)library='';renderLibraries();await load();});};row.append(enabled,name,remove);node.append(row);}if(!libraries.length){const empty=document.createElement('p');empty.className='hint';empty.textContent='未添加媒体库';node.append(empty);}}\nfunction render(){const node=$('items');coverObserver?.disconnect();node.replaceChildren();coverObserver=new IntersectionObserver(records=>{for(const record of records)if(record.isIntersecting){coverObserver.unobserve(record.target);const image=record.target;void call('cover',image.dataset.id).then(url=>{if(url&&image.isConnected)image.src=url;else image.remove();}).catch(()=>image.remove());}},{rootMargin:'100px'});for(const item of items){const card=document.createElement('article');card.className='card';const art=document.createElement('button');art.className='art '+item.kind;art.textContent=item.kind==='music'?'♫':'▶';art.title='在播放器中打开 '+item.title;art.setAttribute('aria-label','播放 '+item.title);art.onclick=()=>action(async()=>{await call('open',item.id);});if(item.hasCover){const image=document.createElement('img');image.alt='';image.dataset.id=item.id;image.onerror=()=>image.remove();art.append(image);coverObserver.observe(image);}const badge=document.createElement('span');badge.className='badge';badge.textContent=item.kind==='music'?'音乐':'视频';art.append(badge);const title=document.createElement('h3');title.textContent=item.title;title.title=item.title;const meta=document.createElement('small');meta.textContent=item.kind==='music'?[item.artist,item.album].filter(Boolean).join(' · ')||'音乐':(item.size/1024**2).toFixed(1)+' MB';const star=document.createElement('button');star.className='star '+(item.favorite?'on':'');star.textContent=item.favorite?'★':'☆';star.setAttribute('aria-label',(item.favorite?'取消收藏 ':'收藏 ')+item.title);star.onclick=()=>action(async()=>{await call('favorite',item.id,!item.favorite);await load();});card.append(art,title,meta,star);node.append(card);}if(!items.length){const empty=document.createElement('div');empty.className='empty';empty.textContent=scanRunning?'正在扫描媒体…':libraries.length?'没有匹配的媒体':'尚未添加媒体';if(!libraries.length){const add=document.createElement('button');add.textContent='添加媒体库';add.onclick=showAdd;empty.append(add);}node.append(empty);}$('more').hidden=next===null;}\nasync function load(more=false){const run=++generation;error(null);try{const result=await call('list',{kind,library,favorite,query:$('search').value,page:more?next||0:0});if(run!==generation)return;items=more?[...items,...result.items]:result.items;next=result.next;$('summary').textContent=result.total+' 项';$('heading').textContent=favorite?'收藏':kind==='music'?'音乐':kind==='video'?'视频':'全部媒体';render();}catch(e){if(run===generation)error(e);}}\nfunction renderShare(share){$('share-dot').textContent=share.enabled?'已开启':'未开启';$('share-state').textContent=share.enabled?'已开启 · '+share.clients+' 个已授权客户端':'未开启';$('share-start').hidden=share.enabled;$('share-stop').hidden=!share.enabled;$('port').disabled=share.enabled;if(!$('port').matches(':focus'))$('port').value=share.port;const signature=JSON.stringify(share.urls);if(lastShareLinks===signature)return;lastShareLinks=signature;const node=$('share-links');node.replaceChildren();for(const url of share.urls){const row=document.createElement('div');row.className='share-link';const input=document.createElement('input');input.readOnly=true;input.value=url;input.setAttribute('aria-label','局域网分享链接');input.onclick=()=>input.select();const copy=document.createElement('button');copy.textContent='复制链接';copy.onclick=()=>{void navigator.clipboard.writeText(url).then(()=>copy.textContent='已复制').catch(()=>{input.select();$('share-error').textContent='请手动复制选中的链接';});};row.append(input,copy);node.append(row);}if(share.enabled&&!share.urls.length){const hint=document.createElement('p');hint.className='hint';hint.textContent='未发现局域网 IPv4 地址，请检查网络连接';node.append(hint);}}\nasync function status(){try{const result=await call('status'),was=scanRunning;scanRunning=result.scan.running;$('scan-status').textContent=scanRunning?'已发现 '+result.scan.found+' 项 · 已检查 '+result.scan.visited+' 项':result.scan.error?result.scan.error:result.scan.cancelled?'扫描已取消':result.scan.truncated?'已达扫描上限':result.scan.errors?'扫描完成 · '+result.scan.errors+' 项未能读取':'';$('cancel-scan').hidden=!scanRunning;renderShare(result.share);if((was&&!scanRunning)||result.revision!==lastRevision){lastRevision=result.revision;libraries=await call('libraries');renderLibraries();await load();}}catch(e){error(e);}finally{poll=setTimeout(()=>status(),1500);}}\nfunction showAdd(){$('add-dialog').returnValue='';$('add-dialog').showModal();}$('add').onclick=showAdd;$('add-side').onclick=showAdd;$('add-dialog').onclose=()=>{if($('add-dialog').returnValue==='add')void action(async()=>{libraries=await call('add',$('kind').value);renderLibraries();scanRunning=true;await load();});};document.querySelectorAll('[data-kind]').forEach(button=>button.onclick=()=>{kind=button.dataset.kind;favorite=false;document.querySelectorAll('nav button').forEach(b=>b.classList.remove('selected'));button.classList.add('selected');void load();});$('favorites').onclick=()=>{favorite=!favorite;$('favorites').classList.toggle('selected',favorite);void load();};$('search').oninput=()=>{clearTimeout(searchTimer);searchTimer=setTimeout(()=>load(),200);};$('more').onclick=()=>load(true);$('scan').onclick=()=>action(async()=>{await call('scan');scanRunning=true;await load();});$('cancel-scan').onclick=()=>action(async()=>{await call('cancel');scanRunning=false;});$('player').onclick=()=>action(()=>call('open'));$('sharing').onclick=()=>{$('share-error').textContent='';$('share-dialog').showModal();};$('share-close').onclick=()=>$('share-dialog').close();$('share-start').onclick=()=>action(async()=>renderShare(await call('share.start',Number($('port').value))));$('share-stop').onclick=()=>action(async()=>renderShare(await call('share.stop')));core.onTheme(theme=>document.documentElement.dataset.theme=theme);window.addEventListener('pagehide',()=>{clearTimeout(poll);coverObserver?.disconnect();});core.initial().then(async initial=>{document.documentElement.dataset.theme=initial.theme;libraries=await call('libraries');renderLibraries();await load();void status();}).catch(error);\n","backend/catalog.cjs":"const fs=require('node:fs/promises'),path=require('node:path'),{createHash}=require('node:crypto');\nconst TYPES={'.mp3':['music','audio/mpeg'],'.flac':['music','audio/flac'],'.wav':['music','audio/wav'],'.m4a':['music','audio/mp4'],'.aac':['music','audio/aac'],'.ogg':['music','audio/ogg'],'.opus':['music','audio/ogg'],'.mp4':['video','video/mp4'],'.m4v':['video','video/mp4'],'.webm':['video','video/webm'],'.mkv':['video','video/x-matroska'],'.mov':['video','video/quicktime'],'.avi':['video','video/x-msvideo']};\nconst LIMIT=50000;\nfunction idFor(root,relative){return createHash('sha256').update(root+'\\0'+relative).digest('hex').slice(0,32);}\nfunction publicItem(item,favorites=[]){const {id,rootId,title,kind,mime,hasCover,hasSubtitle,artist,album,size,modified}=item;return {id,rootId,title,kind,mime,hasCover,hasSubtitle,artist,album,size,modified,favorite:favorites.includes(id)};}\nclass Catalog{\n constructor(context){this.context=context;this.state={version:1,libraries:[],items:[],favorites:[]};this.revision=0;this.generation=0;this.scan={running:false,visited:0,found:0,errors:0};this.tasks=new Set();this.tail=Promise.resolve();this.file=path.join(context.dataDir,'catalog-v1.json');}\n async init(){try{const info=await fs.stat(this.file);if(info.size>64*1024*1024)throw Error('媒体索引过大');const data=JSON.parse(await fs.readFile(this.file,'utf8'));if(data.version!==1||!Array.isArray(data.libraries)||!Array.isArray(data.items)||data.items.length>LIMIT||!Array.isArray(data.favorites))throw Error('媒体索引格式无效');this.state=data;}catch(error){if(error.code!=='ENOENT')throw error;}}\n save(){const data=JSON.stringify(this.state);const operation=this.tail.then(async()=>{await fs.writeFile(this.file+'.tmp',data);await fs.rename(this.file+'.tmp',this.file);});this.tail=operation.catch(()=>{});return operation;}\n libraries(){return this.state.libraries.map(l=>({...l,count:this.state.items.filter(i=>i.rootId===l.id).length}));}\n library(id){const library=this.state.libraries.find(l=>l.id===id&&l.enabled);if(!library)throw Error('媒体库未启用');return library;}\n item(id){const item=this.state.items.find(i=>i.id===id);if(!item)throw Error('媒体不存在，请重新扫描');this.library(item.rootId);return item;}\n list(input={}){const {kind='all',query='',library='',favorite=false,page=0}=input;if(!['all','music','video'].includes(kind)||typeof query!=='string'||query.length>256||!Number.isSafeInteger(page)||page<0||page>1000)throw Error('筛选参数无效');const enabled=new Set(this.state.libraries.filter(l=>l.enabled).map(l=>l.id));const q=query.toLowerCase();const items=this.state.items.filter(i=>enabled.has(i.rootId)&&(kind==='all'||i.kind===kind)&&(!library||i.rootId===library)&&(!favorite||this.state.favorites.includes(i.id))&&(!q||(i.title+' '+i.artist+' '+i.album).toLowerCase().includes(q))).sort((a,b)=>a.title.localeCompare(b.title,'zh-CN'));\n return {items:items.slice(page*60,(page+1)*60).map(i=>publicItem(i,this.state.favorites)),total:items.length,next:(page+1)*60<items.length?page+1:null};}\n async add(kind){if(!['all','music','video'].includes(kind))throw Error('媒体库类型无效');const root=await this.context.host('dialog.directory');if(!root)return this.libraries();const old=this.state.libraries.find(l=>l.id===root.id);if(old){old.kind=kind;old.enabled=true;}else this.state.libraries.push({id:root.id,name:root.name,kind,enabled:true});await this.save();this.start();return this.libraries();}\n async change(id,enabled){const library=this.state.libraries.find(l=>l.id===id);if(!library||typeof enabled!=='boolean')throw Error('媒体库无效');this.cancel();library.enabled=enabled;await this.save();if(enabled)this.start();return this.libraries();}\n async remove(id){if(!this.state.libraries.some(l=>l.id===id))throw Error('媒体库无效');this.cancel();this.state.libraries=this.state.libraries.filter(l=>l.id!==id);this.state.items=this.state.items.filter(i=>i.rootId!==id);const keep=new Set(this.state.items.map(i=>i.id));this.state.favorites=this.state.favorites.filter(i=>keep.has(i));await this.save();return this.libraries();}\n async favorite(id,value){this.item(id);if(typeof value!=='boolean')throw Error('收藏参数无效');this.state.favorites=this.state.favorites.filter(v=>v!==id);if(value)this.state.favorites.push(id);await this.save();return value;}\n cancel(){this.generation++;this.scan={...this.scan,running:false,cancelled:true};return {...this.scan};}\n start(){const run=++this.generation;this.scan={running:true,visited:0,found:0,errors:0,truncated:false};const task=this.scanAll(run);this.tasks.add(task);void task.finally(()=>this.tasks.delete(task));return {...this.scan};}\n async scanAll(run){const found=[];try{\n  const libraries=this.state.libraries.filter(l=>l.enabled).map(l=>({...l}));\n  for(const library of libraries){if(run!==this.generation)return;let root;try{root=await this.context.host('folders.resolve',library.id,'');}catch{this.scan.errors++;continue;}\n   const stack=[{relative:'',depth:0}];while(stack.length){if(run!==this.generation)return;const current=stack.pop();let handle;try{handle=await fs.opendir(path.join(root,current.relative));}catch{this.scan.errors++;continue;}\n    const media=[],images=[],subtitles=new Set();\n    for await(const entry of handle){if(run!==this.generation)return;this.scan.visited++;if(entry.isSymbolicLink())continue;const relative=path.join(current.relative,entry.name);if(entry.isDirectory()){if(current.depth<32)stack.push({relative,depth:current.depth+1});else this.scan.truncated=true;}else if(entry.isFile()){const type=TYPES[path.extname(entry.name).toLowerCase()];if(type&&(library.kind==='all'||library.kind===type[0]))media.push({relative,name:entry.name,type});if(/^(cover|folder|poster)\\.(jpg|jpeg|png|webp)$/i.test(entry.name))images.push(relative);if(/\\.vtt$/i.test(entry.name))subtitles.add(path.basename(entry.name,path.extname(entry.name)));}if(this.scan.visited%200===0)await new Promise(r=>setImmediate(r));if(this.scan.visited>=250000){this.scan.truncated=true;stack.length=0;break;}}\n    const cover=images.find(p=>/cover\\./i.test(p))||images[0]||null;\n    for(const entry of media){if(run!==this.generation)return;try{const file=await this.context.host('folders.resolve',library.id,entry.relative),info=await fs.stat(file);if(!info.isFile())continue;const folders=current.relative.split(path.sep).filter(Boolean),title=path.basename(entry.name,path.extname(entry.name)),subtitleRelative=subtitles.has(title)?path.join(current.relative,title+'.vtt'):null;found.push({id:idFor(library.id,entry.relative),rootId:library.id,title,kind:entry.type[0],mime:entry.type[1],relative:entry.relative,coverRelative:cover,subtitleRelative,hasCover:!!cover,hasSubtitle:!!subtitleRelative,artist:entry.type[0]==='music'&&folders.length>1?folders.at(-2):'',album:entry.type[0]==='music'?folders.at(-1)||library.name:'',size:info.size,modified:info.mtime.toISOString()});this.scan.found=found.length;}catch{this.scan.errors++;}if(found.length>=LIMIT){this.scan.truncated=true;break;}}\n    if(found.length>=LIMIT||this.scan.visited>=250000)break;\n   }if(found.length>=LIMIT||this.scan.visited>=250000)break;\n  }\n  if(run!==this.generation)return;this.state.items=found;const keep=new Set(found.map(i=>i.id));this.state.favorites=this.state.favorites.filter(id=>keep.has(id));await this.save();if(run===this.generation){this.revision++;this.scan={...this.scan,running:false,cancelled:false};}\n }catch{if(run===this.generation)this.scan={...this.scan,running:false,error:'扫描失败，原文件未修改'};}}\n async dispose(){this.cancel();await Promise.allSettled([...this.tasks]);await this.tail;}\n}\nmodule.exports={Catalog,TYPES,publicItem};\n","backend/index.cjs":"const {Catalog}=require('./catalog.cjs'),{MediaServer}=require('./server.cjs'),fs=require('node:fs/promises'),path=require('node:path');\nexports.create=async context=>{const catalog=new Catalog(context);await catalog.init();const server=new MediaServer(catalog,context);let closing=false;return {\n async request(method,args){if(closing)throw Error('媒体后台已停止');switch(method){\n  case 'libraries':return catalog.libraries();\n  case 'list':return catalog.list(args[0]);\n  case 'cover':{const item=catalog.item(args[0]);if(!item.coverRelative)return null;const filename=await context.host('folders.resolve',item.rootId,item.coverRelative),file=await fs.open(filename,'r');try{const info=await file.stat();if(!info.isFile()||info.size>256*1024)return null;const buffer=Buffer.alloc(256*1024+1);let total=0;while(total<buffer.length){const {bytesRead}=await file.read(buffer,total,buffer.length-total,null);if(!bytesRead)break;total+=bytesRead;}if(total>256*1024)return null;const mime={'.jpg':'image/jpeg','.jpeg':'image/jpeg','.png':'image/png','.webp':'image/webp'}[path.extname(filename).toLowerCase()];return mime?'data:'+mime+';base64,'+buffer.subarray(0,total).toString('base64'):null;}finally{await file.close();}}\n  case 'status':return {scan:{...catalog.scan},revision:catalog.revision,share:server.info(),count:catalog.state.items.length};\n  case 'add':return catalog.add(args[0]||'all');\n  case 'enable':if(!args[1])server.revoke(args[0]);return catalog.change(args[0],args[1]);\n  case 'remove':server.revoke(args[0]);return catalog.remove(args[0]);\n  case 'scan':return catalog.start();\n  case 'cancel':return catalog.cancel();\n  case 'favorite':return catalog.favorite(args[0],args[1]);\n  case 'open':return server.open(args[0]);\n  case 'share.start':return server.start(true,args[0]===undefined?8098:args[0]);\n  case 'share.stop':await server.stop(true);return server.info();\n  default:throw Error('未知媒体操作');\n }},\n async dispose(){closing=true;catalog.cancel();await server.dispose();await catalog.tail;}\n};};\n","backend/server.cjs":"const http=require('node:http'),fs=require('node:fs/promises'),path=require('node:path'),os=require('node:os'),{randomBytes,timingSafeEqual}=require('node:crypto'),{pipeline}=require('node:stream/promises');\nconst {publicItem}=require('./catalog.cjs');\nfunction privateAddress(value){const ip=(value||'').replace(/^::ffff:/,'');return ip==='::1'||/^127\\./.test(ip)||/^10\\./.test(ip)||/^192\\.168\\./.test(ip)||/^172\\.(1[6-9]|2\\d|3[01])\\./.test(ip)||/^169\\.254\\./.test(ip)||/^(fc|fd|fe80:)/i.test(ip);}\nfunction addresses(){return Object.values(os.networkInterfaces()).flat().filter(a=>a&&a.family==='IPv4'&&!a.internal&&privateAddress(a.address)).map(a=>a.address);}\nfunction range(value,size){if(!value)return {start:0,end:size-1,partial:false};const match=/^bytes=(\\d*)-(\\d*)$/.exec(value);if(!match||!size||(!match[1]&&!match[2]))throw Error('range');let start,end;if(!match[1]){const suffix=Number(match[2]);if(!Number.isSafeInteger(suffix)||suffix<=0)throw Error('range');start=Math.max(0,size-suffix);end=size-1;}else{start=Number(match[1]);end=match[2]?Math.min(Number(match[2]),size-1):size-1;}if(!Number.isSafeInteger(start)||!Number.isSafeInteger(end)||start<0||start>=size||end<start)throw Error('range');return {start,end,partial:true};}\nfunction json(res,status,data){res.writeHead(status,{'Content-Type':'application/json; charset=utf-8'});res.end(JSON.stringify(data));}\nasync function body(req){let text='';for await(const chunk of req){text+=chunk.toString();if(Buffer.byteLength(text)>2048)throw Error('请求过大');}return JSON.parse(text);}\nclass MediaServer{\n constructor(catalog,context){this.catalog=catalog;this.context=context;this.local=null;this.lan=null;this.streams=new Set();this.starting={};this.closing=false;}\n info(){const server=this.lan;return {enabled:!!server,port:server?.port||8098,urls:server?addresses().map(ip=>'http://'+ip+':'+server.port+'/#token='+server.secret):[],clients:server?[...server.sessions.values()].filter(s=>s.expires>Date.now()).length:0};}\n async start(lan=false,port=0){if(this.closing)throw Error('服务已停止');const key=lan?'lan':'local';if(this.starting[key])return this.starting[key];const task=this.listen(lan,port);this.starting[key]=task;try{return await task;}finally{if(this.starting[key]===task)delete this.starting[key];}}\n async listen(lan=false,port=0){if(lan&&(!Number.isSafeInteger(port)||port<1024||port>65535))throw Error('端口需为 1024–65535');if(lan?this.lan:this.local)return lan?this.info():this.local;\n  const state={lan,secret:randomBytes(32).toString('base64url'),sessions:new Map(),attempts:new Map(),cookie:'wm_'+randomBytes(6).toString('hex')};\n  state.server=http.createServer((req,res)=>{void this.handle(state,req,res).catch(()=>{if(res.destroyed)return;if(!res.headersSent)json(res,410,{error:'媒体文件不可用，请刷新或重新扫描'});else res.destroy();});});state.server.requestTimeout=15000;state.server.headersTimeout=10000;state.server.maxHeadersCount=40;state.server.on('clientError',(_,socket)=>socket.destroy());\n  try{await new Promise((resolve,reject)=>{state.server.once('error',reject);state.server.listen(port,lan?'0.0.0.0':'127.0.0.1',resolve);});}catch{throw Error('服务无法启动，端口可能已被占用');}\n  state.port=state.server.address().port;state.server.maxConnections=32;state.server.on('error',()=>{});if(lan)this.lan=state;else this.local=state;return lan?this.info():state;\n }\n async handle(state,req,res){\n  res.setHeader('Cache-Control','no-store');res.setHeader('X-Content-Type-Options','nosniff');res.setHeader('Referrer-Policy','no-referrer');res.setHeader('Content-Security-Policy',\"default-src 'self'; script-src 'self'; style-src 'self'; media-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'\");\n  if(!privateAddress(req.socket.remoteAddress)){json(res,403,{error:'仅允许本机或局域网访问'});return;}\n  let host;try{host=new URL('http://'+req.headers.host);if(host.port!==String(state.port)||!['127.0.0.1','localhost',...addresses()].includes(host.hostname)||host.username||host.password)throw Error();}catch{json(res,403,{error:'访问地址无效'});return;}\n  if(req.headers.origin&&req.headers.origin!==host.origin){json(res,403,{error:'不允许跨站请求'});return;}\n  const url=new URL(req.url,host.origin),route=url.pathname;\n  if(req.method==='POST'&&route==='/api/session'){\n   const ip=req.socket.remoteAddress,now=Date.now(),attempt=state.attempts.get(ip);if(attempt&&attempt.until>now&&attempt.count>=20){json(res,429,{error:'尝试过多，请稍后再试'});return;}state.attempts.set(ip,{until:now+60000,count:attempt&&attempt.until>now?attempt.count+1:1});if(state.attempts.size>256)state.attempts.delete(state.attempts.keys().next().value);\n   let token;try{token=(await body(req)).token;}catch{json(res,400,{error:'授权码无效'});return;}const given=Buffer.from(typeof token==='string'?token:'');const expected=Buffer.from(state.secret);if(given.length!==expected.length||!timingSafeEqual(given,expected)){json(res,401,{error:'分享链接无效或已过期'});return;}\n   const session=randomBytes(32).toString('base64url');state.sessions.set(session,{expires:Date.now()+12*3600000});if(state.sessions.size>128)state.sessions.delete(state.sessions.keys().next().value);res.setHeader('Set-Cookie',state.cookie+'='+session+'; HttpOnly; SameSite=Strict; Path=/; Max-Age=43200');json(res,200,{ok:true});return;\n  }\n  if(!['GET','HEAD'].includes(req.method)){json(res,405,{error:'只读服务'});return;}\n  const assets={'/':'index.html','/app.js':'app.js','/style.css':'style.css','/tokens.css':'../tokens.css'};\n  if(Object.hasOwn(assets,route)){const file=assets[route],data=await fs.readFile(path.join(__dirname,'../web',file));res.writeHead(200,{'Content-Type':file.endsWith('.js')?'application/javascript; charset=utf-8':file.endsWith('.css')?'text/css; charset=utf-8':'text/html; charset=utf-8','Content-Length':data.length});res.end(req.method==='HEAD'?undefined:data);return;}\n  const cookie=(req.headers.cookie||'').split(';').map(p=>p.trim()).find(p=>p.startsWith(state.cookie+'='))?.slice(state.cookie.length+1);const session=state.sessions.get(cookie);if(!session||session.expires<Date.now()){if(cookie)state.sessions.delete(cookie);json(res,401,{error:'请使用有效分享链接进入'});return;}\n  if(route==='/api/library'){const page=Number(url.searchParams.get('page')||0);try{const data=this.catalog.list({page,kind:url.searchParams.get('kind')||'all',query:url.searchParams.get('q')||'',library:url.searchParams.get('library')||''});json(res,200,data);}catch{json(res,400,{error:'筛选参数无效'});}return;}\n  if(route==='/api/libraries'){json(res,200,this.catalog.libraries().filter(l=>l.enabled).map(({id,name,kind,count})=>({id,name,kind,count})));return;}\n  const detail=/^\\/api\\/item\\/([a-f0-9]{32})$/.exec(route);if(detail){try{json(res,200,publicItem(this.catalog.item(detail[1])));}catch{json(res,404,{error:'媒体不存在'});}return;}\n  const match=/^\\/(media|cover|subtitle)\\/([a-f0-9]{32})$/.exec(route);if(!match){json(res,404,{error:'不存在'});return;}\n  if(this.streams.size>=12){json(res,429,{error:'同时播放连接过多，请稍后再试'});return;}\n  let item;try{item=this.catalog.item(match[2]);}catch{json(res,404,{error:'媒体不存在或已停用'});return;}\n  const cover=match[1]==='cover',subtitle=match[1]==='subtitle',relative=cover?item.coverRelative:subtitle?item.subtitleRelative:item.relative;if(!relative){res.writeHead(404);res.end();return;}\n  const filename=await this.context.host('folders.resolve',item.rootId,relative),file=await fs.open(filename,'r');let transferred=false;\n  try{\n   const info=await file.stat();if(!info.isFile()||!Number.isSafeInteger(info.size)||cover&&info.size>4*1024*1024||subtitle&&info.size>512*1024)throw Error();const checked=await this.context.host('folders.resolve',item.rootId,relative),current=await fs.stat(checked);if(checked.toLowerCase()!==filename.toLowerCase()||current.ino!==info.ino||current.dev!==info.dev)throw Error();this.catalog.library(item.rootId);\n   let bytes;try{bytes=range(cover||subtitle?undefined:req.headers.range,info.size);}catch{res.writeHead(416,{'Content-Range':'bytes */'+info.size});res.end();return;}\n   const mime=cover?{'.jpg':'image/jpeg','.jpeg':'image/jpeg','.png':'image/png','.webp':'image/webp'}[path.extname(relative).toLowerCase()]:subtitle?'text/vtt; charset=utf-8':item.mime;if(!mime)throw Error();\n   const headers={'Content-Type':mime,'Content-Length':Math.max(0,bytes.end-bytes.start+1),'Accept-Ranges':'bytes','Content-Disposition':'inline'};if(bytes.partial)headers['Content-Range']=`bytes ${bytes.start}-${bytes.end}/${info.size}`;res.writeHead(bytes.partial?206:200,headers);\n   if(req.method==='HEAD'||info.size===0){res.end();return;}\n   const stream=file.createReadStream({start:bytes.start,end:bytes.end,autoClose:true}),record={rootId:item.rootId,state,stream,res};transferred=true;this.streams.add(record);try{await pipeline(stream,res);}finally{this.streams.delete(record);}\n  }finally{if(!transferred)await file.close();}\n }\n revoke(rootId){for(const item of this.streams)if(item.rootId===rootId){item.stream.destroy();item.res.destroy();}}\n async stop(lan=true){await this.starting[lan?'lan':'local']?.catch(()=>{});const state=lan?this.lan:this.local;if(!state)return;for(const item of this.streams)if(item.state===state){item.stream.destroy();item.res.destroy();}state.sessions.clear();state.server.closeAllConnections();await new Promise(resolve=>state.server.close(resolve));if(lan)this.lan=null;else this.local=null;}\n async open(id){if(id)this.catalog.item(id);const state=await this.start(false);await this.context.host('browser.open','http://127.0.0.1:'+state.port+'/#token='+state.secret+(id?'&play='+id:''));return true;}\n async dispose(){this.closing=true;await Promise.all([this.stop(true),this.stop(false)]);}\n}\nmodule.exports={MediaServer,range,privateAddress};\n","index.html":"<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"tokens.css\"><link rel=\"stylesheet\" href=\"style.css\"></head><body>\n<aside><div class=\"brand\"><span>◉</span><strong>影音库</strong></div><nav><button data-kind=\"all\" class=\"selected\">全部媒体</button><button data-kind=\"music\">♫ 音乐</button><button data-kind=\"video\">▷ 视频</button><button id=\"favorites\">☆ 收藏</button></nav><div class=\"side-title\"><span>媒体库</span><button id=\"add-side\" aria-label=\"添加媒体库\">＋</button></div><div id=\"libraries\"></div><div class=\"side-footer\"><button id=\"sharing\">局域网共享 <span id=\"share-dot\">未开启</span></button></div></aside>\n<main><header><div><h1 id=\"heading\">全部媒体</h1><p id=\"summary\"></p></div><button id=\"scan\">重新扫描</button><button id=\"add\">添加媒体库</button><button id=\"player\" class=\"primary\">打开播放器 ↗</button></header><div class=\"toolbar\"><input id=\"search\" placeholder=\"搜索名称、歌手、专辑\" aria-label=\"搜索媒体\"><span id=\"scan-status\"></span><button id=\"cancel-scan\" hidden>取消扫描</button></div><p id=\"error\" role=\"status\"></p><div id=\"items\" class=\"grid\"></div><button id=\"more\" hidden>加载更多</button></main>\n<dialog id=\"add-dialog\"><form method=\"dialog\"><h2>添加媒体库</h2><label>类型<select id=\"kind\"><option value=\"all\">音乐和视频</option><option value=\"music\">音乐</option><option value=\"video\">视频</option></select></label><menu><button value=\"cancel\">取消</button><button value=\"add\" class=\"primary\">选择文件夹</button></menu></form></dialog>\n<dialog id=\"share-dialog\"><div class=\"dialog-title\"><h2>局域网共享</h2><button id=\"share-close\" aria-label=\"关闭共享设置\">×</button></div><p id=\"share-state\">未开启</p><label>端口<input id=\"port\" type=\"number\" min=\"1024\" max=\"65535\" value=\"8098\"></label><div id=\"share-links\"></div><p class=\"hint\">仅在可信局域网使用；停止共享后链接失效。</p><p id=\"share-error\" role=\"status\"></p><div class=\"dialog-actions\"><button id=\"share-stop\" hidden>停止共享</button><button id=\"share-start\" class=\"primary\">开启共享</button></div></dialog><script src=\"app.js\"></script></body></html>\n","style.css":"*{box-sizing:border-box}body{margin:0;height:100vh;display:grid;grid-template-columns:210px minmax(0,1fr);font:13px var(--font-ui);background:var(--color-bg);color:var(--color-text)}button,input,select{font:inherit;color:inherit;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-control);padding:8px 11px}button{cursor:pointer}button:hover{background:var(--color-selected)}button:disabled{opacity:.45;cursor:default}button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--color-focus)}[hidden]{display:none!important}.primary{background:var(--color-accent);color:var(--color-accent-text);border-color:var(--color-accent)}.primary:hover{background:var(--color-accent);filter:brightness(1.1)}aside{display:flex;flex-direction:column;border-right:1px solid var(--color-border);padding:var(--space-6) var(--space-3);overflow:auto}.brand{display:flex;gap:var(--space-3);align-items:center;padding:0 var(--space-2);margin-bottom:var(--space-6)}.brand>span{font-size:26px;color:var(--color-accent)}.brand strong{font-size:19px;font-weight:550}nav{display:grid;gap:var(--space-1);margin-bottom:var(--space-6)}nav button{text-align:left;border:0;background:none;padding:11px 13px}nav button.selected{background:var(--color-selected);color:var(--color-accent)}.side-title{display:flex;align-items:center;justify-content:space-between;color:var(--color-muted);font-size:11px;padding:0 var(--space-2);margin-bottom:var(--space-2)}.side-title button{border:0;background:none;padding:var(--space-1);font-size:18px}.library{display:flex;align-items:center;gap:var(--space-1);margin-bottom:var(--space-1);padding:var(--space-1);border-radius:var(--radius-control)}.library.selected{background:var(--color-selected)}.library input{accent-color:var(--color-accent)}.library button{background:none;border:0;text-align:left}.library button.name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px}.library button.remove{color:var(--color-muted);padding:var(--space-1)}.side-footer{margin-top:auto;padding-top:var(--space-6)}#sharing{display:flex;flex-direction:column;gap:var(--space-2);width:100%;align-items:flex-start;font-size:12px}#share-dot{font-size:10px;color:var(--color-muted)}main{overflow:auto;min-width:0;padding:var(--space-6) 30px;scrollbar-gutter:stable}header{display:flex;gap:var(--space-2);align-items:center;margin-bottom:var(--space-6)}header>div{margin-right:auto}h1{font-size:26px;font-weight:500;margin:0}header p{font-size:11px;color:var(--color-muted);margin:var(--space-2) 0 0}header button{white-space:nowrap;font-size:12px}.toolbar{display:flex;align-items:center;gap:var(--space-3);margin-bottom:var(--space-6)}.toolbar input{width:300px;max-width:55%;font-size:12px;padding:10px 12px}.toolbar span{margin-left:auto;font-size:11px;color:var(--color-muted)}.toolbar button{font-size:11px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:var(--space-6) var(--space-4)}.card{min-width:0;position:relative}.art{position:relative;display:grid;place-items:center;width:100%;height:175px;overflow:hidden;font-size:44px;color:var(--color-accent);background:linear-gradient(145deg,var(--color-selected),var(--color-surface));border:1px solid var(--color-border);border-radius:var(--radius-panel)}.art.video{color:var(--color-text);background:linear-gradient(145deg,var(--color-dock-file),var(--color-surface))}.art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.card h3{font-size:13px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin:var(--space-3) 24px var(--space-1) 0}.card small{color:var(--color-muted);font-size:11px;display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;padding-right:24px}.star{position:absolute;right:0;bottom:0;border:0;background:none;color:var(--color-muted);font-size:18px;padding:2px}.star.on{color:var(--color-accent)}.empty{grid-column:1/-1;text-align:center;padding:60px 0;color:var(--color-muted)}.empty button{display:block;margin:var(--space-4) auto}.badge{position:absolute;right:var(--space-2);bottom:var(--space-2);font-size:10px;padding:4px 6px;border-radius:4px;background:var(--color-surface);color:var(--color-muted)}#more{display:block;margin:var(--space-6) auto}#error,#share-error{font-size:12px;color:var(--color-danger)}#error:empty,#share-error:empty{display:none}dialog{color:var(--color-text);background:var(--color-bg);border:1px solid var(--color-border);border-radius:var(--radius-panel);padding:var(--space-6);width:min(480px,calc(100vw - 32px));box-shadow:var(--shadow-dock)}dialog::backdrop{background:#0006}dialog h2{font-size:18px;font-weight:500;margin:0 0 var(--space-6)}dialog label{display:grid;gap:var(--space-2);font-size:12px;color:var(--color-muted);margin-bottom:var(--space-4)}dialog menu,.dialog-actions{display:flex;justify-content:flex-end;gap:var(--space-2);padding:0;margin:var(--space-6) 0 0}.dialog-title{display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-4)}.dialog-title h2{margin:0}.dialog-title button{border:0;background:none;font-size:20px}.hint,#share-state{font-size:12px;line-height:1.7;color:var(--color-muted)}.share-link{margin-top:var(--space-3);display:flex;gap:var(--space-2)}.share-link input{min-width:0;flex:1;font:11px Consolas,monospace}.share-link button{font-size:11px}@media(max-width:1000px){body{grid-template-columns:180px minmax(0,1fr)}main{padding:var(--space-4)}header{flex-wrap:wrap}header>div{flex-basis:100%;margin-bottom:var(--space-2)}.toolbar{flex-wrap:wrap}.toolbar input{max-width:none;flex:1}.grid{grid-template-columns:repeat(auto-fill,minmax(140px,1fr))}}\n","web/app.js":"const $=id=>document.getElementById(id);let kind='all',favorite=false,entries=[],next=null,generation=0,current=null,player=null,searchTimer=null;\nconst savedFavorites=read('media.favorites',[]),favorites=new Set(Array.isArray(savedFavorites)?savedFavorites.filter(id=>typeof id==='string'):[]);\nfunction read(key,fallback){try{return JSON.parse(localStorage.getItem(key))||fallback;}catch{return fallback;}}\nfunction write(key,value){try{localStorage.setItem(key,JSON.stringify(value));}catch{}}\nasync function request(url,options){const response=await fetch(url,options);let value;try{value=await response.json();}catch{throw Error('服务响应无效');}if(!response.ok){if(response.status===401){$('locked').hidden=false;$('app').hidden=true;}throw Error(value.error||'请求失败');}return value;}\nasync function connect(token){if(token)await request('/api/session',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token})});const libraries=await request('/api/libraries');$('library').replaceChildren(new Option('所有媒体库',''));for(const library of libraries)$('library').add(new Option(library.name,library.id));$('locked').hidden=true;$('app').hidden=false;await load();}\nfunction render(){const node=$('items');node.replaceChildren();const visible=entries.filter(item=>!favorite||favorites.has(item.id));for(const item of visible){const card=document.createElement('button');card.className='card '+item.kind;const art=document.createElement('div');art.className='art';art.textContent=item.kind==='music'?'♫':'▶';if(item.hasCover){const image=document.createElement('img');image.loading='lazy';image.alt='';image.src='/cover/'+item.id;image.onerror=()=>image.remove();art.append(image);}const badge=document.createElement('span');badge.textContent=item.kind==='music'?'音乐':'视频';art.append(badge);const name=document.createElement('strong');name.textContent=item.title;const meta=document.createElement('small');meta.textContent=item.kind==='music'?[item.artist,item.album].filter(Boolean).join(' · ')||'音乐':size(item.size);card.append(art,name,meta);card.onclick=()=>play(item);node.append(card);}if(!visible.length){const empty=document.createElement('p');empty.className='empty';empty.textContent=favorite?'当前列表中暂无收藏':'没有匹配的媒体';node.append(empty);}$('more').hidden=next===null;}\nfunction size(value){return value>=1024**3?(value/1024**3).toFixed(1)+' GB':(value/1024**2).toFixed(1)+' MB';}\nasync function load(more=false){const run=++generation;$('error').textContent='';$('refresh').disabled=true;$('more').disabled=true;if(!more){entries=[];next=null;render();}$('count').textContent='加载中…';try{const q=new URLSearchParams({kind,q:$('search').value,library:$('library').value,page:String(more?next||0:0)});const result=await request('/api/library?'+q);if(run!==generation)return;entries=more?[...entries,...result.items]:result.items;next=result.next;$('count').textContent=result.total+' 项';render();}catch(error){if(run===generation)$('error').textContent=error.message;}finally{if(run===generation){$('refresh').disabled=false;$('more').disabled=false;}}}\nfunction play(item){try{current=item;$('playing').hidden=false;$('playing-name').textContent=item.title;$('playing-kind').textContent=item.kind==='music'?'正在播放音乐':'正在播放视频';$('playing-meta').textContent=[item.artist,item.album].filter(Boolean).join(' · ');$('player-error').textContent='';$('video').pause();$('audio').pause();for(const media of [$('video'),$('audio')]){media.removeAttribute('src');media.replaceChildren();media.load();}player=item.kind==='music'?$('audio'):$('video');$('audio').hidden=item.kind!=='music';$('video').hidden=item.kind!=='video';$('music-art').hidden=item.kind!=='music';$('music-art').style.backgroundImage=item.hasCover?'url(\"/cover/'+item.id+'\")':'none';player.src='/media/'+item.id;if(item.hasSubtitle&&item.kind==='video'){const track=document.createElement('track');track.kind='subtitles';track.label='字幕';track.srclang='zh';track.src='/subtitle/'+item.id;track.default=true;player.append(track);}player.playbackRate=Number($('speed').value);const resume=read('media.progress.'+item.id,0);$('resume').textContent=resume>3?'将从上次位置继续':'';player.onloadedmetadata=()=>{if(resume>3&&Number.isFinite(player.duration)&&resume<player.duration-5)player.currentTime=resume;};player.ontimeupdate=()=>{if(player.currentTime>0)write('media.progress.'+item.id,Math.floor(player.currentTime));};player.onended=()=>{write('media.progress.'+item.id,0);if(item.kind==='music')step(1);};player.onerror=()=>{$('player-error').textContent='此浏览器无法直放该文件，或连接已断开。当前版本不提供转码。';};$('bookmark').textContent=favorites.has(item.id)?'★ 已收藏':'☆ 收藏';void player.play().catch(()=>{$('resume').textContent='点击播放按钮开始';});$('playing').scrollIntoView({behavior:'smooth',block:'start'});}catch(error){$('player-error').textContent=error.message;}}\nfunction step(direction){if(!current)return;const queue=entries.filter(i=>i.kind===current.kind&&(!favorite||favorites.has(i.id))),index=queue.findIndex(i=>i.id===current.id),target=queue[index+direction];if(target)play(target);}\ndocument.querySelectorAll('[data-kind]').forEach(button=>button.onclick=()=>{kind=button.dataset.kind;favorite=false;document.querySelectorAll('.tabs button').forEach(b=>b.classList.remove('selected'));button.classList.add('selected');void load();});$('favorites').onclick=()=>{favorite=!favorite;$('favorites').classList.toggle('selected',favorite);render();};$('search').oninput=()=>{clearTimeout(searchTimer);searchTimer=setTimeout(()=>load(),250);};$('library').onchange=()=>load();$('refresh').onclick=()=>load();$('more').onclick=()=>load(true);$('previous').onclick=()=>step(-1);$('next-track').onclick=()=>step(1);$('speed').onchange=()=>{if(player)player.playbackRate=Number($('speed').value);};$('bookmark').onclick=()=>{if(!current)return;if(favorites.has(current.id))favorites.delete(current.id);else favorites.add(current.id);write('media.favorites',[...favorites]);$('bookmark').textContent=favorites.has(current.id)?'★ 已收藏':'☆ 收藏';render();};$('hide-player').onclick=()=>{if(player)player.pause();$('playing').hidden=true;};$('theme').onclick=()=>{const theme=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=theme;write('media.theme',theme);};document.documentElement.dataset.theme=read('media.theme','dark');$('connect').onsubmit=event=>{event.preventDefault();let token=$('key').value.trim();try{token=new URLSearchParams(new URL(token).hash.slice(1)).get('token')||token;}catch{}void connect(token).catch(error=>$('auth-error').textContent=error.message);};\nconst params=new URLSearchParams(location.hash.slice(1)),token=params.get('token'),playId=params.get('play');history.replaceState(null,'',location.pathname);connect(token).then(async()=>{if(playId&&/^[a-f0-9]{32}$/.test(playId)){try{play(await request('/api/item/'+playId));}catch(error){$('error').textContent=error.message;}}}).catch(error=>{$('locked').hidden=false;$('app').hidden=true;$('auth-error').textContent=error.message;});\n","web/index.html":"<!doctype html><html lang=\"zh-CN\" data-theme=\"dark\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>影音库</title><link rel=\"stylesheet\" href=\"tokens.css\"><link rel=\"stylesheet\" href=\"style.css\"></head><body>\n<header><strong>影音库</strong><span>播放器</span><button id=\"theme\" aria-label=\"切换主题\">◐</button></header>\n<main><section id=\"locked\" hidden><h1>连接媒体库</h1><form id=\"connect\"><input id=\"key\" type=\"password\" placeholder=\"粘贴分享链接\" aria-label=\"分享链接\" required><button>连接</button></form><p id=\"auth-error\" role=\"status\"></p></section>\n<div id=\"app\" hidden><section id=\"playing\" hidden><div class=\"player-heading\"><div><small id=\"playing-kind\"></small><h1 id=\"playing-name\"></h1><p id=\"playing-meta\"></p></div><button id=\"hide-player\">关闭播放</button></div><video id=\"video\" controls playsinline preload=\"metadata\" hidden></video><div id=\"music-art\" hidden>♫</div><audio id=\"audio\" controls preload=\"metadata\" hidden></audio><div class=\"playback\"><button id=\"previous\">上一首</button><button id=\"next-track\">下一首</button><button id=\"bookmark\">☆ 收藏</button><label>速度 <select id=\"speed\"><option value=\"0.75\">0.75×</option><option value=\"1\" selected>1×</option><option value=\"1.25\">1.25×</option><option value=\"1.5\">1.5×</option><option value=\"2\">2×</option></select></label><span id=\"resume\"></span></div><p id=\"player-error\" role=\"status\"></p></section>\n<nav><div class=\"tabs\"><button data-kind=\"all\" class=\"selected\">全部</button><button data-kind=\"music\">音乐</button><button data-kind=\"video\">视频</button><button id=\"favorites\">收藏</button></div><input id=\"search\" aria-label=\"搜索媒体\" placeholder=\"搜索名称、歌手、专辑\"><select id=\"library\" aria-label=\"媒体库\"><option value=\"\">所有媒体库</option></select></nav><div class=\"list-info\"><span id=\"count\"></span><button id=\"refresh\">刷新</button></div><p id=\"error\" role=\"status\"></p><div id=\"items\" class=\"grid\"></div><button id=\"more\" hidden>加载更多</button></div></main><script src=\"app.js\"></script></body></html>\n","web/style.css":"*{box-sizing:border-box}body{margin:0;background:var(--color-bg);color:var(--color-text);font:14px var(--font-ui)}button,input,select{font:inherit;color:inherit;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-control);padding:9px 12px}button{cursor:pointer}button:disabled{opacity:.45;cursor:default}button:hover{filter:brightness(1.12)}button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--color-focus)}[hidden]{display:none!important}header{display:flex;align-items:center;gap:var(--space-4);height:66px;padding:0 5vw;border-bottom:1px solid var(--color-border);background:var(--color-surface)}header strong{font-size:20px;font-weight:550}header span{color:var(--color-muted);font-size:12px}header button{margin-left:auto}main{max-width:1380px;margin:auto;padding:var(--space-6) 5vw 60px}h1{font-size:25px;font-weight:500;margin:var(--space-2) 0}p,small{color:var(--color-muted)}nav{display:flex;align-items:center;gap:var(--space-3);flex-wrap:wrap;margin:var(--space-6) 0 var(--space-3)}.tabs{display:flex;gap:var(--space-1);margin-right:auto}.tabs button{border-color:transparent;background:none;white-space:nowrap}.tabs button.selected{background:var(--color-selected);color:var(--color-accent)}nav input{min-width:180px;flex:1;max-width:300px}nav select{max-width:180px}.list-info{display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-4);font-size:12px;color:var(--color-muted)}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:var(--space-6) var(--space-4)}.card{padding:0;text-align:left;background:none;border:0;min-width:0}.art{height:190px;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-panel);background:linear-gradient(145deg,var(--color-selected),var(--color-surface));color:var(--color-accent);font-size:48px;overflow:hidden;position:relative}.art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.card.video .art{background:linear-gradient(145deg,var(--color-dock-file),var(--color-surface));color:var(--color-text)}.art span{position:absolute;bottom:var(--space-2);right:var(--space-2);font-size:11px;padding:4px 7px;background:var(--color-surface);border-radius:var(--radius-control)}.card strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:10px;font-size:13px;font-weight:500}.card small{display:block;font-size:11px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;margin-top:5px}.empty{grid-column:1/-1;text-align:center;padding:50px 0;color:var(--color-muted)}#more{display:block;margin:var(--space-6) auto}#playing{padding:var(--space-6);border:1px solid var(--color-border);border-radius:var(--radius-panel);background:var(--color-surface)}.player-heading{display:flex;justify-content:space-between;align-items:center;gap:var(--space-4);margin-bottom:var(--space-4)}.player-heading h1{overflow-wrap:anywhere}.player-heading small{font-size:11px}.player-heading p{margin:5px 0;font-size:12px}video{width:100%;max-height:65vh;background:#000;border-radius:var(--radius-panel)}audio{width:100%;margin:var(--space-4) 0}#music-art{display:grid;place-items:center;height:170px;background:var(--color-selected);color:var(--color-accent);font-size:72px;border-radius:var(--radius-panel);background-size:contain;background-position:center;background-repeat:no-repeat}.playback{display:flex;align-items:center;gap:var(--space-2);flex-wrap:wrap;margin-top:var(--space-4);font-size:12px}.playback label{margin-left:auto}.playback span{color:var(--color-muted)}#error,#player-error,#auth-error{color:var(--color-danger);font-size:12px}#error:empty,#player-error:empty,#auth-error:empty{display:none}#locked{max-width:500px;margin:15vh auto}#connect{display:flex;gap:var(--space-2)}#connect input{min-width:0;flex:1}@media(max-width:650px){main{padding:var(--space-4) 4vw 40px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4)}.art{height:170px}#playing{padding:var(--space-3)}nav input{max-width:none;flex-basis:100%}.tabs{width:100%}.tabs button{flex:1;padding:8px}.playback label{margin-left:0}.player-heading h1{font-size:20px}.player-heading>button{white-space:nowrap}}\n","tokens.css":":root {\n  color-scheme: light;\n  --color-bg: #eeeee8;\n  --color-surface: #fafaf6;\n  --color-surface-hover: #eef1f5;\n  --color-border: #dcded5;\n  --color-text: #303c36;\n  --color-muted: #6d786f;\n  --color-accent: #356855;\n  --color-accent-text: #ffffff;\n  --color-selected: #e0e9df;\n  --color-danger: #b42318;\n  --color-success: #177245;\n  --color-focus: #356855;\n  --syntax-keyword: #8541a3;\n  --syntax-string: #34734c;\n  --syntax-comment: #6a786f;\n  --syntax-number: #a15b21;\n  --syntax-function: #276c9c;\n  --syntax-key: #96524c;\n  --syntax-warning: #875f10;\n  --syntax-mark: #f4df91;\n  --color-paper: #fffef9;\n  --color-paper-line: #e9e9df;\n  --color-decor: #94aa8e;\n  --color-dock: #fafbf7;\n  --color-dock-note: #e7e9d9;\n  --color-dock-task: #dce9df;\n  --color-dock-file: #eae0ce;\n  --shadow-paper: 0 12px 30px #394b3510;\n  --shadow-dock: 0 10px 35px #34403216;\n  --font-ui: 'Segoe UI Variable', 'Segoe UI', 'Microsoft YaHei UI', sans-serif;\n  --font-size-body: 14px;\n  --radius-control: 6px;\n  --radius-panel: 8px;\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-6: 24px;\n  --sidebar-width: 208px;\n  --control-height: 32px;\n}\n[data-theme='dark'] {\n  color-scheme: dark;\n  --color-bg: #202723;\n  --color-surface: #2a322c;\n  --color-surface-hover: #2b3340;\n  --color-border: #465048;\n  --color-text: #edf0f5;\n  --color-muted: #abb6c7;\n  --color-accent: #b3ceb9;\n  --color-accent-text: #223d30;\n  --color-selected: #3a4d3e;\n  --color-danger: #ffaca4;\n  --color-success: #85d6ad;\n  --color-focus: #b3ceb9;\n  --syntax-keyword: #cf9ee6;\n  --syntax-string: #a6c897;\n  --syntax-comment: #9da99e;\n  --syntax-number: #e5b481;\n  --syntax-function: #8bc2df;\n  --syntax-key: #e3a49b;\n  --syntax-warning: #e4bd6b;\n  --syntax-mark: #605b35;\n  --color-paper: #303831;\n  --color-paper-line: #454e43;\n  --color-decor: #78916f;\n  --color-dock: #2a352d;\n  --color-dock-note: #4a4b39;\n  --color-dock-task: #3d5747;\n  --color-dock-file: #594e3b;\n}\n"}}