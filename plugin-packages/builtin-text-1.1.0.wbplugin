{"manifest":{"id":"builtin-text","name":"文本阅读器","version":"1.1.0","apiVersion":1,"entry":"index.html","permissions":["file.receive"],"fileTypes":[".txt",".md",".json",".jsonc",".csv",".log",".js",".jsx",".mjs",".cjs",".ts",".tsx",".css",".scss",".html",".xml",".svg",".vue",".yaml",".yml",".py",".sql",".ini",".toml",".conf",".env",".java",".c",".h",".cpp",".hpp",".cs",".go",".rs",".sh",".bash",".ps1",".bat",".rb",".php"]},"files":{"app.js":"const api=window.workbench,$=id=>document.getElementById(id),highlight=window.CodeHighlight;\nlet generation=0,current=null,text='',rows=[],raw=[],page=0,matches=[],matchIndex=-1;\nconst PAGE=300;\nfunction render(){const content=$('content');content.replaceChildren();for(let i=page*PAGE;i<Math.min(rows.length,(page+1)*PAGE);i++){const line=document.createElement('div');line.className='code-line'+(matches.includes(i)?' match':'');line.id='line-'+i;const number=document.createElement('span');number.className='line-number';number.textContent=i+1;const code=document.createElement('code');code.innerHTML=rows[i]||' ';line.append(number,code);content.append(line);}$('prev').disabled=page===0;$('next').disabled=(page+1)*PAGE>=rows.length;$('page').textContent=rows.length?(page+1)+' / '+Math.ceil(rows.length/PAGE):'';$('status').textContent=current?language()+' · '+raw.length+' 行':'';}\nfunction language(){return $('language').value==='auto'?highlight.language(current?.name||''):$('language').value;}\nfunction prepare(){rows=highlight.lines(text,language());raw=text.split('\\n');find();}\nfunction find(){const q=$('query').value.toLowerCase();matches=q?raw.flatMap((line,i)=>line.toLowerCase().includes(q)?[i]:[]):[];matchIndex=-1;$('matches').textContent=q?matches.length+' 行匹配':'';render();}\nfunction jump(delta){if(!matches.length)return;matchIndex=(matchIndex+delta+matches.length)%matches.length;page=Math.floor(matches[matchIndex]/PAGE);render();document.getElementById('line-'+matches[matchIndex])?.scrollIntoView({block:'center'});$('matches').textContent=(matchIndex+1)+' / '+matches.length;}\nasync function open(file){if(!file)return;const run=++generation;current=file;page=0;text='';rows=[];raw=[];matches=[];$('language').value='auto';$('query').value='';$('name').textContent=file.name;$('error').textContent='';$('refresh').disabled=true;render();$('content').textContent='加载中…';try{const data=await api.files.readText(file.token);if(run!==generation)return;text=data.text;prepare();}catch(e){if(run===generation){$('error').textContent=e.message;$('content').textContent='';}}finally{if(run===generation)$('refresh').disabled=false;}}\n$('language').onchange=()=>{page=0;prepare();};$('wrap').onchange=()=>document.body.classList.toggle('wrap',$('wrap').checked);$('query').oninput=find;$('next-match').onclick=()=>jump(1);$('previous-match').onclick=()=>jump(-1);$('query').onkeydown=e=>{if(e.key==='Enter')jump(e.shiftKey?-1:1);};$('prev').onclick=()=>{page--;render();$('content').scrollTop=0;};$('next').onclick=()=>{page++;render();$('content').scrollTop=0;};$('refresh').onclick=()=>open(current);\napi.onOpen(open);api.onTheme(theme=>document.documentElement.dataset.theme=theme);api.initial().then(data=>{document.documentElement.dataset.theme=data.theme;open(data.file);}).catch(e=>$('error').textContent=e.message);\n","highlight.js":"(function(root){\n const escape=text=>text.replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\n const extensions={js:'javascript',jsx:'javascript',mjs:'javascript',cjs:'javascript',ts:'typescript',tsx:'typescript',py:'python',java:'java',c:'c',h:'c',cpp:'cpp',hpp:'cpp',cs:'csharp',go:'go',rs:'rust',sh:'shell',bash:'shell',ps1:'shell',bat:'shell',rb:'ruby',php:'php',json:'json',jsonc:'json',yaml:'yaml',yml:'yaml',ini:'config',toml:'config',conf:'config',env:'config',sql:'sql',css:'css',scss:'css',html:'markup',xml:'markup',svg:'markup',vue:'markup',md:'markdown'};\n const keywords=new Set(('abstract and as assert async await auto base begin bool boolean break byte case catch char class const continue def default defer del delete do double elif else end enum except export extends extern false final finally float fn for foreach from func function global go if implements import in include instanceof int interface internal is lambda let long map match module namespace native new nil none not null object of operator or override package pass private protected public raise readonly ref return select self short signed sizeof static string struct super switch synchronized template this throw throws trait true try type typedef typeof union unsigned unsafe use using var virtual void volatile when where while with yield').split(' '));\n const sql=new Set('select from where join inner outer left right full on as and or not null is in exists like between group by order asc desc having limit offset insert into values update set delete create alter drop table index view database primary key foreign references unique default constraint union all distinct case when then else end begin commit rollback'.split(' '));\n function language(name){const base=name.split(/[\\\\/]/).pop().toLowerCase();if(base==='dockerfile'||base==='makefile')return 'shell';return extensions[base.split('.').pop()]||'plain';}\n function tokenize(text,lang){\n  if(lang==='plain')return [{type:'',value:text}];\n  const out=[];const hash=['python','shell','ruby','yaml','config'].includes(lang),slash=!['python','shell','ruby','yaml','config','sql','markup','markdown'].includes(lang);\n  const pattern=/<!--[\\s\\S]*?(?:-->|$)|\\/\\*[\\s\\S]*?(?:\\*\\/|$)|\"\"\"[\\s\\S]*?(?:\"\"\"|$)|'''[\\s\\S]*?(?:'''|$)|\"(?:\\\\[\\s\\S]|[^\"\\\\])*\"|'(?:\\\\[\\s\\S]|[^'\\\\])*'|`(?:\\\\[\\s\\S]|[^`\\\\])*`|\\/\\/[^\\r\\n]*|#[^\\r\\n]*|--[^\\r\\n]*|<\\/?[A-Za-z][^>]*>|\\b(?:0x[\\da-fA-F]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)\\b|[A-Za-z_$][\\w$-]*|[^A-Za-z_$\\d\"'`/#<\\-]+|[\\s\\S]/g;\n  let match;while((match=pattern.exec(text))){const value=match[0],lower=value.toLowerCase();let type='';\n   if((value.startsWith('/*')&&slash)||(value.startsWith('//')&&slash)||(value.startsWith('#')&&hash)||(value.startsWith('--')&&lang==='sql')||(value.startsWith('<!--')&&lang==='markup'))type='comment';\n   else if(/^[\"'`]/.test(value)){type='string';if(['json','yaml','config'].includes(lang)&&/^\\s*:/.test(text.slice(pattern.lastIndex)))type='key';}\n   else if(lang==='markup'&&/^<\\/?[A-Za-z]/.test(value))type='tag';\n   else if(/^\\d/.test(value))type='number';\n   else if(['true','false','null','none','nil','undefined'].includes(lower))type='literal';\n   else if((lang==='sql'?sql:keywords).has(lower))type='keyword';\n   else if(/^[A-Za-z_$]/.test(value)&&/^\\s*\\(/.test(text.slice(pattern.lastIndex)))type='function';\n   else if(['yaml','config','css'].includes(lang)&&/^[A-Za-z_$]/.test(value)&&/^\\s*[:=]/.test(text.slice(pattern.lastIndex)))type='key';\n   else if(lang==='markdown'&&value.startsWith('#'))type='keyword';\n   const last=out.at(-1);if(last&&last.type===type)last.value+=value;else out.push({type,value});\n  }return out;\n }\n function lines(text,lang){const rows=[''];for(const token of tokenize(text,lang)){const pieces=token.value.split('\\n');for(let i=0;i<pieces.length;i++){if(i)rows.push('');const value=escape(pieces[i].replace(/\\r$/,''));rows[rows.length-1]+=token.type?'<span class=\"tok-'+token.type+'\">'+value+'</span>':value;}}return rows;}\n const api={escape,language,tokenize,lines};if(typeof module!=='undefined')module.exports=api;else root.CodeHighlight=api;\n})(globalThis);\n","index.html":"<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"tokens.css\"><link rel=\"stylesheet\" href=\"style.css\"></head><body><header><strong id=\"name\">文本阅读器</strong><span>只读</span><select id=\"language\" aria-label=\"语言\"><option value=\"auto\">自动</option><option>plain</option><option>javascript</option><option>typescript</option><option>python</option><option>json</option><option>yaml</option><option>config</option><option>sql</option><option>markup</option><option>css</option><option>markdown</option><option>java</option><option>c</option><option>cpp</option><option>csharp</option><option>go</option><option>rust</option><option>shell</option><option>ruby</option><option>php</option></select><label><input id=\"wrap\" type=\"checkbox\">折行</label><button id=\"refresh\" disabled>刷新</button></header><div class=\"searchbar\"><input id=\"query\" aria-label=\"查找\" placeholder=\"查找\"><button id=\"previous-match\">上一个</button><button id=\"next-match\">下一个</button><span id=\"matches\"></span></div><p id=\"error\" role=\"status\"></p><div id=\"content\"><p class=\"empty\">未打开文件</p></div><footer><span id=\"status\"></span><button id=\"prev\" disabled>上一页</button><span id=\"page\"></span><button id=\"next\" disabled>下一页</button></footer><script src=\"highlight.js\"></script><script src=\"app.js\"></script></body></html>\n","style.css":"*{box-sizing:border-box}body{height:100vh;margin:0;background:var(--color-paper);color:var(--color-text);font:13px var(--font-ui);display:flex;flex-direction:column}header{display:flex;gap:16px;align-items:center;padding:12px 20px;border-bottom:1px solid var(--color-border)}header strong{font-weight:500;flex:1;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}header span,header label{font-size:11px;color:var(--color-muted)}button,input,select{font:inherit;color:inherit;background:var(--color-surface);border:1px solid var(--color-border);padding:5px 9px;border-radius:4px}button{cursor:pointer}button:disabled{opacity:.4;cursor:default}input[type=checkbox]{accent-color:var(--color-accent)}button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--color-focus)}.searchbar{display:flex;gap:8px;align-items:center;padding:10px 20px;font-size:11px;border-bottom:1px solid var(--color-border)}.searchbar input{width:240px}#content{flex:1;overflow:auto;padding:15px 0;min-height:0}.code-line{display:flex;min-width:max-content;font:13px/1.8 Consolas,'Microsoft YaHei',monospace;min-height:23px}.line-number{position:sticky;left:0;flex-shrink:0;width:65px;text-align:right;padding-right:18px;color:var(--color-muted);user-select:none;background:var(--color-paper);font-size:11px}.code-line code{font:inherit;white-space:pre;padding-right:25px}.wrap .code-line{min-width:0}.wrap code{white-space:pre-wrap;overflow-wrap:anywhere;min-width:0}.code-line.match{background:var(--color-selected)}footer{display:flex;align-items:center;gap:10px;border-top:1px solid var(--color-border);padding:8px 20px;font-size:11px}footer>span:first-child{margin-right:auto}#error{color:var(--color-danger);padding:0 20px;font-size:12px}#error:empty{display:none}.empty{padding:20px;color:var(--color-muted)}.tok-keyword{color:var(--syntax-keyword)}.tok-string{color:var(--syntax-string)}.tok-comment{color:var(--syntax-comment);font-style:italic}.tok-number,.tok-literal{color:var(--syntax-number)}.tok-function{color:var(--syntax-function)}.tok-key,.tok-tag{color:var(--syntax-key)}\n","tokens.css":":root {\n  color-scheme: light;\n  --color-bg: #eeeee8;\n  --color-surface: #fafaf6;\n  --color-surface-hover: #eef1f5;\n  --color-border: #dcded5;\n  --color-text: #303c36;\n  --color-muted: #6d786f;\n  --color-accent: #356855;\n  --color-accent-text: #ffffff;\n  --color-selected: #e0e9df;\n  --color-danger: #b42318;\n  --color-success: #177245;\n  --color-focus: #356855;\n  --syntax-keyword: #8541a3;\n  --syntax-string: #34734c;\n  --syntax-comment: #6a786f;\n  --syntax-number: #a15b21;\n  --syntax-function: #276c9c;\n  --syntax-key: #96524c;\n  --syntax-warning: #875f10;\n  --syntax-mark: #f4df91;\n  --color-paper: #fffef9;\n  --color-paper-line: #e9e9df;\n  --color-decor: #94aa8e;\n  --color-dock: #fafbf7;\n  --color-dock-note: #e7e9d9;\n  --color-dock-task: #dce9df;\n  --color-dock-file: #eae0ce;\n  --shadow-paper: 0 12px 30px #394b3510;\n  --shadow-dock: 0 10px 35px #34403216;\n  --font-ui: 'Segoe UI Variable', 'Segoe UI', 'Microsoft YaHei UI', sans-serif;\n  --font-size-body: 14px;\n  --radius-control: 6px;\n  --radius-panel: 8px;\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-6: 24px;\n  --sidebar-width: 208px;\n  --control-height: 32px;\n}\n[data-theme='dark'] {\n  color-scheme: dark;\n  --color-bg: #202723;\n  --color-surface: #2a322c;\n  --color-surface-hover: #2b3340;\n  --color-border: #465048;\n  --color-text: #edf0f5;\n  --color-muted: #abb6c7;\n  --color-accent: #b3ceb9;\n  --color-accent-text: #223d30;\n  --color-selected: #3a4d3e;\n  --color-danger: #ffaca4;\n  --color-success: #85d6ad;\n  --color-focus: #b3ceb9;\n  --syntax-keyword: #cf9ee6;\n  --syntax-string: #a6c897;\n  --syntax-comment: #9da99e;\n  --syntax-number: #e5b481;\n  --syntax-function: #8bc2df;\n  --syntax-key: #e3a49b;\n  --syntax-warning: #e4bd6b;\n  --syntax-mark: #605b35;\n  --color-paper: #303831;\n  --color-paper-line: #454e43;\n  --color-decor: #78916f;\n  --color-dock: #2a352d;\n  --color-dock-note: #4a4b39;\n  --color-dock-task: #3d5747;\n  --color-dock-file: #594e3b;\n}\n"}}