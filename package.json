{
  "name": "modular-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "build": "node scripts/package-plugins.cjs && tsc --noEmit && vite build --configLoader native",
    "desktop": "pnpm build && electron .",
    "package": "pnpm build && electron-builder --win portable",
    "plugins:build": "node scripts/package-plugins.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.modular.workbench",
    "productName": "Modular Workbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "bundled-plugins/**/*"
    ],
    "win": {
      "target": "portable"
    }
  }
}
